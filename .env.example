# Ghost CMS Configuration
# Get these from your Ghost Admin → Integrations → Add Custom Integration
PUBLIC_GHOST_API_URL=https://your-ghost-site.com
PUBLIC_GHOST_CONTENT_API_KEY=your-ghost-content-api-key

# Kit (ConvertKit) Configuration
# Get these from your Kit company account settings (Settings → Developer for API key)
PUBLIC_KIT_API_KEY=your-kit-public-api-key
PUBLIC_KIT_FORM_ID=your-kit-demo-form-id
PUBLIC_KIT_WHITEPAPER_FORM_ID=your-kit-whitepaper-form-id
PUBLIC_KIT_DEMO_TAG_ID=your-kit-demo-tag-id
PUBLIC_KIT_WHITEPAPER_TAG_ID=your-kit-whitepaper-tag-id

# AWS Deployment Configuration (optional - has defaults)
# AWS_REGION=us-east-1
