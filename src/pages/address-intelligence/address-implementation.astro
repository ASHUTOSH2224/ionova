---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import AddressImplementation from '@/views/AddressImplementation.astro';
---

<Layout
  title="Address Intelligence Implementation - ioNova"
  description="Sidecar architecture, 10-16 week timeline, zero legacy rip-and-replace."
>
  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <div class="ds-v5">
        <div class="container">
          <AddressImplementation />
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
