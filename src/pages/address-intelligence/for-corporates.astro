<script>
  function fcTick() {
    const d = new Date('2026-11-14T00:00:00Z').getTime() - Date.now();
    if (d <= 0) return;
    const days = Math.floor(d / 864e5);
    const hrs  = Math.floor(d % 864e5 / 36e5);
    const mins = Math.floor(d % 36e5 / 6e4);
    const secs = Math.floor(d % 6e4 / 1e3);
    const p = (n: number) => String(n).padStart(2, '0');
    const el = (id: string) => document.getElementById(id) as HTMLElement | null;
    if (el('fc-days'))     el('fc-days')!.textContent     = '~' + days;
    if (el('fc-cd-days'))  el('fc-cd-days')!.textContent  = String(days).padStart(3, '0');
    if (el('fc-cd-hours')) el('fc-cd-hours')!.textContent = p(hrs);
    if (el('fc-cd-mins'))  el('fc-cd-mins')!.textContent  = p(mins);
    if (el('fc-cd-secs'))  el('fc-cd-secs')!.textContent  = p(secs);
    if (el('fc-cta-days')) el('fc-cta-days')!.textContent = String(days);
  }
  fcTick();
  setInterval(fcTick, 1000);
</script>
