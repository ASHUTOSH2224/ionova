---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
---

<Layout
  title="ISO 20022 Structured Addresses for Corporates | Stop Payment Rejections Before November 2026 | ioNova"
  description="From 14 November 2026, banks need structured Town and Country at payment initiation or your cross-border payments can be rejected. ioNova resolves free-text supplier addresses in your ERP into ISO 20022 structured addresses across 195 countries and 50+ scripts. Live in 2–4 weeks."
  ogImage="/og-image.png"
  ogImageAlt="ioNova AI — ISO 20022 Structured Addresses for Corporates"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "ISO 20022 Structured Addresses for Corporates | ioNova",
    "description": "Stop cross-border payment rejections before the 14 November 2026 cut-over. ioNova structures your ERP counterparty data once, for every bank and channel. Live in 2–4 weeks.",
    "url": "https://ionova.ai/address-intelligence/for-corporates",
    "isPartOf": { "@id": "https://ionova.ai/#website" },
    "breadcrumb": { "@type": "BreadcrumbList", "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ionova.ai" },
      { "@type": "ListItem", "position": 2, "name": "For Corporates", "item": "https://ionova.ai/address-intelligence/for-corporates" }
    ]}
  })} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What does the November 2026 ISO 20022 mandate require corporates to do?", "acceptedAnswer": { "@type": "Answer", "text": "Corporates must source address information on their creditors through their own channels, store it in their ERP or treasury application, and provide it to the bank at payment initiation with at minimum structured Town and Country. From 14 November 2026 this applies regardless of channel — MT101 SCORE, pain.001 SCORE+, or a bank's proprietary channel." } },
      { "@type": "Question", "name": "Will my cross-border payments be rejected if addresses aren't structured?", "acceptedAnswer": { "@type": "Answer", "text": "After 14 November 2026, payment instructions that reach the bank without at least structured Town and Country can be rejected, held, or returned under CBPR+ rules. A returned payment means a late settlement, supplier friction, and manual rework." } },
      { "@type": "Question", "name": "How does ioNova fit into our ERP or treasury workflow?", "acceptedAnswer": { "@type": "Answer", "text": "ioNova runs as a service over a standard API and integrates with your ERP or treasury system without replacing it. It resolves free-text counterparty addresses into structured ISO 20022 elements — in batch for your existing master data, and in real time as new payees are onboarded. Typical API integration is 2–4 weeks." } },
      { "@type": "Question", "name": "We pay suppliers in many countries and scripts — can ioNova handle that?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. ioNova resolves addresses across 195 countries and 50+ writing systems, including non-Latin scripts and markets where conventions differ — landmark-based addresses, missing postcodes, and local sub-divisions." } },
      { "@type": "Question", "name": "Should we wait for our banks to handle this for us?", "acceptedAnswer": { "@type": "Answer", "text": "No. The mandate makes the originator responsible for supplying structured Town and Country at initiation — banks can reject non-compliant instructions, but they cannot invent address data you have not provided." } }
    ]
  })} />

  <style>
    /* ── for-corporates page · DS v5 light · prefix: fc- ── */

    /* ── Neutralise .ds-v5 revert overrides ── */
    .fc-hero *, .fc-cd *, .fc-section *, .fc-cta *, .fc-ars * { box-sizing: border-box; }
    .fc-hero p, .fc-cd p, .fc-section p, .fc-cta p, .fc-ars p,
    .fc-callout p, .fc-table-wrap p { margin: 0; }
    .fc-hero h1, .fc-hero h2, .fc-hero h3,
    .fc-cd h2, .fc-cd h3, .fc-cd h4,
    .fc-section h2, .fc-section h3, .fc-section h4,
    .fc-cta h2, .fc-ars h2 { margin: 0; }
    /* (intentionally empty — overrides are on the specific selectors above) */
    .fc-plist { padding: 0; }
    .fc-plist li { list-style: none; }
    @keyframes fc-pulse  { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.35;transform:scale(1.9)} }
    @keyframes fc-fadeUp { from{opacity:0;transform:translateY(28px)} to{opacity:1;transform:translateY(0)} }
    @keyframes fc-gx     { 0%{background-position:0% 50%} 50%{background-position:100% 50%} 100%{background-position:0% 50%} }
    @keyframes fc-scan   { 0%{transform:translateX(-100%)} 100%{transform:translateX(200%)} }
    @keyframes fc-glow   { 0%,100%{opacity:.6} 50%{opacity:1} }
    @keyframes fc-cdp    { 0%,100%{text-shadow:0 0 20px rgba(220,53,69,.3)} 50%{text-shadow:0 0 40px rgba(220,53,69,.6)} }

    .fc-w { max-width: 1200px; margin: 0 auto; padding: 0 32px; position: relative; z-index: 1; }
    /* center header utility applied to non-hero sections */
    .fc-section-center .fc-lbl { justify-content: center; }
    .fc-section-center .fc-h2 { text-align: center; max-width: none; }
    .fc-section-center .fc-desc { text-align: center; margin-left: auto; margin-right: auto; }

    /* Hero */
    .fc-hero { padding: 140px 0 72px; position: relative; overflow: hidden; background: var(--bg); }
    .fc-hero::before { content: ''; position: absolute; top: -200px; right: -200px; width: 900px; height: 900px; background: radial-gradient(circle,rgba(95,207,208,.12) 0%,rgba(67,173,193,.06) 30%,transparent 60%); pointer-events: none; }
    .fc-hero::after  { content: ''; position: absolute; bottom: -100px; left: -100px; width: 600px; height: 600px; background: radial-gradient(circle,rgba(94,161,220,.08) 0%,transparent 55%); pointer-events: none; }
    .fc-hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 48px; align-items: center; }
    @media (max-width: 980px) { .fc-hero-grid { grid-template-columns: 1fr; gap: 40px; } }

    .fc-eyebrow { display: inline-flex; align-items: center; gap: 9px; font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--teal-500); margin-bottom: 22px; }
    .fc-eyebrow .dot { width: 6px; height: 6px; border-radius: 50%; background: #DC3545; animation: fc-pulse 2s ease-in-out infinite; flex-shrink: 0; }
    .fc-h1 { font-family: var(--font-display) !important; font-size: clamp(32px,4.5vw,52px) !important; font-weight: 800 !important; letter-spacing: -1.5px; line-height: 1.12 !important; color: var(--text-primary); margin-bottom: 20px; }
    .fc-h1 .accent { background: var(--gradient-text); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; background-size: 200% auto; animation: fc-gx 6s ease-in-out infinite; display: block; }
    .fc-sub { font-size: clamp(15px,1.5vw,17px); line-height: 1.65; color: var(--text-label); max-width: 620px; margin-bottom: 32px; }
    .fc-btn { font-family: var(--font-display); font-weight: 600; font-size: 15px; padding: 14px 30px; border-radius: var(--radius-full); border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; text-decoration: none; background: var(--gradient-brand); background-size: 200% auto; color: #fff; box-shadow: 0 2px 12px rgba(67,173,193,.3); animation: fc-gx 4s ease-in-out infinite; transition: transform .3s,box-shadow .3s; }
    .fc-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(67,173,193,.35); }
    .fc-stats { display: flex; flex-wrap: wrap; gap: 26px; margin-top: 34px; }
    .fc-stat .v { font-family: var(--font-display); font-size: 26px; font-weight: 800; letter-spacing: -1px; line-height: 1; background: var(--gradient-text); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; background-size: 200% auto; animation: fc-gx 6s ease-in-out infinite; }
    .fc-stat .v.urgent { background: linear-gradient(135deg,#DC3545,#ff7a6b); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: fc-cdp 3s ease-in-out infinite; }
    .fc-stat .l { font-size: 11px; color: var(--text-muted); margin-top: 5px; font-weight: 500; max-width: 140px; line-height: 1.35; }
    .fc-trust { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 22px; }
    .fc-trust .lbl { font-size: 12px; color: var(--text-muted); font-weight: 500; }
    .fc-pill { font-family: var(--font-display); font-size: 12px; font-weight: 600; color: var(--text-label); background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-full); padding: 5px 14px; }

    /* ARS card */
    .fc-ars { background: var(--surface-1); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 22px; box-shadow: var(--shadow-xl); position: relative; overflow: hidden; }
    .fc-ars::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--gradient-brand); background-size: 200% 100%; animation: fc-gx 5s ease-in-out infinite; }
    .fc-ars-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
    .fc-ars-title { font-family: var(--font-display); font-size: 13px; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 9px; }
    .fc-ars-title .spark { width: 22px; height: 22px; border-radius: 6px; background: linear-gradient(135deg,rgba(95,207,208,.18),rgba(67,173,193,.08)); border: 1px solid rgba(67,173,193,.25); display: flex; align-items: center; justify-content: center; color: var(--teal-500); }
    .fc-resolved { font-family: var(--font-mono); font-size: 10px; font-weight: 600; color: #065F46; background: #ECFDF5; border: 1px solid #6EE7B7; border-radius: var(--radius-full); padding: 3px 10px; display: inline-flex; align-items: center; gap: 6px; }
    .fc-resolved .led { width: 6px; height: 6px; border-radius: 50%; background: #10B981; box-shadow: 0 0 8px #10B981; animation: fc-glow 2.4s ease-in-out infinite; }
    .fc-block { background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 13px 15px; }
    .fc-block-lbl { font-family: var(--font-mono); font-size: 9.5px; font-weight: 600; letter-spacing: 1.4px; text-transform: uppercase; color: var(--text-muted); margin-bottom: 7px; }
    .fc-raw { font-family: var(--font-mono); font-size: 12px; line-height: 1.55; color: var(--text-label); word-break: break-word; }
    .fc-flow { display: flex; align-items: center; justify-content: center; gap: 9px; margin: 11px 0; font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: var(--teal-500); }
    .fc-flow .pipe { flex: 1; height: 1px; background: linear-gradient(90deg,transparent,var(--teal-500),transparent); position: relative; overflow: hidden; }
    .fc-flow .pipe::after { content: ''; position: absolute; top: 0; left: 0; width: 30%; height: 100%; background: linear-gradient(90deg,transparent,var(--cyan-400),transparent); animation: fc-scan 2.4s ease-in-out infinite; }
    .fc-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; margin-top: 9px; }
    .fc-pstl { background: var(--surface-1); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 7px 10px; opacity: 0; animation: fc-fadeUp .5s ease-out forwards; }
    .fc-pstl.full { grid-column: 1/-1; }
    .fc-pstl-tag { font-family: var(--font-mono); font-size: 9.5px; font-weight: 600; color: var(--blue-500); }
    .fc-pstl-val { font-family: var(--font-mono); font-size: 11.5px; font-weight: 500; color: var(--text-primary); margin-top: 1px; }
    .fc-ars-foot { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 13px; padding-top: 13px; border-top: 1px solid var(--border); }
    .fc-tag { font-family: var(--font-mono); font-size: 10px; font-weight: 600; color: var(--teal-500); background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-full); padding: 3px 10px; }

    /* Sections */
    .fc-section { padding: 88px 0; border-top: 1px solid var(--border); }
    .fc-lbl { font-family: var(--font-display); font-size: 11px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: var(--teal-500); margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
    .fc-lbl::before { content: ''; width: 3px; height: 16px; background: var(--gradient-brand); border-radius: 2px; }
    .fc-lbl.center { justify-content: center; }
    .fc-h2 { font-family: var(--font-display) !important; font-size: clamp(24px,3vw,36px) !important; font-weight: 700 !important; letter-spacing: -1px; line-height: 1.15 !important; color: var(--text-primary); max-width: 700px; }
    .fc-desc { font-size: 15px; color: var(--text-label); margin-top: 12px; max-width: 580px; line-height: 1.65; }

    /* Countdown */
    .fc-cd { background: var(--surface-1); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 88px 0; }
    .fc-cd-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: start; }
    @media (max-width: 840px) { .fc-cd-grid { grid-template-columns: 1fr; gap: 32px; } }
    .fc-timer { display: flex; gap: 12px; margin: 28px 0; flex-wrap: wrap; }
    .fc-unit { background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 14px 18px; min-width: 76px; text-align: center; }
    .fc-unit-num { font-family: var(--font-display); font-size: 30px; font-weight: 800; letter-spacing: -1px; background: linear-gradient(135deg,#DC3545,#ff6b6b); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .fc-unit-lbl { font-family: var(--font-display); font-size: 10px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: var(--text-muted); margin-top: 2px; }
    .fc-tl { display: flex; flex-direction: column; position: relative; }
    .fc-tl::before { content: ''; position: absolute; left: 15px; top: 20px; bottom: 20px; width: 2px; background: var(--border); }
    .fc-tl-item { display: flex; gap: 18px; padding: 14px 0; }
    .fc-tl-dot { width: 32px; height: 32px; border-radius: 50%; border: 2px solid var(--border); background: var(--surface-1); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 13px; z-index: 1; }
    .fc-tl-dot.complete { border-color: #10B981; background: #ECFDF5; }
    .fc-tl-dot.now      { border-color: #DC3545; background: #FEF2F2; box-shadow: 0 0 12px rgba(220,53,69,.2); }
    .fc-tl-dot.upcoming { border-color: #F59E0B; }
    .fc-tl-dot.future   { border-color: var(--border-strong); }
    .fc-tl-date { font-family: var(--font-mono); font-size: 11px !important; color: var(--teal-500); font-weight: 600; margin-bottom: 3px; }
    .fc-tl-h4   { font-family: var(--font-display) !important; font-size: 13px !important; font-weight: 700 !important; color: var(--text-primary); margin-bottom: 1px; }
    .fc-tl-p    { font-size: 12px; color: var(--text-muted); line-height: 1.4; margin: 0; }
    .fc-cd-text { font-size: 15px; line-height: 1.7; color: var(--text-label); }

    /* Pressure cards */
    .fc-pgrid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; margin-top: 30px; }
    @media (max-width: 900px) { .fc-pgrid { grid-template-columns: 1fr; } }
    .fc-pcard { background: var(--surface-1); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 26px 24px; position: relative; overflow: hidden; display: flex; flex-direction: column; transition: all .35s; }
    .fc-pcard::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg,#F59E0B,#DC3545); opacity: 0; transition: opacity .3s; }
    .fc-pcard:hover::before { opacity: 1; }
    .fc-pcard:hover { border-color: var(--border-strong); box-shadow: var(--shadow-lg); transform: translateY(-3px); }
    .fc-pnum { font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #B45309; margin-bottom: 12px; }
    .fc-pcard h3 { font-family: var(--font-display) !important; font-size: 17px !important; font-weight: 700 !important; letter-spacing: -.4px; color: var(--text-primary); margin-bottom: 8px; }
    .fc-plead { font-size: 13.5px; line-height: 1.6; color: var(--text-label); margin-bottom: 14px; }
    .fc-plist { list-style: none; display: flex; flex-direction: column; gap: 10px; margin-top: auto; }
    .fc-plist li { font-size: 12.5px; line-height: 1.55; color: var(--text-label); padding-left: 18px; position: relative; }
    .fc-plist li::before { content: ''; position: absolute; left: 0; top: 8px; width: 9px; height: 1.5px; background: var(--teal-500); border-radius: 1px; }

    /* Callout */
    .fc-callout { display: flex; gap: 14px; background: #FFFBEB; border: 1px solid #FDE68A; border-left: 3px solid #F59E0B; border-radius: var(--radius-lg); padding: 18px 22px; margin-top: 28px; }
    .fc-callout-icon { flex-shrink: 0; width: 34px; height: 34px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; background: rgba(245,158,11,.12); border: 1px solid #FCD34D; color: #B45309; }
    .fc-callout-lbl { font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #B45309; margin-bottom: 4px; }
    .fc-callout p { font-size: 13.5px; line-height: 1.65; color: var(--text-label); }
    .fc-callout p strong { color: var(--text-primary); font-weight: 600; }

    /* Table */
    .fc-table-wrap { overflow-x: auto; margin-top: 28px; border-radius: var(--radius-lg); border: 1px solid var(--border); }
    .fc-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .fc-table th { font-family: var(--font-display); font-size: 12px; font-weight: 700; letter-spacing: .3px; padding: 14px 16px; text-align: left; background: var(--surface-2); border-bottom: 2px solid var(--border); color: var(--text-primary); white-space: nowrap; }
    .fc-table th:last-child { background: linear-gradient(135deg,rgba(95,207,208,.08),rgba(67,173,193,.04)); color: var(--teal-500); }
    .fc-table td { padding: 11px 16px; border-bottom: 1px solid var(--surface-3); color: var(--text-label); vertical-align: top; }
    .fc-table tr:last-child td { border-bottom: none; }
    .fc-table td:first-child { font-weight: 600; color: var(--text-primary); font-size: 12px; }
    .fc-table td.sq { color: var(--text-muted); }
    .fc-table td.sq::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #F59E0B; margin-right: 8px; vertical-align: middle; opacity: .7; }
    .fc-table td.win { color: var(--teal-500); font-weight: 600; }
    .fc-table td.win::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #10B981; margin-right: 8px; vertical-align: middle; }

    /* FAQ */
    .fc-faq { display: flex; flex-direction: column; gap: 10px; margin-top: 28px; max-width: 820px; margin-left: auto; margin-right: auto; }
    .fc-faq-item { background: var(--surface-1); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; transition: border-color .3s; }
    .fc-faq-item:hover { border-color: var(--border-strong); }
    .fc-faq-q { font-family: var(--font-display); font-size: 14px; font-weight: 700; color: var(--text-primary); padding: 16px 22px; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; user-select: none; list-style: none; }
    .fc-faq-q::marker, .fc-faq-q::-webkit-details-marker { display: none; }
    .fc-faq-q svg { flex-shrink: 0; color: var(--text-muted); transition: transform .3s; }
    details[open] .fc-faq-q svg { transform: rotate(180deg); }
    .fc-faq-a { padding: 0 22px 16px; font-size: 14px; line-height: 1.7; color: var(--text-label); }

    /* CTA */
    .fc-cta { background: var(--surface-2,#F3F4F6); position: relative; overflow: hidden; padding: 72px 0; display: flex; justify-content: center; align-items: center; }
    .fc-cta-card { background: linear-gradient(135deg,#0E1935 0%,#1A1E35 40%,#243574 100%); border-radius: 1.5rem; border: 1px solid rgba(255,255,255,.1); box-shadow: 0 25px 50px -12px rgba(0,0,0,.5); position: relative; overflow: hidden; width: 95%; max-width: 1200px; }
    .fc-cta-card::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg,rgba(255,255,255,.05),transparent); pointer-events: none; }
    .fc-cta-inner { position: relative; z-index: 1; padding: 56px 48px; text-align: center; display: flex; flex-direction: column; align-items: center; }
    .fc-cta h2 { font-family: var(--font-display) !important; font-size: clamp(24px,3vw,38px) !important; font-weight: 700 !important; letter-spacing: -0.8px; line-height: 1.2 !important; color: #E2E8F4; max-width: 700px; margin: 0 auto 16px; }
    .fc-cta h2 .accent { background: linear-gradient(135deg,#60A5FA,#3B82F6,#2563EB); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .fc-cta-sub { font-size: 16px; color: rgba(255,255,255,.7); max-width: 600px; margin: 0 auto 28px; line-height: 1.65; }
    .fc-cta-days { display: inline-flex; align-items: baseline; gap: 8px; background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.1); border-radius: 12px; padding: 12px 24px; margin-bottom: 28px; backdrop-filter: blur(10px); }
    .fc-cta-days-num { font-family: var(--font-display); font-size: 32px; font-weight: 700; line-height: 1; background: linear-gradient(180deg,#fff 0%,#94A3B8 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .fc-cta-days-lbl { font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #94A3B8; }
  </style>

  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="ds-v5 flex-1">

      <!-- Hero -->
      <section class="fc-hero">
        <div class="fc-w">
          <div class="fc-hero-grid">
            <div>
              <div class="fc-eyebrow"><span class="dot"></span>ISO 20022 · For Corporates</div>
              <h1 class="fc-h1">
                ISO 20022 structured addresses for corporates —
                <span class="accent">stop payment rejections before November 2026</span>
              </h1>
              <p class="fc-sub">From 14 November 2026, your banks need at least structured Town and Country at payment initiation, or your cross-border payments can be rejected. ioNova resolves the free-text supplier and counterparty addresses in your ERP into full ISO 20022 structured addresses — across 195 countries and 50+ scripts — so payments clear the first time, on every channel.</p>
              <a href="/demo" class="fc-btn">
                See how corporates deploy ioNova
