---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import AddressBusinessValue from '@/views/AddressBusinessValue.astro';
---

<Layout
  title="ISO 20022 Structured Address ROI — 98%+ STP Rates | ioNova"
  description="ISO 20022 structured addresses drive 98%+ STP rates, 30% fewer sanctions false positives, and $8–12B industry savings. Quantify your compliance ROI."
  keywords="ISO 20022 ROI, STP rates, sanctions false positives reduction, payment compliance savings, structured address business value"
  ogImage="/og-image.png"
  ogImageAlt="Business Value of ISO 20022 Structured Addresses"
>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "ISO 20022 Structured Address ROI — 98%+ STP Rates",
      "description": "ISO 20022 structured addresses drive 98%+ STP rates, 30% fewer sanctions false positives, and $8–12B in annual industry savings. Quantify the compliance ROI.",
      "url": "https://ionova.ai/address-intelligence/structured-address-value",
      "dateModified": "2026-02-17",
      "isPartOf": { "@type": "WebSite", "url": "https://ionova.ai" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ionova.ai" },
          { "@type": "ListItem", "position": 2, "name": "Address Intelligence", "item": "https://ionova.ai/address-intelligence" },
          { "@type": "ListItem", "position": 3, "name": "Business Value", "item": "https://ionova.ai/address-intelligence/structured-address-value" }
        ]
      }
    }
  </script>
  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <div class="ds-v5">
        <div class="container">
          <AddressBusinessValue />
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
