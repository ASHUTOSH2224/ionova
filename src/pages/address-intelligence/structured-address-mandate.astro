---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import AddressMandate from '@/views/AddressMandate.astro';
---

<Layout
  title="Structured Address Mandate - ioNova"
  description="Meet the November 2026 ISO 20022 mandate. Structured addresses are required by SWIFT, EPC, and CPMI."
>
  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <div class="ds-v5">
        <div class="container">
          <AddressMandate />
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
