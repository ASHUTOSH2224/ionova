---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import { ghostAPI } from '@/lib/ghost';
import type { GhostPost } from '@/lib/ghost';

// Fetch all posts server-side at build time — fully crawlable by search engines
let allPosts: GhostPost[] = [];
let featuredPosts: GhostPost[] = [];

try {
  [allPosts, featuredPosts] = await Promise.all([
    ghostAPI.getPosts({ limit: 'all' }),
    ghostAPI.getFeaturedPosts(5),
  ]);
} catch (err) {
  console.error('[blogs.astro] Failed to fetch Ghost posts:', err);
}

// Normalise helpers
function formatDate(dateStr: string) {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
function getPrimaryTag(post: GhostPost) {
  return post.tags?.[0]?.name || 'Insights';
}
function getPrimaryAuthor(post: GhostPost) {
  return post.authors?.[0]?.name || 'ioNova Team';
}
---

<Layout
  title="ioNova AI Blog — ISO 20022 & Payment Compliance Insights"
  description="Expert analysis on ISO 20022 structured addresses, SWIFT CBPR+ deadlines, entity intelligence, and payment compliance for financial institutions."
  keywords="ISO 20022 blog, SWIFT CBPR+ insights, payment compliance articles, entity intelligence, structured address analysis, fintech blog"
  ogImage="/Logo/ionova logo/logo.PNG"
  ogImageAlt="ioNova AI Blog — Payment Compliance Insights"
>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "Blog",
      "name": "ioNova AI Blog",
      "description": "Expert analysis on ISO 20022 structured addresses, SWIFT CBPR+ deadlines, entity intelligence, and payment compliance for financial institutions.",
      "url": "https://ionova.ai/blogs",
      "inLanguage": "en-US",
      "isPartOf": { "@type": "WebSite", "url": "https://ionova.ai" },
      "publisher": {
        "@type": "Organization",
        "name": "ioNova AI",
        "url": "https://ionova.ai",
        "logo": { "@type": "ImageObject", "url": "https://ionova.ai/Logo/ionova%20logo/logo.png" }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ionova.ai" },
          { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://ionova.ai/blogs" }
        ]
      }
    }
  </script>

  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <!-- Hero -->
      <div class="ds-v5">
        <section class="hero">
          <div class="hero-badge">
            <span class="pulse-dot"></span>
            <span style="position: relative; z-index: 1;">Latest Updates</span>
          </div>
          <h1>
            Address Intelligence Insights &amp; <br />
            <span class="accent">Resources</span>
          </h1>
          <p class="hero-subtitle" style="max-width: 800px; margin-inline: auto;">
            Stay ahead of ISO 20022 migration with expert analysis, technical deep-dives, and strategic guidance on structured address resolution for global payments.
          </p>
        </section>
      </div>

      <!-- Featured Posts -->
      {featuredPosts.length > 0 && (
        <section class="py-12 md:py-16 bg-background relative overflow-hidden">
          <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-blue-50/50 rounded-full blur-[100px] pointer-events-none -translate-y-1/2 translate-x-1/2"></div>
          <div class="container relative z-10">
            <div class="mb-8 flex items-center justify-center md:justify-start">
              <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-white border border-blue-100 rounded-full text-xs font-bold uppercase tracking-wider text-teal-600 shadow-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-teal-400 animate-pulse"></span>
                Featured Insights
              </span>
            </div>
            <div class="space-y-6">
              {featuredPosts.map((post) => (
                <a href={`/blog/${post.slug}`} class="block group">
                  <div class="border border-slate-100 overflow-hidden bg-white shadow-[0_4px_20px_rgba(14,25,53,0.06)] hover:shadow-[0_20px_60px_rgba(14,25,53,0.12)] transition-all duration-500 rounded-3xl">
                    <div class="grid md:grid-cols-12 gap-0">
                      <!-- Image -->
                      <div class="md:col-span-5 relative h-64 md:min-h-[280px] bg-gradient-to-br from-slate-50 to-blue-50/30 flex items-center justify-center p-8 overflow-hidden">
                        {post.feature_image ? (
                          <img
                            src={post.feature_image}
                            alt={post.title}
                            width="800"
                            height="500"
                            loading="lazy"
                            class="w-full h-full object-cover rounded-2xl"
                          />
                        ) : (
                          <div class="bg-white p-6 rounded-2xl shadow-lg">
                            <svg class="h-16 w-16 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                          </div>
                        )}
                      </div>
                      <!-- Content -->
                      <div class="md:col-span-7 p-8 md:p-12 flex flex-col justify-center">
                        <div class="mb-4">
                          <span class="text-teal-600 font-bold text-sm tracking-wide uppercase">{getPrimaryTag(post)}</span>
                        </div>
                        <h2 class="font-extrabold text-navy-950 mb-6 leading-tight group-hover:text-blue-700 transition-colors">
                          {post.title}
                        </h2>
                        <p class="text-slate-600 mb-8 text-lg leading-relaxed line-clamp-3 font-medium">
                          {post.excerpt}
                        </p>
                        <div class="flex items-center gap-5 mt-auto border-t border-slate-100 pt-6">
                          <div class="h-10 w-10 rounded-full bg-navy-900 text-white flex items-center justify-center border-2 border-white text-sm font-bold shadow-md">
                            {getPrimaryAuthor(post).charAt(0)}
                          </div>
                          <div class="text-sm">
                            <p class="font-bold text-navy-950">{getPrimaryAuthor(post)}</p>
                            <p class="text-slate-500 font-medium">{post.reading_time || 5} min read &bull; {formatDate(post.published_at)}</p>
                          </div>
                          <div class="ml-auto">
                            <span class="inline-flex items-center gap-2 rounded-full bg-navy-950 text-white hover:bg-blue-700 px-6 py-2 text-sm font-semibold shadow-lg transition-all group-hover:scale-105">
                              Read Article
                              <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                            </span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- All Blog Posts Grid -->
      <section class="py-20 bg-background relative">
        <div class="container relative z-10">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
            <div>
              <span class="text-teal-600 font-bold tracking-widest uppercase text-xs mb-2 block">Knowledge Base</span>
              <h2 class="font-extrabold text-navy-950 tracking-tight">Latest Articles</h2>
            </div>
          </div>

          {allPosts.length === 0 ? (
            <p class="text-slate-500 text-center py-20">No articles found. Check back soon.</p>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {allPosts.map((post) => (
                <a href={`/blog/${post.slug}`} class="group h-full block">
                  <article class="h-full bg-white rounded-2xl overflow-hidden shadow-[0_2px_8px_rgba(14,25,53,0.04)] hover:shadow-[0_20px_40px_rgba(14,25,53,0.12)] transition-all duration-300 hover:-translate-y-1 border border-slate-100 flex flex-col">
                    <!-- Card Image -->
                    <div class="h-56 bg-gradient-to-br from-slate-50 to-blue-50/50 relative overflow-hidden group-hover:from-blue-50 group-hover:to-indigo-50/50 transition-colors duration-500">
                      {post.feature_image ? (
                        <img
                          src={post.feature_image}
                          alt={post.title}
                          width="400"
                          height="224"
                          loading="lazy"
                          class="w-full h-full object-cover"
                        />
                      ) : (
                        <div class="absolute inset-0 flex items-center justify-center">
                          <div class="bg-white/80 backdrop-blur-sm p-4 rounded-2xl shadow-sm">
                            <svg class="h-10 w-10 text-blue-600/80" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                          </div>
                        </div>
                      )}
                      <!-- Category Badge -->
                      <div class="absolute top-4 left-4">
                        <span class="bg-white/95 backdrop-blur-md px-3 py-1 rounded-full text-[10px] font-extrabold text-navy-950 shadow-sm border border-slate-100 uppercase tracking-widest">
                          {getPrimaryTag(post)}
                        </span>
                      </div>
                    </div>

                    <div class="p-7 flex flex-col flex-grow relative">
                      <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-blue-200 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                      <h3 class="text-xl font-bold text-navy-950 mb-3 group-hover:text-blue-700 transition-colors leading-snug line-clamp-2">
                        {post.title}
                      </h3>
                      <p class="text-slate-500 text-sm leading-relaxed mb-6 line-clamp-2">
                        {post.excerpt || 'Explore key insights and strategies driving the future of payment orchestration and address intelligence.'}
                      </p>
                      <div class="mt-auto flex items-center justify-between border-t border-slate-50 pt-5">
                        <div class="flex items-center gap-3">
                          <div class="h-8 w-8 rounded-full bg-slate-100 flex items-center justify-center text-xs font-bold text-navy-800 border border-white shadow-sm">
                            {getPrimaryAuthor(post).charAt(0)}
                          </div>
                          <div class="text-xs text-slate-500 font-medium">
                            <span class="block text-navy-950 font-semibold">{getPrimaryAuthor(post)}</span>
                            <span>{formatDate(post.published_at)} &middot; {post.reading_time || 5} min read</span>
                          </div>
                        </div>
                        <div class="h-8 w-8 rounded-full bg-slate-50 flex items-center justify-center text-blue-600 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
                          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                        </div>
                      </div>
                    </div>
                  </article>
                </a>
              ))}
            </div>
          )}
        </div>
      </section>

    </main>
    <Footer />
  </div>
</Layout>
