---
import CompareStaticPage from "@/components/compare/CompareStaticPage.astro";
import { buildComparePageFromHtml } from "@/data/comparePages";

const sourceHtml = String.raw`<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ioNova ARS vs 10 Alternatives: ISO 20022 Structured Address Compliance Compared | ioNova</title>
<meta name="description" content="Compare 10 alternatives — Loqate, Melissa, Smarty, SWIFT's AI parser and more — against ioNova ARS for the November 2026 ISO 20022 structured address deadline. 25-criterion scores, hybrid address guidance, honest verdicts.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..800;1,300..800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<meta name="robots" content="index, follow">
<meta name="keywords" content="ISO 20022 structured addresses, hybrid addresses, ISO 20022 deadline, ISO 20022 compliance, structured address mandate, November 2026, address validation for banks, Loqate alternative, Melissa alternative, Smarty alternative, SWIFT AI address parser, CBPR+ structured address">
<meta name="author" content="ioNova">
<link rel="canonical" href="https://ionova.ai/compare/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="ioNova">
<meta property="og:title" content="ioNova ARS vs 10 Alternatives: ISO 20022 Structured Address Compliance Compared | ioNova">
<meta property="og:description" content="Compare 10 alternatives — Loqate, Melissa, Smarty, SWIFT's AI parser and more — against ioNova ARS for the November 2026 ISO 20022 structured address deadline. 25-criterion scores, hybrid address guidance, honest verdicts.">
<meta property="og:url" content="https://ionova.ai/compare/">
<meta property="og:image" content="https://ionova.ai/og-image.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="ioNova ARS vs 10 Alternatives: ISO 20022 Structured Address Compliance Compared | ioNova">
<meta name="twitter:description" content="Compare 10 alternatives — Loqate, Melissa, Smarty, SWIFT's AI parser and more — against ioNova ARS for the November 2026 ISO 20022 structured address deadline. 25-criterion scores, hybrid address guidance, honest verdicts.">
<script type="application/ld+json">{"@context": "https://schema.org", "@graph": [{"@type": "Organization", "@id": "https://ionova.ai/#org", "name": "ioNova AI", "url": "https://ionova.ai/", "description": "Intelligent Data Infrastructure for Regulated Enterprises. AI-Native ISO 20022 Address Resolution.", "logo": "https://ionova.ai/og-image.png"}, {"@type": "WebSite", "@id": "https://ionova.ai/#website", "name": "ioNova", "url": "https://ionova.ai/", "publisher": {"@id": "https://ionova.ai/#org"}}, {"@type": "WebPage", "@id": "https://ionova.ai/compare/#webpage", "url": "https://ionova.ai/compare/", "name": "ioNova ARS vs 10 Alternatives: ISO 20022 Structured Address Compliance Compared | ioNova", "description": "Compare 10 alternatives — Loqate, Melissa, Smarty, SWIFT's AI parser and more — against ioNova ARS for the November 2026 ISO 20022 structured address deadline. 25-criterion scores, hybrid address guidance, honest verdicts.", "isPartOf": {"@id": "https://ionova.ai/#website"}, "datePublished": "2026-07-05", "dateModified": "2026-07-05", "about": [{"@type": "Thing", "name": "ISO 20022 structured addresses"}, {"@type": "Thing", "name": "Hybrid addresses"}, {"@type": "Thing", "name": "ISO 20022 compliance"}, {"@type": "Thing", "name": "ISO 20022 deadline (November 2026)"}]}, {"@type": "BreadcrumbList", "@id": "https://ionova.ai/compare/#breadcrumb", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://ionova.ai/"}, {"@type": "ListItem", "position": 2, "name": "Compare", "item": "https://ionova.ai/compare/"}, {"@type": "ListItem", "position": 3, "name": "All Alternatives Compared", "item": "https://ionova.ai/compare/"}]}, {"@type": "FAQPage", "@id": "https://ionova.ai/compare/#faq", "mainEntity": [{"@type": "Question", "name": "The postal platforms are proven at massive scale — why do they score so low here?", "acceptedAnswer": {"@type": "Answer", "text": "The scores are a deployment-scope verdict, not a quality verdict. Loqate, Melissa and Smarty are excellent at what they were designed for: verifying that a mailbox exists. Payment compliance asks a different question — parse a SWIFT MT field, preserve the BIC and IBAN inside it, cite the regulation behind every correction, and emit compliant ISO 20022 XML. Every postal platform scored 0/5 on those signature criteria because the capabilities are architecturally out of scope, not because the products are weak."}}, {"@type": "Question", "name": "Aren’t LLM-based structurers more flexible than a rules engine?", "acceptedAnswer": {"@type": "Answer", "text": "For open-ended tasks, yes. In payment messaging, flexibility becomes non-determinism: the same input can produce different output, latency stretches to seconds, and no field-level rule citation exists for a regulator. ioNova’s positioning is AI-native coverage with rules-engine determinism — a global curated knowledge base built on over 25 years of experience, with a deterministic engine in the critical path, which also keeps ARS outside EU AI Act high-risk classification. Banks adopting an LLM parser inherit its AI risk surface; banks adopting ARS choose when and where to introduce AI."}}, {"@type": "Question", "name": "SWIFT’s parser is free. Why pay for anything?", "acceptedAnswer": {"@type": "Answer", "text": "Free costs more. The parser outputs 2 of 14 ISO 20022 fields, ships as a Python library with no security layer or SLA, needs 3–6 months of engineering to production-wrap — and SWIFT plans its end-of-life by 2027–28, so a replacement project is built into the decision. Over three years, building and replacing a service around the free tool typically exceeds ARS licensing."}}, {"@type": "Question", "name": "What does “full application” mean in practice?", "acceptedAnswer": {"@type": "Answer", "text": "Everything around the engine that banks otherwise build themselves: an Exceptions Workbench where operations staff review and approve low-confidence repairs under maker-checker control; live dashboards for STP, exception ageing and compliance posture; and a Developer Portal with sandbox and test corpora so integration starts the day access is granted. In our ten analyses, every alternative left these as customer-built components."}}, {"@type": "Question", "name": "How fast can we realistically be live before the November 2026 deadline?", "acceptedAnswer": {"@type": "Answer", "text": "Sandbox access within days via the Developer Portal; production integration through any of six mechanisms (REST API, SFTP, IBM MQ, Database, Kafka and MCP); parallel-run and go-live typically inside 2–4 weeks. No core-system replacement, no data migration. The equivalent journey measured in our analyses: ~18 weeks (StructX), 3–6 months (SWIFT Parser wrapped), 26–40 weeks (postal API plus custom payments layer)."}}, {"@type": "Question", "name": "Where do these scores come from?", "acceptedAnswer": {"@type": "Answer", "text": "Ten head-to-head analyses (March–July 2026), each scoring both solutions on the same 25 weighted criteria via a 70-question research protocol against published documentation. The reports credit every competitor’s genuine strengths, flag where evidence is thin, and recommend the competitor where it fits — each per-competitor page below links to its full scorecard."}}, {"@type": "Question", "name": "When is the ISO 20022 structured address deadline?", "acceptedAnswer": {"@type": "Answer", "text": "The November 2026 SWIFT standards release (SR2026). From 14 November 2026, CBPR+ retires fully unstructured postal addresses — SEPA and other market-infrastructure rails are aligned to the same window. After the cutover only fully structured or hybrid addresses are accepted, and the rule also captures payments with a value date on or after the deadline. ioNova ARS enforces the cutover-date logic natively and emits compliant output in a single call."}}, {"@type": "Question", "name": "What is the difference between a structured and a hybrid address?", "acceptedAnswer": {"@type": "Answer", "text": "A fully structured address places every component in its own ISO 20022 element (StrtNm, BldgNb, PstCd, TwnNm, Ctry…) and carries no AddressLine at all. A hybrid address keeps Town Name and Country structured but allows up to two 70-character AddressLine elements for the remainder — a transitional format that remains accepted beyond November 2026. ioNova ARS emits both, across four rendering modes, so every scheme and counterparty receives the exact shape it requires."}}]}]}</script>
<style>
/* ============ ioNova Design System v5 — base ============ */
:root{
  --font-display:'Figtree',system-ui,-apple-system,sans-serif;
  --font-body:'Figtree',system-ui,-apple-system,sans-serif;
  --font-mono:'JetBrains Mono','Fira Code',monospace;
  --navy-950:#0E1935;--navy-900:#111426;--navy-800:#1A1E35;
  --blue-700:#243574;--blue-600:#2B4E86;--blue-500:#3C75B5;--blue-400:#5EA1DC;
  --sky-200:#8ECDF2;--teal-500:#43ADC1;--cyan-400:#5FCFD0;
  --space-xs:4px;--space-sm:8px;--space-md:16px;--space-lg:24px;
  --space-xl:32px;--space-2xl:48px;--space-3xl:64px;--space-4xl:96px;
  --radius-sm:6px;--radius-md:6px;--radius-lg:6px;--radius-xl:6px;--radius-full:9999px;
  --ease:cubic-bezier(0.4,0,0.2,1);--ease-out-expo:cubic-bezier(0.16,1,0.3,1);--dur:0.45s;
  --gradient-brand:linear-gradient(135deg,#5FCFD0,#43ADC1,#3C75B5,#243574);
  --gradient-soft:linear-gradient(135deg,#8ECDF2,#5EA1DC,#3C75B5);
  --gradient-dark:linear-gradient(135deg,#1A1E35,#243574,#2B4E86);
}
html[data-theme="light"]{
  --bg:#F1F4F9;--surface-1:#FFFFFF;--surface-2:#E8EDF5;--surface-3:#D6E0ED;
  --border:#D0DAEB;--border-strong:#B8CCE2;
  --text-primary:#0E1935;--text-label:#466587;--text-muted:#8796A7;
  --alert-red:#DC3545;--alert-red-soft:#FEF2F2;--alert-red-border:#FECACA;--alert-red-text:#991B1B;
  --alert-amber:#F59E0B;--alert-amber-soft:#FFFBEB;--alert-amber-border:#FDE68A;--alert-amber-text:#92400E;
  --alert-green:#10B981;--alert-green-soft:#ECFDF5;--alert-green-border:#A7F3D0;--alert-green-text:#065F46;
  --gradient-text:linear-gradient(135deg,#43ADC1,#3C75B5,#243574);
  --shadow-sm:0 1px 3px rgba(14,25,53,.05),0 1px 2px rgba(14,25,53,.03);
  --shadow-lg:0 8px 30px rgba(14,25,53,.09),0 0 0 1px rgba(67,173,193,.06);
  --shadow-lifted:0 12px 40px rgba(14,25,53,.10),0 0 0 1px rgba(67,173,193,.08);
  --nav-bg:rgba(241,244,249,.75);--nav-border:#D0DAEB;
  --btn-primary-bg:#0E1935;--btn-primary-hover:#243574;--btn-primary-shadow:rgba(14,25,53,.25);
  --badge-low-bg:#B8CCE2;--badge-low-text:#243574;
  --decision-bg:#243574;--orb-opacity:.06;--hover-lift:-4px;
}
html[data-theme="dark"]{
  --bg:#060A15;--surface-1:#0F1729;--surface-2:#182238;--surface-3:#222F4C;
  --border:#1E2A48;--border-strong:#2D4062;
  --text-primary:#E2E8F4;--text-label:#8A9DBD;--text-muted:#576A86;
  --alert-red:#EF4444;--alert-red-soft:rgba(239,68,68,.1);--alert-red-border:rgba(239,68,68,.25);--alert-red-text:#FCA5A5;
  --alert-amber:#F59E0B;--alert-amber-soft:rgba(245,158,11,.1);--alert-amber-border:rgba(245,158,11,.25);--alert-amber-text:#FCD34D;
  --alert-green:#10B981;--alert-green-soft:rgba(16,185,129,.1);--alert-green-border:rgba(16,185,129,.25);--alert-green-text:#6EE7B7;
  --gradient-text:linear-gradient(135deg,#6ED9DA,#5EA1DC,#8ECDF2);
  --shadow-sm:0 1px 3px rgba(0,0,0,.30);
  --shadow-lg:0 8px 30px rgba(0,0,0,.40),0 0 24px rgba(95,207,208,.05);
  --shadow-lifted:0 12px 40px rgba(0,0,0,.45),0 0 30px rgba(95,207,208,.08);
  --nav-bg:rgba(6,10,21,.75);--nav-border:rgba(30,42,72,.5);
  --btn-primary-bg:#3C75B5;--btn-primary-hover:#5EA1DC;--btn-primary-shadow:rgba(60,117,181,.35);
  --badge-low-bg:#222F4C;--badge-low-text:#8ECDF2;
  --decision-bg:#0C1526;--orb-opacity:.10;--hover-lift:-6px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--font-body);font-size:15px;line-height:1.6;background:var(--bg);color:var(--text-primary);-webkit-font-smoothing:antialiased;transition:background var(--dur) var(--ease),color var(--dur) var(--ease)}
h1,h2,h3,h4{font-family:var(--font-display);color:var(--text-primary)}
h1,h2{font-style:italic}
a{color:var(--blue-400);text-decoration:none}
::selection{background:rgba(94,161,220,.25)}
.wrap{max-width:1200px;margin:0 auto;padding:0 24px}
.mono{font-family:var(--font-mono)}
.grad-text{background:var(--gradient-text);-webkit-background-clip:text;background-clip:text;color:transparent}
.overline{font-family:var(--font-display);font-weight:600;font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:var(--teal-500)}
.orbs{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.orb{position:absolute;border-radius:50%;filter:blur(60px);opacity:var(--orb-opacity);animation:float 25s ease-in-out infinite}
.orb-1{width:520px;height:520px;background:radial-gradient(circle,#5FCFD0,transparent 70%);top:-140px;left:-120px}
.orb-2{width:620px;height:620px;background:radial-gradient(circle,#3C75B5,transparent 70%);top:34%;right:-200px;animation-direction:reverse}
.orb-3{width:460px;height:460px;background:radial-gradient(circle,#43ADC1,transparent 70%);bottom:-160px;left:30%}
@keyframes float{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(40px,-30px) scale(1.06)}66%{transform:translate(-30px,24px) scale(.96)}}
@keyframes gradient-x{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
main,header,footer,section{position:relative;z-index:1}
.reveal{opacity:0;transform:translateY(18px);transition:opacity .7s var(--ease-out-expo),transform .7s var(--ease-out-expo)}
.reveal.visible{opacity:1;transform:translateY(0)}
/* Nav */
.nav{position:fixed;top:0;left:0;right:0;z-index:50;height:64px;background:var(--nav-bg);backdrop-filter:blur(30px) saturate(1.9);-webkit-backdrop-filter:blur(30px) saturate(1.9);border-bottom:1px solid var(--nav-border);transition:box-shadow .3s var(--ease)}
.nav.is-scrolled{box-shadow:var(--shadow-sm)}
.nav-inner{max-width:1200px;margin:0 auto;height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 24px}
.brand{display:flex;align-items:center;gap:10px;font-family:var(--font-display);font-weight:700;font-size:20px;letter-spacing:-.5px;color:var(--text-primary)}
.brand .logo{width:32px;height:32px;border-radius:8px;background:var(--gradient-brand);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:14px}
.nav-links{display:flex;gap:26px;align-items:center}
.nav-links a{font-size:14px;font-weight:500;color:var(--text-label)}
.nav-links a:hover{color:var(--text-primary)}
.theme-toggle{background:var(--surface-2);border:1px solid var(--border);border-radius:var(--radius-full);width:38px;height:38px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text-label);transition:all .25s var(--ease)}
.theme-toggle:hover{border-color:var(--teal-500);color:var(--teal-500)}
.theme-toggle svg{width:17px;height:17px}
html[data-theme="dark"] .icon-sun{display:block}html[data-theme="dark"] .icon-moon{display:none}
html[data-theme="light"] .icon-sun{display:none}html[data-theme="light"] .icon-moon{display:block}
/* Buttons / badges */
.btn{display:inline-flex;align-items:center;gap:8px;font-family:var(--font-display);font-weight:600;font-size:14px;padding:10px 22px;border-radius:var(--radius-full);cursor:pointer;border:0;transition:all .25s var(--ease)}
.btn-lg{font-size:16px;padding:14px 28px}
.btn-primary{background:var(--btn-primary-bg);color:#fff;box-shadow:0 4px 14px var(--btn-primary-shadow)}
.btn-primary:hover{background:var(--btn-primary-hover);transform:translateY(-2px);box-shadow:0 8px 24px var(--btn-primary-shadow),0 0 20px rgba(95,207,208,.15)}
.btn-accent{background:var(--gradient-brand);background-size:200% 200%;animation:gradient-x 6s ease infinite;color:#fff}
.btn-accent:hover{transform:translateY(-2px);box-shadow:0 8px 26px rgba(67,173,193,.35)}
.btn-outline{background:transparent;border:1.5px solid var(--border-strong);color:var(--text-primary)}
.btn-outline:hover{border-color:var(--teal-500);background:var(--surface-2);color:var(--teal-500)}
.badge{display:inline-flex;align-items:center;gap:6px;font-family:var(--font-display);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.5px;padding:4px 12px;border-radius:var(--radius-full);white-space:nowrap}
.badge-high{background:var(--blue-400);color:#fff}
.badge-med{background:var(--teal-500);color:#fff}
.badge-low{background:var(--badge-low-bg);color:var(--badge-low-text)}
.badge-info{background:var(--surface-2);color:var(--text-label)}
.badge-accent{background:linear-gradient(135deg,rgba(95,207,208,.16),rgba(67,173,193,.12));border:1px solid rgba(67,173,193,.4);color:var(--teal-500)}
.badge-red{background:var(--alert-red);color:#fff}
.badge-amber{background:var(--alert-amber);color:#fff}
.badge-green{background:var(--alert-green);color:#fff}
/* Cards / KPI */
.card{background:var(--surface-1);border:1px solid var(--border);border-radius:var(--radius-lg);padding:var(--space-xl);transition:all .3s var(--ease);position:relative}
.card:hover{box-shadow:var(--shadow-lifted);border-color:var(--border-strong);transform:translateY(-3px)}
.card-accent{overflow:hidden}
.card-accent::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--gradient-brand);background-size:200% 200%;animation:gradient-x 6s ease infinite}
.kpi{background:var(--surface-1);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px;text-align:center;position:relative;overflow:hidden;transition:all .3s var(--ease)}
.kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--gradient-brand);opacity:0;transition:opacity .3s var(--ease)}
.kpi:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg)}
.kpi:hover::before{opacity:1}
.kpi-value{font-family:var(--font-display);font-weight:700;font-size:30px;letter-spacing:-1.2px;background:linear-gradient(135deg,var(--blue-400),var(--sky-200));-webkit-background-clip:text;background-clip:text;color:transparent}
.kpi-value.cyan{background:linear-gradient(135deg,var(--cyan-400),var(--teal-500));-webkit-background-clip:text;background-clip:text}
.kpi-value.teal{background:linear-gradient(135deg,var(--teal-500),var(--blue-500));-webkit-background-clip:text;background-clip:text}
.kpi-label{font-size:12px;font-weight:500;color:var(--text-muted);margin-top:4px}
/* Tables */
.table-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface-1);box-shadow:var(--shadow-sm)}
table{border-collapse:collapse;width:100%}
th,td{text-align:left;padding:14px 16px;font-size:14px;border-bottom:1px solid var(--border);vertical-align:top}
thead th{font-family:var(--font-display);font-weight:600;font-size:12.5px;color:var(--text-primary);background:var(--surface-2);white-space:nowrap}
tbody td{color:var(--text-label)}
tbody td:first-child{font-weight:600;color:var(--text-primary)}
tbody tr:last-child td{border-bottom:0}
td.win{color:var(--teal-500);font-weight:600;background:linear-gradient(135deg,rgba(95,207,208,.07),rgba(67,173,193,.04))}
th.win{color:var(--teal-500);background:linear-gradient(135deg,rgba(95,207,208,.12),rgba(67,173,193,.07))}
/* Sections */
section.block{padding:var(--space-4xl) 0}
.section-head{text-align:center;max-width:820px;margin:0 auto var(--space-2xl)}
.section-head h2{font-size:clamp(24px,3.4vw,32px);font-weight:700;letter-spacing:-.6px;margin:12px 0 14px}
.section-head p{color:var(--text-label);font-size:16px}
/* Icon containers */
.icon-container{width:44px;height:44px;border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;flex:none}
.icon-container svg{width:20px;height:20px;stroke-width:1.75}
.ic-teal{background:linear-gradient(135deg,rgba(67,173,193,.16),rgba(67,173,193,.06));border:1px solid rgba(67,173,193,.3);color:var(--teal-500)}
.ic-cyan{background:linear-gradient(135deg,rgba(95,207,208,.16),rgba(95,207,208,.06));border:1px solid rgba(95,207,208,.3);color:var(--cyan-400)}
.ic-blue{background:linear-gradient(135deg,rgba(94,161,220,.16),rgba(94,161,220,.06));border:1px solid rgba(94,161,220,.3);color:var(--blue-400)}
/* ============ Page-specific ============ */
.hero{padding:150px 0 70px;text-align:center;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(900px 420px at 50% -10%,rgba(95,207,208,.10),transparent 70%);pointer-events:none}
.hero h1{font-size:clamp(32px,5vw,52px);font-weight:800;letter-spacing:-1px;max-width:900px;margin:18px auto 20px;line-height:1.12}
.hero p.lead{max-width:720px;margin:0 auto 34px;color:var(--text-label);font-size:clamp(15px,1.8vw,18px)}
.hero-ctas{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-bottom:52px}
.kpi-band{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;max-width:920px;margin:0 auto}
@media(max-width:760px){.kpi-band{grid-template-columns:repeat(2,1fr)}}
/* Category cards */
.cat-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}
@media(max-width:860px){.cat-grid{grid-template-columns:1fr}}
.cat-card{display:flex;flex-direction:column;gap:14px}
.cat-card .head{display:flex;align-items:center;gap:14px}
.cat-card h3{font-size:18px;font-weight:600;letter-spacing:-.3px}
.cat-card .credit{color:var(--text-label);font-size:14px;font-style:italic}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{font-family:var(--font-mono);font-size:12px;padding:4px 10px;border-radius:var(--radius-full);background:var(--surface-2);border:1px solid var(--border);color:var(--text-label)}
.cat-card ul{list-style:none;display:flex;flex-direction:column;gap:8px;margin-top:2px}
.cat-card li{display:flex;gap:10px;font-size:13.5px;color:var(--text-label);align-items:flex-start}
.cat-card li svg{width:14px;height:14px;flex:none;margin-top:4px;color:var(--alert-red)}
/* Scoreboard */
.score-cell{min-width:170px}
.score-num{font-family:var(--font-mono);font-size:13px;font-weight:600;color:var(--text-primary)}
.score-bar{height:6px;border-radius:3px;background:var(--surface-3);margin-top:6px;overflow:hidden}
.score-bar i{display:block;height:100%;border-radius:3px;background:var(--surface-3);width:0;transition:width 1.1s var(--ease-out-expo)}
.score-bar i.brand{background:var(--gradient-brand)}
.score-bar i.mut{background:var(--blue-600);opacity:.55}
tr.hero-row td{background:linear-gradient(135deg,rgba(95,207,208,.10),rgba(67,173,193,.05));border-bottom:2px solid var(--teal-500)}
tr.hero-row td:first-child{color:var(--teal-500)}
.foot-note{font-size:12.5px;color:var(--text-muted);margin-top:14px;line-height:1.6}
/* Capability matrix */
.mx-yes,.mx-no,.mx-part{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600}
.mx-yes{color:var(--alert-green-text)}
.mx-no{color:var(--alert-red-text)}
.mx-part{color:var(--alert-amber-text)}
.mx-yes svg,.mx-no svg,.mx-part svg{width:14px;height:14px;stroke-width:2.5}
.tbc{font-family:var(--font-mono);font-size:10px;color:var(--alert-amber);vertical-align:super}
.row-new td:first-child .badge{margin-left:8px}
/* App / platform band */
.app-band{background:var(--decision-bg);border-radius:var(--radius-xl);padding:var(--space-3xl) var(--space-xl);position:relative;overflow:hidden;color:#E2E8F4}
.app-band::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--gradient-brand);background-size:200% 200%;animation:gradient-x 6s ease infinite}
.app-band::after{content:'';position:absolute;inset:0;background:radial-gradient(700px 320px at 50% 0,rgba(95,207,208,.12),transparent 70%);pointer-events:none}
.app-band .inner{position:relative;z-index:1}
.app-band .overline{color:var(--cyan-400)}
.app-band h2{color:#fff;font-size:clamp(24px,3.4vw,32px);letter-spacing:-.6px;margin:12px 0 14px}
.app-band p.sub{color:#9FB0CE;max-width:760px;margin:0 auto 40px;text-align:center}
.app-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:44px}
@media(max-width:860px){.app-grid{grid-template-columns:1fr}}
.app-card{background:rgba(255,255,255,.04);border:1px solid rgba(142,205,242,.15);border-radius:var(--radius-lg);padding:26px;transition:all .3s var(--ease)}
.app-card:hover{border-color:rgba(95,207,208,.45);transform:translateY(-3px);box-shadow:0 12px 40px rgba(0,0,0,.35),0 0 30px rgba(95,207,208,.10)}
.app-card h3{color:#fff;font-size:16.5px;font-weight:600;margin:14px 0 8px}
.app-card p{color:#9FB0CE;font-size:13.5px;line-height:1.6}
.app-card .contrast{margin-top:14px;padding-top:12px;border-top:1px dashed rgba(142,205,242,.2);font-size:12.5px;color:#7C8DB0}
.app-card .contrast b{color:var(--cyan-400);font-weight:600}
.integ-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}
@media(max-width:960px){.integ-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:560px){.integ-grid{grid-template-columns:repeat(2,1fr)}}
.integ{background:rgba(255,255,255,.04);border:1px solid rgba(142,205,242,.15);border-radius:var(--radius-md);padding:16px 12px;text-align:center;transition:all .25s var(--ease)}
.integ:hover{border-color:rgba(95,207,208,.45);transform:translateY(-2px)}
.integ svg{width:20px;height:20px;color:var(--cyan-400);stroke-width:1.75}
.integ .t{font-family:var(--font-display);font-weight:600;font-size:12.5px;color:#E2E8F4;margin-top:8px}
.integ .d{font-size:11px;color:#7C8DB0;margin-top:2px;line-height:1.45}
.app-note{text-align:center;font-size:12.5px;color:#7C8DB0;margin-top:26px}
/* Time to value */
.ttv{display:flex;flex-direction:column;gap:18px;max-width:880px;margin:0 auto}
.ttv-row .label{display:flex;justify-content:space-between;font-size:13.5px;margin-bottom:6px}
.ttv-row .label b{font-family:var(--font-display);font-weight:600;color:var(--text-primary)}
.ttv-row .label span{font-family:var(--font-mono);font-size:12px;color:var(--text-muted)}
.ttv-bar{height:14px;border-radius:7px;background:var(--surface-2);overflow:hidden}
.ttv-bar i{display:block;height:100%;border-radius:7px;width:0;transition:width 1.2s var(--ease-out-expo)}
.ttv-bar i.brand{background:var(--gradient-brand);background-size:200% 200%;animation:gradient-x 6s ease infinite}
.ttv-bar i.mut{background:var(--surface-3)}
html[data-theme="dark"] .ttv-bar i.mut{background:#2D4062}
/* Honest strip */
.honest-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
@media(max-width:860px){.honest-grid{grid-template-columns:1fr}}
.alert{display:flex;gap:14px;padding:16px 18px;border-radius:var(--radius-md);border:1px solid;border-left-width:4px;transition:all .25s var(--ease)}
.alert:hover{transform:translateY(-1px)}
.alert-icon{width:34px;height:34px;border-radius:var(--radius-full);flex:none;display:flex;align-items:center;justify-content:center}
.alert-icon svg{width:18px;height:18px;stroke-width:2}
.alert-title{font-family:var(--font-display);font-weight:600;font-size:14px}
.alert-body{font-size:13px;line-height:1.55}
.alert-green{background:var(--alert-green-soft);border-color:var(--alert-green-border);border-left-color:var(--alert-green)}
.alert-green .alert-icon{background:var(--alert-green);color:#fff}
.alert-green .alert-title,.alert-green .alert-body{color:var(--alert-green-text)}
.alert-amber{background:var(--alert-amber-soft);border-color:var(--alert-amber-border);border-left-color:var(--alert-amber)}
.alert-amber .alert-icon{background:var(--alert-amber);color:#fff}
.alert-amber .alert-title,.alert-amber .alert-body{color:var(--alert-amber-text)}
/* FAQ */
.faq{max-width:860px;margin:0 auto;display:flex;flex-direction:column;gap:14px}
.faq-item{background:var(--surface-1);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;transition:border-color .3s var(--ease)}
.faq-item.open{border-color:var(--teal-500)}
.faq-q{width:100%;text-align:left;background:none;border:0;cursor:pointer;padding:20px 24px;font-family:var(--font-display);font-weight:600;font-size:15.5px;color:var(--text-primary);display:flex;justify-content:space-between;align-items:center;gap:16px}
.faq-q svg{width:18px;height:18px;flex:none;color:var(--text-muted);transition:transform .3s var(--ease)}
.faq-item.open .faq-q svg{transform:rotate(180deg);color:var(--teal-500)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .35s var(--ease)}
.faq-a p{padding:0 24px 22px;color:var(--text-label);font-size:14px}
/* Final CTA */
.final-inner{background:var(--decision-bg);border-radius:var(--radius-xl);padding:70px 32px;text-align:center;color:#fff;position:relative;overflow:hidden}
.final-inner::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--gradient-brand);background-size:200% 200%;animation:gradient-x 6s ease infinite}
.final-inner::after{content:'';position:absolute;inset:0;background:radial-gradient(700px 320px at 50% 0,rgba(95,207,208,.14),transparent 70%)}
.final-inner h2{position:relative;z-index:1;font-size:clamp(26px,4vw,38px);font-weight:800;letter-spacing:-.8px;margin-bottom:16px;color:#fff}
.final-inner p{position:relative;z-index:1;color:#9FB0CE;max-width:600px;margin:0 auto 30px}
.final-inner .btn{position:relative;z-index:1}
/* Footer */
footer{border-top:1px solid var(--border);padding:56px 0 32px;background:var(--surface-1)}
.foot-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:36px}
@media(max-width:760px){.foot-grid{grid-template-columns:1fr 1fr}}
.foot-about p{color:var(--text-label);font-size:13.5px;max-width:300px;margin-top:14px}
.foot-col h4{font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:var(--teal-500);margin-bottom:16px;font-family:var(--font-display);font-weight:600}
.foot-col a{display:block;color:var(--text-label);font-size:14px;margin-bottom:11px}
.foot-col a:hover{color:var(--blue-400)}
.foot-bottom{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;border-top:1px solid var(--border);margin-top:44px;padding-top:22px;color:var(--text-muted);font-size:12.5px}
</style>
</head>
