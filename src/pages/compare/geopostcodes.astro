---
import CompareStaticPage from "@/components/compare/CompareStaticPage.astro";
import { buildComparePageFromHtml } from "@/data/comparePages";

const sourceHtml = String.raw`<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GeoPostCodes vs ioNova ARS: Postal Reference Data vs ISO 20022 Compliance Engine | ioNova</title>
<meta name="description" content="GeoPostCodes is the 246-country postal dataset ioNova ARS embeds as its verification layer. For the November 2026 ISO 20022 structured address deadline, one is the ingredient and the other the finished engine.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..800;1,300..800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<meta name="robots" content="index, follow">
<meta name="keywords" content="GeoPostCodes, postal reference data, ISO 20022 address data, structured addresses, ISO 20022 compliance, address database, November 2026, ioNova ARS">
<meta name="author" content="ioNova">
<link rel="canonical" href="https://ionova.ai/compare/geopostcodes">
<meta property="og:type" content="website">
<meta property="og:site_name" content="ioNova">
<meta property="og:title" content="GeoPostCodes vs ioNova ARS: Postal Reference Data vs ISO 20022 Compliance Engine | ioNova">
<meta property="og:description" content="GeoPostCodes is the 246-country postal dataset ioNova ARS embeds as its verification layer. For the November 2026 ISO 20022 structured address deadline, one is the ingredient and the other the finished engine.">
<meta property="og:url" content="https://ionova.ai/compare/geopostcodes">
<meta property="og:image" content="https://ionova.ai/og-image.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="GeoPostCodes vs ioNova ARS: Postal Reference Data vs ISO 20022 Compliance Engine | ioNova">
<meta name="twitter:description" content="GeoPostCodes is the 246-country postal dataset ioNova ARS embeds as its verification layer. For the November 2026 ISO 20022 structured address deadline, one is the ingredient and the other the finished engine.">
<script type="application/ld+json">{"@context": "https://schema.org", "@graph": [{"@type": "Organization", "@id": "https://ionova.ai/#org", "name": "ioNova AI", "url": "https://ionova.ai/", "description": "Intelligent Data Infrastructure for Regulated Enterprises. AI-Native ISO 20022 Address Resolution.", "logo": "https://ionova.ai/og-image.png"}, {"@type": "WebSite", "@id": "https://ionova.ai/#website", "name": "ioNova", "url": "https://ionova.ai/", "publisher": {"@id": "https://ionova.ai/#org"}}, {"@type": "WebPage", "@id": "https://ionova.ai/compare/geopostcodes#webpage", "url": "https://ionova.ai/compare/geopostcodes", "name": "GeoPostCodes vs ioNova ARS: Postal Reference Data vs ISO 20022 Compliance Engine | ioNova", "description": "GeoPostCodes is the 246-country postal dataset ioNova ARS embeds as its verification layer. For the November 2026 ISO 20022 structured address deadline, one is the ingredient and the other the finished engine.", "isPartOf": {"@id": "https://ionova.ai/#website"}, "datePublished": "2026-07-05", "dateModified": "2026-07-05", "about": [{"@type": "Thing", "name": "ISO 20022 structured addresses"}, {"@type": "Thing", "name": "Hybrid addresses"}, {"@type": "Thing", "name": "ISO 20022 compliance"}, {"@type": "Thing", "name": "ISO 20022 deadline (November 2026)"}]}, {"@type": "BreadcrumbList", "@id": "https://ionova.ai/compare/geopostcodes#breadcrumb", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://ionova.ai/"}, {"@type": "ListItem", "position": 2, "name": "Compare", "item": "https://ionova.ai/compare/"}, {"@type": "ListItem", "position": 3, "name": "vs GeoPostCodes", "item": "https://ionova.ai/compare/geopostcodes"}]}, {"@type": "FAQPage", "@id": "https://ionova.ai/compare/geopostcodes#faq", "mainEntity": [{"@type": "Question", "name": "Is GeoPostCodes a competitor to ioNova?", "acceptedAnswer": {"@type": "Answer", "text": "No — it is ioNova’s embedded data supplier. ARS ships with the GeoPostCodes 246-country dataset inside as its verification layer, so the two sit in the same stack, not on the same shortlist. The real procurement question is “which problem are we solving”: parsing-and-correction (an engine) versus reference-data enrichment (a dataset)."}}, {"@type": "Question", "name": "When should we license GeoPostCodes directly?", "acceptedAnswer": {"@type": "Answer", "text": "For non-payment uses: logistics, e-commerce, ERP, GIS and market-research teams that need self-hosted global postal reference data and are prepared to build their own logic on top. For payments address compliance, the same data is already inside ARS — a direct licence adds procurement effort without adding capability."}}, {"@type": "Question", "name": "Why does GeoPostCodes score so low in this analysis?", "acceptedAnswer": {"@type": "Answer", "text": "Because it was scored against a parser’s job description. Twelve of the 25 “Not Met” results are architectural: a reference-data product cannot extract financial identifiers or produce confidence scores, because it performs no parse at all. Within its own category, the analysis calls it a high-quality offering — the low composite is a category mismatch, not a quality verdict."}}, {"@type": "Question", "name": "Could we build our own parser on GeoPostCodes data?", "acceptedAnswer": {"@type": "Answer", "text": "Yes — that is the in-house path, and the data licence is the smallest line item in it. The parsing engine, financial-identifier extraction, regulator-grade audit trail and ongoing rule maintenance are an 18–36 month build with a standing engineering team behind it. ARS delivers the same outcome, on the same data, in 2–4 weeks."}}, {"@type": "Question", "name": "Is the weekly data refresh a problem?", "acceptedAnswer": {"@type": "Answer", "text": "For a data product, no — freshness is a feature. For a compliance system built directly on it, unpinned weekly drift breaks replayability: the same input can resolve differently after a refresh, and a regulator cannot re-run last quarter’s decision. ARS versions both its rules and its embedded data, so identical input replays identically."}}, {"@type": "Question", "name": "Does ioNova actually ship a UI, or is it another API?", "acceptedAnswer": {"@type": "Answer", "text": "ioNova ARS is a full application. Operations teams work exceptions in a maker-checker Workbench with per-field confidence and rule citations; managers watch live dashboards for STP, exception ageing and compliance posture; developers self-serve on the Portal with sandbox keys and test corpora. With a postal API, each of those is a system you build and maintain yourself."}}]}]}</script>
<style>
/* ============ ioNova Design System v5 — base ============ */
:root{
  --font-display:'Figtree',system-ui,-apple-system,sans-serif;
  --font-body:'Figtree',system-ui,-apple-system,sans-serif;
  --font-mono:'JetBrains Mono','Fira Code',monospace;
  --navy-950:#0E1935;--navy-900:#111426;--navy-800:#1A1E35;
  --blue-700:#243574;--blue-600:#2B4E86;--blue-500:#3C75B5;--blue-400:#5EA1DC;
  --sky-200:#8ECDF2;--teal-500:#43ADC1;--cyan-400:#5FCFD0;
  --space-xs:4px;--space-sm:8px;--space-md:16px;--space-lg:24px;
  --space-xl:32px;--space-2xl:48px;--space-3xl:64px;--space-4xl:96px;
  --radius-sm:6px;--radius-md:6px;--radius-lg:6px;--radius-xl:6px;--radius-full:9999px;
  --ease:cubic-bezier(0.4,0,0.2,1);--ease-out-expo:cubic-bezier(0.16,1,0.3,1);--dur:0.45s;
  --gradient-brand:linear-gradient(135deg,#5FCFD0,#43ADC1,#3C75B5,#243574);
  --gradient-soft:linear-gradient(135deg,#8ECDF2,#5EA1DC,#3C75B5);
}
html[data-theme="light"]{
  --bg:#F1F4F9;--surface-1:#FFFFFF;--surface-2:#E8EDF5;--surface-3:#D6E0ED;
  --border:#D0DAEB;--border-strong:#B8CCE2;
  --text-primary:#0E1935;--text-label:#466587;--text-muted:#8796A7;
  --alert-red:#DC3545;--alert-red-soft:#FEF2F2;--alert-red-border:#FECACA;--alert-red-text:#991B1B;
  --alert-amber:#F59E0B;--alert-amber-soft:#FFFBEB;--alert-amber-border:#FDE68A;--alert-amber-text:#92400E;
  --alert-green:#10B981;--alert-green-soft:#ECFDF5;--alert-green-border:#A7F3D0;--alert-green-text:#065F46;
  --gradient-text:linear-gradient(135deg,#43ADC1,#3C75B5,#243574);
  --shadow-sm:0 1px 3px rgba(14,25,53,.05),0 1px 2px rgba(14,25,53,.03);
  --shadow-lg:0 8px 30px rgba(14,25,53,.09),0 0 0 1px rgba(67,173,193,.06);
  --shadow-lifted:0 12px 40px rgba(14,25,53,.10),0 0 0 1px rgba(67,173,193,.08);
  --nav-bg:rgba(241,244,249,.75);--nav-border:#D0DAEB;
  --btn-primary-bg:#0E1935;--btn-primary-hover:#243574;--btn-primary-shadow:rgba(14,25,53,.25);
  --badge-low-bg:#B8CCE2;--badge-low-text:#243574;
  --decision-bg:#243574;--orb-opacity:.06;
}
html[data-theme="dark"]{
  --bg:#060A15;--surface-1:#0F1729;--surface-2:#182238;--surface-3:#222F4C;
  --border:#1E2A48;--border-strong:#2D4062;
  --text-primary:#E2E8F4;--text-label:#8A9DBD;--text-muted:#576A86;
  --alert-red:#EF4444;--alert-red-soft:rgba(239,68,68,.1);--alert-red-border:rgba(239,68,68,.25);--alert-red-text:#FCA5A5;
  --alert-amber:#F59E0B;--alert-amber-soft:rgba(245,158,11,.1);--alert-amber-border:rgba(245,158,11,.25);--alert-amber-text:#FCD34D;
  --alert-green:#10B981;--alert-green-soft:rgba(16,185,129,.1);--alert-green-border:rgba(16,185,129,.25);--alert-green-text:#6EE7B7;
  --gradient-text:linear-gradient(135deg,#6ED9DA,#5EA1DC,#8ECDF2);
  --shadow-sm:0 1px 3px rgba(0,0,0,.30);
  --shadow-lg:0 8px 30px rgba(0,0,0,.40),0 0 24px rgba(95,207,208,.05);
  --shadow-lifted:0 12px 40px rgba(0,0,0,.45),0 0 30px rgba(95,207,208,.08);
  --nav-bg:rgba(6,10,21,.75);--nav-border:rgba(30,42,72,.5);
  --btn-primary-bg:#3C75B5;--btn-primary-hover:#5EA1DC;--btn-primary-shadow:rgba(60,117,181,.35);
  --badge-low-bg:#222F4C;--badge-low-text:#8ECDF2;
  --decision-bg:#0C1526;--orb-opacity:.10;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--font-body);font-size:15px;line-height:1.6;background:var(--bg);color:var(--text-primary);-webkit-font-smoothing:antialiased;transition:background var(--dur) var(--ease),color var(--dur) var(--ease)}
h1,h2,h3,h4{font-family:var(--font-display);color:var(--text-primary)}
h1,h2{font-style:italic}
a{color:var(--blue-400);text-decoration:none}
::selection{background:rgba(94,161,220,.25)}
.wrap{max-width:1200px;margin:0 auto;padding:0 24px}
.mono{font-family:var(--font-mono)}
.grad-text{background:var(--gradient-text);-webkit-background-clip:text;background-clip:text;color:transparent}
.overline{font-family:var(--font-display);font-weight:600;font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:var(--teal-500)}
.orbs{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.orb{position:absolute;border-radius:50%;filter:blur(60px);opacity:var(--orb-opacity);animation:float 25s ease-in-out infinite}
.orb-1{width:520px;height:520px;background:radial-gradient(circle,#5FCFD0,transparent 70%);top:-140px;left:-120px}
.orb-2{width:620px;height:620px;background:radial-gradient(circle,#3C75B5,transparent 70%);top:34%;right:-200px;animation-direction:reverse}
.orb-3{width:460px;height:460px;background:radial-gradient(circle,#43ADC1,transparent 70%);bottom:-160px;left:30%}
@keyframes float{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(40px,-30px) scale(1.06)}66%{transform:translate(-30px,24px) scale(.96)}}
@keyframes gradient-x{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
main,header,footer,section{position:relative;z-index:1}
.reveal{opacity:0;transform:translateY(18px);transition:opacity .7s var(--ease-out-expo),transform .7s var(--ease-out-expo)}
.reveal.visible{opacity:1;transform:translateY(0)}
.nav{position:fixed;top:0;left:0;right:0;z-index:50;height:64px;background:var(--nav-bg);backdrop-filter:blur(30px) saturate(1.9);-webkit-backdrop-filter:blur(30px) saturate(1.9);border-bottom:1px solid var(--nav-border);transition:box-shadow .3s var(--ease)}
.nav.is-scrolled{box-shadow:var(--shadow-sm)}
.nav-inner{max-width:1200px;margin:0 auto;height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 24px}
.brand{display:flex;align-items:center;gap:10px;font-family:var(--font-display);font-weight:700;font-size:20px;letter-spacing:-.5px;color:var(--text-primary)}
.brand .logo{width:32px;height:32px;border-radius:8px;background:var(--gradient-brand);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:14px}
.nav-links{display:flex;gap:26px;align-items:center}
.nav-links a{font-size:14px;font-weight:500;color:var(--text-label)}
.nav-links a:hover{color:var(--text-primary)}
.theme-toggle{background:var(--surface-2);border:1px solid var(--border);border-radius:var(--radius-full);width:38px;height:38px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text-label);transition:all .25s var(--ease)}
.theme-toggle:hover{border-color:var(--teal-500);color:var(--teal-500)}
.theme-toggle svg{width:17px;height:17px}
html[data-theme="dark"] .icon-sun{display:block}html[data-theme="dark"] .icon-moon{display:none}
html[data-theme="light"] .icon-sun{display:none}html[data-theme="light"] .icon-moon{display:block}
.btn{display:inline-flex;align-items:center;gap:8px;font-family:var(--font-display);font-weight:600;font-size:14px;padding:10px 22px;border-radius:var(--radius-full);cursor:pointer;border:0;transition:all .25s var(--ease)}
.btn-lg{font-size:16px;padding:14px 28px}
.btn-accent{background:var(--gradient-brand);background-size:200% 200%;animation:gradient-x 6s ease infinite;color:#fff}
.btn-accent:hover{transform:translateY(-2px);box-shadow:0 8px 26px rgba(67,173,193,.35)}
.btn-outline{background:transparent;border:1.5px solid var(--border-strong);color:var(--text-primary)}
.btn-outline:hover{border-color:var(--teal-500);background:var(--surface-2);color:var(--teal-500)}
.badge{display:inline-flex;align-items:center;gap:6px;font-family:var(--font-display);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.5px;padding:4px 12px;border-radius:var(--radius-full);white-space:nowrap}
.badge-info{background:var(--surface-2);color:var(--text-label)}
.badge-accent{background:linear-gradient(135deg,rgba(95,207,208,.16),rgba(67,173,193,.12));border:1px solid rgba(67,173,193,.4);color:var(--teal-500)}
.badge-red{background:var(--alert-red);color:#fff}
.badge-amber{background:var(--alert-amber);color:#fff}
.badge-green{background:var(--alert-green);color:#fff}
.card{background:var(--surface-1);border:1px solid var(--border);border-radius:var(--radius-lg);padding:var(--space-xl);transition:all .3s var(--ease);position:relative}
.card:hover{box-shadow:var(--shadow-lifted);border-color:var(--border-strong);transform:translateY(-3px)}
.card-accent{overflow:hidden}
.card-accent::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--gradient-brand);background-size:200% 200%;animation:gradient-x 6s ease infinite}
.kpi{background:var(--surface-1);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px;text-align:center;position:relative;overflow:hidden;transition:all .3s var(--ease)}
.kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--gradient-brand);opacity:0;transition:opacity .3s var(--ease)}
.kpi:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg)}
.kpi:hover::before{opacity:1}
.kpi-value{font-family:var(--font-display);font-weight:700;font-size:28px;letter-spacing:-1.2px;background:linear-gradient(135deg,var(--blue-400),var(--sky-200));-webkit-background-clip:text;background-clip:text;color:transparent}
.kpi-value.cyan{background:linear-gradient(135deg,var(--cyan-400),var(--teal-500));-webkit-background-clip:text;background-clip:text}
.kpi-value.dim{background:none;-webkit-text-fill-color:var(--text-muted);color:var(--text-muted)}
.kpi-label{font-size:12px;font-weight:500;color:var(--text-muted);margin-top:4px}
.kpi-sub{font-family:var(--font-mono);font-size:11px;color:var(--text-muted);margin-top:8px;padding-top:8px;border-top:1px dashed var(--border)}
.table-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface-1);box-shadow:var(--shadow-sm)}
table{border-collapse:collapse;width:100%}
th,td{text-align:left;padding:13px 16px;font-size:14px;border-bottom:1px solid var(--border);vertical-align:top}
thead th{font-family:var(--font-display);font-weight:600;font-size:12.5px;color:var(--text-primary);background:var(--surface-2);white-space:nowrap}
tbody td{color:var(--text-label)}
tbody td:first-child{font-weight:600;color:var(--text-primary)}
tbody tr:last-child td{border-bottom:0}
td.win{color:var(--teal-500);font-weight:600;background:linear-gradient(135deg,rgba(95,207,208,.07),rgba(67,173,193,.04))}
th.win{color:var(--teal-500);background:linear-gradient(135deg,rgba(95,207,208,.12),rgba(67,173,193,.07))}
tr.cat-row td{font-family:var(--font-display);font-weight:600;font-size:12px;letter-spacing:.8px;text-transform:uppercase;color:var(--teal-500);background:var(--surface-2)}
td .code{font-family:var(--font-mono);font-size:10.5px;color:var(--text-muted);display:block}
td.sc{font-family:var(--font-mono);font-size:13px;white-space:nowrap}
td.sc.hi{color:var(--teal-500);font-weight:600}
td.delta{font-family:var(--font-mono);font-size:12.5px;color:var(--alert-green-text);white-space:nowrap}
section.block{padding:var(--space-4xl) 0}
.section-head{text-align:center;max-width:820px;margin:0 auto var(--space-2xl)}
.section-head h2{font-size:clamp(24px,3.4vw,32px);font-weight:700;letter-spacing:-.6px;margin:12px 0 14px}
.section-head p{color:var(--text-label);font-size:16px}
.icon-container{width:44px;height:44px;border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;flex:none}
.icon-container svg{width:20px;height:20px;stroke-width:1.75}
.ic-teal{background:linear-gradient(135deg,rgba(67,173,193,.16),rgba(67,173,193,.06));border:1px solid rgba(67,173,193,.3);color:var(--teal-500)}
.ic-cyan{background:linear-gradient(135deg,rgba(95,207,208,.16),rgba(95,207,208,.06));border:1px solid rgba(95,207,208,.3);color:var(--cyan-400)}
.ic-blue{background:linear-gradient(135deg,rgba(94,161,220,.16),rgba(94,161,220,.06));border:1px solid rgba(94,161,220,.3);color:var(--blue-400)}
/* ===== template page specifics ===== */
.hero{padding:150px 0 70px;text-align:center;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(900px 420px at 50% -10%,rgba(95,207,208,.10),transparent 70%);pointer-events:none}
.hero h1{font-size:clamp(30px,4.6vw,48px);font-weight:800;letter-spacing:-1px;max-width:940px;margin:18px auto 20px;line-height:1.12}
.hero p.lead{max-width:760px;margin:0 auto 30px;color:var(--text-label);font-size:clamp(15px,1.8vw,17.5px)}
.hero-badges{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:34px}
.kpi-band{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;max-width:980px;margin:0 auto}
@media(max-width:860px){.kpi-band{grid-template-columns:repeat(2,1fr)}}
.vs-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}
@media(max-width:860px){.vs-grid{grid-template-columns:1fr}}
.profile h3{font-size:19px;font-weight:600;margin-bottom:4px}
.profile .sub{font-size:12.5px;color:var(--text-muted);font-family:var(--font-mono);margin-bottom:14px}
.profile p.desc{color:var(--text-label);font-size:14px;font-style:italic;margin-bottom:18px}
.profile ul{list-style:none;display:flex;flex-direction:column;gap:10px}
.profile li{display:flex;gap:10px;font-size:13.5px;color:var(--text-label);align-items:flex-start}
.profile li svg{width:14px;height:14px;flex:none;margin-top:4px}
.profile.theirs li svg{color:var(--text-muted)}
.profile.ours li svg{color:var(--teal-500)}
.cat-bars{max-width:860px;margin:0 auto;display:flex;flex-direction:column;gap:26px}
.cat-bar .head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px}
.cat-bar .head b{font-family:var(--font-display);font-weight:600;font-size:15px}
.cat-bar .head span{font-family:var(--font-mono);font-size:11.5px;color:var(--text-muted)}
.duo{display:flex;flex-direction:column;gap:6px}
.duo .row{display:flex;align-items:center;gap:12px}
.duo .who{width:92px;font-size:11.5px;color:var(--text-muted);font-family:var(--font-mono);flex:none;text-align:right}
.duo .track{flex:1;height:12px;border-radius:6px;background:var(--surface-2);overflow:hidden}
.duo .track i{display:block;height:100%;border-radius:6px;width:0;transition:width 1.1s var(--ease-out-expo)}
.duo .track i.brand{background:var(--gradient-brand);background-size:200% 200%;animation:gradient-x 6s ease infinite}
.duo .track i.mut{background:var(--surface-3)}
html[data-theme="dark"] .duo .track i.mut{background:#2D4062}
.duo .val{width:44px;font-family:var(--font-mono);font-size:12px;color:var(--text-label);flex:none}
.app-band{background:var(--decision-bg);border-radius:var(--radius-xl);padding:var(--space-3xl) var(--space-xl);position:relative;overflow:hidden;color:#E2E8F4}
.app-band::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--gradient-brand);background-size:200% 200%;animation:gradient-x 6s ease infinite}
.app-band::after{content:'';position:absolute;inset:0;background:radial-gradient(700px 320px at 50% 0,rgba(95,207,208,.12),transparent 70%);pointer-events:none}
