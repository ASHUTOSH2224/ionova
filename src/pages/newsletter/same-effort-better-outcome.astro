    <h2 style="font-family:Calibri,Arial,sans-serif;font-weight:900;font-size:22px;line-height:1.25;color:#232F3E;margin:0 0 20px 0;letter-spacing:-0.3px;">The &#8220;Which Paris?&#8221; Problem</h2>

    <!-- Stat Box -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;">
    <tr>
