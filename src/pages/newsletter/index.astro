---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';

interface NewsletterItem {
  title: string;
  excerpt: string;
  date: string;
  issue: string;
  href: string;
}

const newsletters: NewsletterItem[] = [
  {
    title: 'Every Vendor Scores Itself 5/5',
    excerpt: 'The scorecard vendors did not write: 25 criteria, evidence tiers, category weights, and risk-adjusted scoring for ISO 20022 address solutions.',
    date: '2026-07-01',
    issue: 'Issue #7',
    href: '/newsletter/how-to-evaluate-an-iso-20022-address-solution',
  },
  {
    title: 'Four Paths. One Deadline.',
    excerpt: '97% of payment traffic runs on MX. Roughly 60% of the addresses inside are still unstructured. The anatomy of fixing it — and which of four paths to take before November 2026.',
    date: '2026-06-01',
    issue: 'Issue #6',
    href: '/newsletter/four-paths-one-iso-20022-deadline',
  },
  {
    title: 'ISO 20022 Just Stopped Being a Bank Problem',
    excerpt: 'The four-path framework for corporates navigating the structured address mandate — and why the November 2026 deadline is now squarely a corporate treasury issue.',
    date: '2026-05-01',
    issue: 'Issue #5',
    href: '/newsletter/issue-5-four-path-framework',
  },
  {
    title: "Beyond Translation: Why Format Compliance Isn't Enough",
    excerpt: 'Format compliance means your messages validate. Data readiness means the information inside them is structured, unambiguous, and actionable. The gap between them is where payment failures live.',
    date: '2026-04-01',
    issue: 'Issue #4',
    href: '/newsletter/the-last-mile-of-iso-20022',
  },
  {
    title: 'The True Cost of Minimum Compliance',
    excerpt: 'Targeting the hybrid address floor costs the same as targeting full structured addresses — but delivers a fraction of the operational and AI value.',
    date: '2026-03-01',
    issue: 'Issue #3',
    href: '/newsletter/the-true-cost-of-minimum-compliance',
  },
  {
    title: 'The Misconception Costing Banks Twice',
    excerpt: 'Same implementation effort, better outcome. Why banks defaulting to hybrid addressing are paying full price for 20% of the value.',
    date: '2026-02-01',
    issue: 'Issue #2',
    href: '/newsletter/same-effort-better-outcome',
  },
  {
    title: 'One Data Shift, Four Wins',
    excerpt: 'The compliance dividend: how structuring address data for the November 2026 mandate simultaneously improves STP rates, reduces AML false positives, and future-proofs AI initiatives.',
    date: '2026-01-01',
    issue: 'Issue #1',
    href: '/newsletter/the-compliance-dividend',
  },
];

// Append T12:00:00 so the date is parsed as local noon, not UTC midnight,
// preventing off-by-one month display in UTC-behind timezones (e.g. US Eastern).
function formatDate(dateStr: string) {
  return new Date(dateStr + 'T12:00:00').toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
}
---

<Layout
  title="Newsletter — Resolved! by ioNova AI | ISO 20022 Address Intelligence Insights"
  description="Resolved! — the ioNova AI newsletter covering ISO 20022 structured addresses, SWIFT CBPR+ compliance, and payment data intelligence for banks and corporates."
  keywords="ISO 20022 newsletter, SWIFT CBPR+ insights, payment compliance newsletter, ioNova newsletter, structured address mandate"
  ogImage="/og-image.png"
  ogImageAlt="Resolved! Newsletter by ioNova AI"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Resolved! Newsletter by ioNova AI",
    "description": "ISO 20022 address intelligence insights for banks and corporates navigating the November 2026 structured address mandate.",
    "url": "https://ionova.ai/newsletter",
    "publisher": { "@id": "https://ionova.ai/#organization" }
  })} />

  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">

      <!-- Hero -->
      <div class="ds-v5">
        <section class="hero">
          <div class="hero-badge">
            <span class="pulse-dot"></span>
            <span style="position: relative; z-index: 1;">Newsletter</span>
          </div>
          <h1>
            Resolved! <span class="accent">by ioNova AI</span>
          </h1>
          <p class="hero-subtitle" style="max-width: 640px; margin-inline: auto;">
            ISO 20022 address intelligence insights for banks and corporates navigating the November 2026 structured address mandate.
          </p>
        </section>
      </div>

      <!-- Newsletter grid -->
      <section class="bg-background py-12 md:py-16">
        <div class="container">

          <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
            <div>
              <span class="text-teal-600 font-bold tracking-widest uppercase text-xs mb-2 block">All Issues</span>
              <h2 class="font-extrabold text-navy-950 tracking-tight">Latest Issues</h2>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {newsletters.map((item) => (
              <a
                href={item.href}
                class="group flex flex-col gap-4 bg-white rounded-[6px] border border-slate-100 p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200 no-underline"
              >
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-50 text-teal-600 border border-teal-100">
                    {item.issue}
                  </span>
                  <span class="text-xs text-slate-400 font-medium">{formatDate(item.date)}</span>
                </div>

                <h3 class="text-navy-950 font-bold text-lg leading-snug m-0 group-hover:text-teal-600 transition-colors">
                  {item.title}
                </h3>

                <p class="text-sm text-slate-500 leading-relaxed m-0 flex-1">
                  {item.excerpt}
                </p>

                <div class="flex items-center justify-end pt-4 border-t border-slate-100">
                  <span class="text-xs font-bold text-teal-600 flex items-center gap-1 group-hover:gap-2 transition-all">
                    Read issue
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>

        </div>
      </section>

    </main>
    <Footer />
  </div>
</Layout>
