---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import ROICalculator from '@/views/ROICalculator';
---

<Layout
  title="ISO 20022 Compliance ROI Calculator — ioNova AI"
  description="Calculate your ISO 20022 compliance cost savings. Institutions processing 500K+ payments typically achieve 30–50x ROI within 12 months with ioNova."
  keywords="ISO 20022 ROI calculator, payment compliance cost savings, SWIFT CBPR+ ROI, address intelligence cost reduction, STP rate improvement calculator"
  ogImage="/Logo/hero Image/hero.png"
  ogImageAlt="ioNova ISO 20022 Compliance ROI Calculator"
>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "ISO 20022 Compliance ROI Calculator — ioNova AI",
      "description": "Calculate your ISO 20022 compliance cost savings. Institutions processing 500K+ payments annually typically achieve 30–50x ROI within 12 months with ioNova.",
      "url": "https://ionova.ai/roi-calculator",
      "dateModified": "2026-02-17",
      "isPartOf": { "@type": "WebSite", "url": "https://ionova.ai" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ionova.ai" },
          { "@type": "ListItem", "position": 2, "name": "ROI Calculator", "item": "https://ionova.ai/roi-calculator" }
        ]
      }
    }
  </script>

  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1 ds-v5">
      <!-- Static page heading — server-rendered, crawler-visible -->
      <section class="hero">
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          <span style="position: relative; z-index: 1;">ROI Analysis</span>
        </div>
        <h1>
          ISO 20022 Compliance <br />
          <span class="accent">Cost Calculator</span>
        </h1>
        <p class="hero-subtitle" style="max-width: 700px; margin-inline: auto;">
          Compare the true cost of structured address compliance across all available approaches. Institutions processing 500K+ payments annually typically achieve 30–50x ROI within 12 months.
        </p>
      </section>

      <!-- Interactive ROI Calculator (React island — all sliders and calculations) -->
      <div class="container pb-40">
        <ROICalculator client:load />
      </div>
    </main>
    <Footer />
  </div>
</Layout>
