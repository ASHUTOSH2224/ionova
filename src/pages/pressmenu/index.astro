---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';

interface PressItem {
  title: string;
  slug: string;
  excerpt: string;
  date: string;
  category: string;
  publication: string;
  href: string;
}

const pressItems: PressItem[] = [
  {
    title: 'ioNova AI Solves ISO 20022 Data Challenges',
    slug: 'ionova-ai-solves-iso-20022-data-challenges',
    excerpt: 'ioNova AI launches ioNova ARS — AI-native, deterministic address resolution that converts unstructured payment data into ISO 20022-compliant structured addresses before the 15 November 2026 SWIFT CBPR+ and SEPA deadline.',
    date: '2026-06-17',
    category: 'Press Release',
    publication: 'ioNova AI',
    href: '/pressmenu/ionova-ai-solves-iso-20022-data-challenges',
  },
];

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout
  title="Press Room — ioNova AI | News & Press Releases"
  description="Latest news, press releases and media coverage from ioNova AI — the AI-native ISO 20022 address resolution platform."
  keywords="ioNova AI press room, ioNova news, ISO 20022 press release, ioNova ARS launch, fintech news"
  ogImage="/og-image.png"
  ogImageAlt="ioNova AI Press Room"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "ioNova AI Press Room",
    "description": "Latest news, press releases and media coverage from ioNova AI.",
    "url": "https://ionova.ai/pressmenu",
    "publisher": { "@id": "https://ionova.ai/#organization" }
  })} />

  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">

      <!-- Hero -->
      <div class="ds-v5">
        <section class="hero">
          <div class="hero-orb"></div>
          <div class="hero-badge">
            <span class="pulse-dot"></span>
            <span style="position: relative; z-index: 1;">Press Room</span>
          </div>
          <h1>
            News &amp; <span class="accent">Press Releases</span>
          </h1>
          <p class="hero-subtitle" style="max-width: 680px; margin-inline: auto;">
            The latest announcements, press releases and media coverage from ioNova AI.
          </p>
        </section>
      </div>

      <!-- Press items grid -->
      <section class="bg-background py-12 md:py-16">
        <div class="container">

          <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
            <div>
              <span class="text-teal-600 font-bold tracking-widest uppercase text-xs mb-2 block">Press Room</span>
              <h2 class="font-extrabold text-navy-950 tracking-tight">Latest Releases</h2>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {pressItems.map((item) => (
              <a
                href={item.href}
                class="group flex flex-col gap-4 bg-white rounded-2xl border border-slate-100 p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200 no-underline"
              >
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-50 text-teal-600 border border-teal-100">
                    {item.category}
                  </span>
                  <span class="text-xs text-slate-400 font-medium">{formatDate(item.date)}</span>
                </div>

                <h3 class="text-navy-950 font-bold text-lg leading-snug m-0 group-hover:text-teal-600 transition-colors">
                  {item.title}
                </h3>

                <p class="text-sm text-slate-500 leading-relaxed m-0 flex-1">
                  {item.excerpt}
                </p>

                <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                  <span class="text-xs font-semibold text-slate-400">{item.publication}</span>
                  <span class="text-xs font-bold text-teal-600 flex items-center gap-1 group-hover:gap-2 transition-all">
                    Read release
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>

        </div>
      </section>

    </main>
    <Footer />
  </div>
</Layout>
