---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';

// ---------------------------------------------------------------------------
// DUMMY DATA — design preview only.
// In production the show is distributed via an RSS feed and episodes will be
// fetched from Ghost (see GHOST-SETUP-VIDEOS-PODCASTS.md). Each episode is a
// Ghost post tagged `#podcast`; the Spotify/Apple episode URLs + Spotify embed
// ID live in the post's custom fields. Shape below mirrors that future model.
// ---------------------------------------------------------------------------

// Channel-level subscribe links (point your podcast hosts/feeds here).
const channels = {
  spotify: 'https://open.spotify.com/show/7vxJy3xdBaS42KfCdzWjis',
  youtube: 'https://www.youtube.com/@ionova-insights',
};

interface Episode {
  title: string;
  slug: string;
  episode: number;
  excerpt: string;
  spotifyEmbedId: string;   // Spotify episode ID used in the embed iframe
  spotifyUrl: string;
  youtubeUrl: string;       // matching episode on the Resolved! YouTube channel
  duration: string;
  category: string;
  guest: string;
  published_at: string;
  featured?: boolean;
}

const episodes: Episode[] = [
  {
    title: 'ISO 20022 Addressing Decision: Hybrid vs Structured',
    slug: 'iso-20022-addressing-decision-hybrid-vs-structured',
    episode: 2,
    excerpt: 'Parth on why so many institutions treat structured addressing as a compliance checkbox — and how to make the hybrid-vs-structured call.',
    spotifyEmbedId: '60Nx93anhJC99Rm4pv9clP',
    spotifyUrl: 'https://open.spotify.com/episode/60Nx93anhJC99Rm4pv9clP',
    youtubeUrl: 'https://www.youtube.com/watch?v=7hk-irQqIFE',
    duration: '13 min',
    category: 'Practitioner',
    guest: 'Parth Desai',
    published_at: '2026-05-08',
    featured: true,
  },
  {
    title: 'ISO 20022: The Market Has It Backwards',
    slug: 'iso-20022-the-market-has-it-backwards',
    episode: 1,
    excerpt: 'Parth on why most banks build their ISO 20022 strategy around the weakest version of the standard — and what a stronger, structured-first approach looks like.',
    spotifyEmbedId: '4xrcP1a174QiK11VXSQzoG',
    spotifyUrl: 'https://open.spotify.com/episode/4xrcP1a174QiK11VXSQzoG',
    youtubeUrl: 'https://www.youtube.com/watch?v=LMcB5oo9tWU',
    duration: '11 min',
    category: 'Practitioner',
    guest: 'Parth Desai',
    published_at: '2026-04-09',
  },
];

// Featured section commented out per request — all episodes are listed in the grid below.
// const featured = episodes.find((e) => e.featured) || episodes[0];
// const grid = episodes.filter((e) => e.slug !== featured.slug);

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---

<Layout
  title="ioNova AI Podcast — ISO 20022, Payments & Entity Intelligence"
  description="Listen to the ioNova podcast: conversations on ISO 20022 structured addresses, SWIFT CBPR+ migration, and entity intelligence. Available on Spotify and YouTube."
  keywords="ISO 20022 podcast, payments podcast, SWIFT CBPR+ podcast, fintech podcast, entity intelligence, ioNova podcast"
  ogImage="/og-image.png"
  ogImageAlt="ioNova AI Podcast — ISO 20022 & Payments"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "PodcastSeries",
    "name": "ioNova AI Podcast",
    "description": "Conversations on ISO 20022 structured addresses, SWIFT CBPR+ migration, and entity intelligence for financial institutions.",
    "url": "https://ionova.ai/podcasts",
    "inLanguage": "en-US",
    "publisher": { "@id": "https://ionova.ai/#organization" }
  })} />

  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <!-- Hero -->
      <div class="ds-v5">
        <section class="hero">
          <div class="hero-badge">
            <span class="pulse-dot"></span>
            <span style="position: relative; z-index: 1;">Listen Anywhere</span>
          </div>
          <h1>
            The ioNova <br />
            <span class="accent">Podcast</span>
          </h1>
          <p class="hero-subtitle" style="max-width: 800px; margin-inline: auto;">
            Conversations on ISO 20022 structured addresses, SWIFT CBPR+ migration, and entity intelligence — with the people building the infrastructure behind global payments.
          </p>
        </section>
      </div>

      <!-- Subscribe bar -->
      <section class="bg-background">
        <div class="container">
          <div class="-mt-2 mb-2 flex flex-wrap items-center justify-center gap-3">
            <span class="text-sm font-semibold text-slate-500 mr-1">Subscribe:</span>
            <a href={channels.spotify} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-white border border-slate-200 px-4 py-2 text-sm font-semibold text-navy-950 shadow-sm hover:border-[#1DB954] hover:text-[#1DB954] transition-colors">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.52 17.34c-.24.36-.66.48-1.02.24-2.82-1.74-6.36-2.1-10.56-1.14-.42.12-.78-.18-.9-.54-.12-.42.18-.78.54-.9 4.56-1.02 8.52-.6 11.64 1.32.42.18.48.66.3 1.02zm1.44-3.3c-.3.42-.84.6-1.26.3-3.24-1.98-8.16-2.58-11.94-1.38-.48.12-1.02-.12-1.14-.6-.12-.48.12-1.02.6-1.14 4.38-1.32 9.78-.66 13.5 1.62.36.18.54.78.24 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.1 9.3c-.6.18-1.2-.18-1.38-.72-.18-.6.18-1.2.72-1.38 4.32-1.32 11.4-1.02 15.84 1.62.54.3.72 1.02.42 1.56-.3.42-1.02.66-1.56.3z"/></svg>
              Spotify
            </a>
            <a href={channels.youtube} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-white border border-slate-200 px-4 py-2 text-sm font-semibold text-navy-950 shadow-sm hover:border-[#FF0000] hover:text-[#FF0000] transition-colors">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              YouTube
            </a>
          </div>
        </div>
      </section>

      {/* Featured Episode — commented out per request; all episodes now appear in the grid below.
      <section class="py-12 md:py-16 bg-background relative overflow-hidden">
        <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-blue-50/50 rounded-full blur-[100px] pointer-events-none -translate-y-1/2 translate-x-1/2"></div>
        <div class="container relative z-10">
          <div class="mb-8 flex items-center justify-center md:justify-start">
            <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-white border border-blue-100 rounded-full text-xs font-bold uppercase tracking-wider text-teal-600 shadow-sm">
              <span class="w-1.5 h-1.5 rounded-full bg-teal-400 animate-pulse"></span>
              Latest Episode
            </span>
          </div>
          <div class="border border-slate-100 overflow-hidden bg-white shadow-[0_4px_20px_rgba(14,25,53,0.06)] rounded-3xl">
            <div class="grid md:grid-cols-2 gap-0 items-stretch">
              <!-- Content -->
