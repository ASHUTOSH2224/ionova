---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import PrivacyPolicy from '@/views/PrivacyPolicy.astro';
---

<Layout
  title="ioNova AI — Privacy Policy · Data Protection & Security"
  description="Learn how ioNova AI collects, uses, and protects your information. ISO 27001 certified, SOC 1 Type II compliant, and GDPR compliant."
  ogImage="/Logo/hero Image/hero.png"
  ogImageAlt="ioNova AI Privacy Policy"
  noindex={true}
>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "ioNova AI — Privacy Policy",
      "description": "Learn how ioNova AI collects, uses, and protects your information. ISO 27001 certified, SOC 1 Type II compliant, and GDPR compliant.",
      "url": "https://ionova.ai/privacy-policy",
      "dateModified": "2026-02-17",
      "isPartOf": { "@type": "WebSite", "url": "https://ionova.ai" }
    }
  </script>
  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <PrivacyPolicy />
    </main>
    <Footer />
  </div>
</Layout>
