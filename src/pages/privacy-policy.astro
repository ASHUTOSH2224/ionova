---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import PrivacyPolicy from '@/views/PrivacyPolicy.astro';
---

<Layout
  title="ioNova AI — Privacy Policy · Data Protection & Security"
  description="Learn how ioNova AI collects, uses, and protects your information. ISO 27001 certified, SOC 1 Type II compliant, and GDPR compliant."
  ogImage="/og-image.png"
  ogImageAlt="ioNova AI Privacy Policy"
>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "ioNova AI — Privacy Policy",
      "description": "Learn how ioNova AI collects, uses, and protects your information. ISO 27001 certified, SOC 1 Type II compliant, and GDPR compliant.",
      "url": "https://ionova.ai/privacy-policy",
      "dateModified": "2026-02-17",
      "isPartOf": { "@id": "https://ionova.ai/#website" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ionova.ai" },
          { "@type": "ListItem", "position": 2, "name": "Privacy Policy", "item": "https://ionova.ai/privacy-policy" }
        ]
      }
    }
  </script>
  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <PrivacyPolicy />
    </main>
    <Footer />
  </div>
</Layout>
