<script>
  function fbTick() {
    const d = new Date('2026-11-14T00:00:00Z').getTime() - Date.now();
    if (d <= 0) return;
    const days = Math.floor(d / 864e5);
    const hrs  = Math.floor(d % 864e5 / 36e5);
    const mins = Math.floor(d % 36e5 / 6e4);
    const secs = Math.floor(d % 6e4 / 1e3);
    const p = (n: number) => String(n).padStart(2, '0');
    const el = (id: string) => document.getElementById(id) as HTMLElement | null;
    el('fb-days')    ?.setAttribute('textContent', '');
    if (el('fb-days'))     el('fb-days')!.textContent     = '~' + days;
    if (el('fb-cd-days'))  el('fb-cd-days')!.textContent  = String(days).padStart(3, '0');
    if (el('fb-cd-hours')) el('fb-cd-hours')!.textContent = p(hrs);
    if (el('fb-cd-mins'))  el('fb-cd-mins')!.textContent  = p(mins);
    if (el('fb-cd-secs'))  el('fb-cd-secs')!.textContent  = p(secs);
    if (el('fb-cta-days')) el('fb-cta-days')!.textContent = String(days).padStart(3, '0');
    if (el('fb-cta-hours'))el('fb-cta-hours')!.textContent= p(hrs);
    if (el('fb-cta-mins')) el('fb-cta-mins')!.textContent = p(mins);
  }
  fbTick();
  setInterval(fbTick, 1000);
</script>
