---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import SolCorporateTreasury from '@/views/SolCorporateTreasury.astro';
---

<Layout
  title="ioNova ARS for Corporate Treasury — Fix Beneficiary Data at Source"
  description="After 15 Nov 2026 your bank can’t lawfully fix your counterparty addresses (EPC §3.2). ioNova ARS corrects beneficiary & supplier data at source — pain.001, pain.008, ~98% automatic."
  ogImage="/og-image.png"
  ogImageAlt="Corporate Treasury — ioNova ARS Solution"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebPage","name":"ioNova ARS for Corporate Treasury — Fix Beneficiary Data at Source","description":"After 15 Nov 2026 your bank can’t lawfully fix your counterparty addresses (EPC §3.2). ioNova ARS corrects beneficiary & supplier data at source — pain.001, pain.008, ~98% automatic.","url":"https://ionova.ai/solutions/corporate-treasury","isPartOf":{"@id":"https://ionova.ai/#website"},"breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://ionova.ai"},{"@type":"ListItem","position":2,"name":"Solutions","item":"https://ionova.ai/solutions"},{"@type":"ListItem","position":3,"name":"Corporate Treasury","item":"https://ionova.ai/solutions/corporate-treasury"}]}})} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Service","name":"ioNova ARS for Corporate Treasury","description":"After 15 Nov 2026 your bank can’t lawfully fix your counterparty addresses (EPC §3.2). ioNova ARS corrects beneficiary & supplier data at source — pain.001, pain.008, ~98% automatic.","url":"https://ionova.ai/solutions/corporate-treasury","provider":{"@type":"Organization","name":"ioNova AI","url":"https://ionova.ai"},"serviceType":"ISO 20022 address resolution","areaServed":"Worldwide"})} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can my bank correct my counterparty’s address for me?","acceptedAnswer":{"@type":"Answer","text":"No. Under EPC §3.2 a payment service provider may correct its own customer’s address but must pass counterparty addresses through unchanged — so a corporate must fix beneficiary data at source."}},{"@type":"Question","name":"Who is liable if a payment is rejected for an unstructured address?","acceptedAnswer":{"@type":"Answer","text":"The originator. From 15 November 2026, CBPR+ and SEPA reject non-compliant payments at the network, and the liability sits with whoever assembled the payment."}},{"@type":"Question","name":"Does ioNova ARS work inside SAP, Oracle, Kyriba, GTreasury and ION?","acceptedAnswer":{"@type":"Answer","text":"Yes — it deploys as a sidecar via REST, SFTP, JDBC and File Upload, with no core replacement."}},{"@type":"Question","name":"How many addresses can I remediate at once?","acceptedAnswer":{"@type":"Answer","text":"Up to 10,000 addresses per call for batch master-data clean-up."}},{"@type":"Question","name":"How fast can corporate treasury go live?","acceptedAnswer":{"@type":"Answer","text":"Typically 3–4 weeks end to end, with the sandbox live and returning resolved addresses within about two days."}},{"@type":"Question","name":"Is the correction auditable?","acceptedAnswer":{"@type":"Answer","text":"Yes — every correction is deterministic and cites a regulatory rule_source, so the same input always produces the same output."}}]})} />
  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <div class="ds-v5">
        <div class="container">
          <SolCorporateTreasury />
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
