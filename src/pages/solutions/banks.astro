---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import SolBanks from '@/views/SolBanks.astro';
---

<Layout
  title="ISO 20022 Address Compliance for Banks & PSPs — Two Businesses, One Engine"
  description="In-flight pacs correction at the network boundary plus Address-Quality-as-a-Service for your corporate clients. Sidecar, corridor-by-corridor, shadow-mode first. Live before 15 Nov 2026."
  ogImage="/og-image.png"
  ogImageAlt="Banks & PSPs — ioNova ARS Solution"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebPage","name":"ISO 20022 Address Compliance for Banks & PSPs — Two Businesses, One Engine","description":"In-flight pacs correction at the network boundary plus Address-Quality-as-a-Service for your corporate clients. Sidecar, corridor-by-corridor, shadow-mode first. Live before 15 Nov 2026.","url":"https://ionova.ai/solutions/banks","isPartOf":{"@id":"https://ionova.ai/#website"},"breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://ionova.ai"},{"@type":"ListItem","position":2,"name":"Solutions","item":"https://ionova.ai/solutions"},{"@type":"ListItem","position":3,"name":"Banks & PSPs","item":"https://ionova.ai/solutions/banks"}]}})} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Service","name":"ioNova ARS for Banks & PSPs","description":"In-flight pacs correction at the network boundary plus Address-Quality-as-a-Service for your corporate clients. Sidecar, corridor-by-corridor, shadow-mode first. Live before 15 Nov 2026.","url":"https://ionova.ai/solutions/banks","provider":{"@type":"Organization","name":"ioNova AI","url":"https://ionova.ai"},"serviceType":"ISO 20022 address resolution","areaServed":"Worldwide"})} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can a bank correct a payment address in transit?","acceptedAnswer":{"@type":"Answer","text":"Yes — for its own outbound legs and inbound repair at its liability boundary; but under EPC §3.2 it must pass counterparty addresses through unchanged, which is why client-side fixes are offered as a service."}},{"@type":"Question","name":"Can we enforce corridor by corridor?","acceptedAnswer":{"@type":"Answer","text":"Yes — each flow binds to its own Channel Profile, so you enable the gate per corridor and run shadow mode before enforcing."}},{"@type":"Question","name":"Does it require a core banking replacement?","acceptedAnswer":{"@type":"Answer","text":"No — ioNova ARS deploys as a sidecar with circuit-breaker fallback, via connectors for Volante, Finastra, SWIFT Alliance and IBM MQ."}},{"@type":"Question","name":"How does a bank monetise this?","acceptedAnswer":{"@type":"Answer","text":"By reselling hosted Address-Quality correction to corporate clients whose data it cannot silently fix."}},{"@type":"Question","name":"Are returns and recalls protected?","acceptedAnswer":{"@type":"Answer","text":"Yes — R-transactions are detected and passed through untouched per EPC §8.3."}},{"@type":"Question","name":"How do scheme upgrades work?","acceptedAnswer":{"@type":"Answer","text":"SR2025 → SR2026 → SR2027 ship as configuration, not redeployment, with the regulatory burden carried by ioNova."}}]})} />
  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <div class="ds-v5">
        <div class="container">
          <SolBanks />
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
