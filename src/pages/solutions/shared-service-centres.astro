---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import SolSharedServiceCentres from '@/views/SolSharedServiceCentres.astro';
---

<Layout
  title="ISO 20022 Compliance for Shared Service Centres — Fix Once, All Entities"
  description="Run treasury for a group of entities? Centralise ISO 20022 address compliance once and every entity inherits it. One tuned engine, one Channel Profile per entity, live before 14 Nov 2026."
  ogImage="/og-image.png"
  ogImageAlt="Shared Service Centres — ioNova ARS Solution"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebPage","name":"ISO 20022 Compliance for Shared Service Centres — Fix Once, All Entities","description":"Run treasury for a group of entities? Centralise ISO 20022 address compliance once and every entity inherits it. One tuned engine, one Channel Profile per entity, live before 14 Nov 2026.","url":"https://ionova.ai/solutions/shared-service-centres","isPartOf":{"@id":"https://ionova.ai/#website"},"breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://ionova.ai"},{"@type":"ListItem","position":2,"name":"Solutions","item":"https://ionova.ai/solutions"},{"@type":"ListItem","position":3,"name":"Shared Service Centres","item":"https://ionova.ai/solutions/shared-service-centres"}]}})} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Service","name":"ioNova ARS for Shared Service Centres","description":"Run treasury for a group of entities? Centralise ISO 20022 address compliance once and every entity inherits it. One tuned engine, one Channel Profile per entity, live before 14 Nov 2026.","url":"https://ionova.ai/solutions/shared-service-centres","provider":{"@type":"Organization","name":"ioNova AI","url":"https://ionova.ai"},"serviceType":"ISO 20022 address resolution","areaServed":"Worldwide"})} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can one deployment cover many group entities?","acceptedAnswer":{"@type":"Answer","text":"Yes — a single ioNova ARS engine serves every entity, each added as a Channel Profile rather than new infrastructure."}},{"@type":"Question","name":"Do we have to run a separate compliance project per entity?","acceptedAnswer":{"@type":"Answer","text":"No. You centralise the fix once; each entity inherits the tuned engine and goes live in days."}},{"@type":"Question","name":"How long does a group rollout take?","acceptedAnswer":{"@type":"Answer","text":"A pilot entity in 2–4 weeks, then each later entity goes live in days."}},{"@type":"Question","name":"Is each entity’s data isolated?","acceptedAnswer":{"@type":"Answer","text":"Yes — per-tenant isolation, with deployment available in your own VPC, on-premise or air-gapped."}},{"@type":"Question","name":"Can local controllers see their own entity’s status?","acceptedAnswer":{"@type":"Answer","text":"Yes — per-entity scorecards and audit trails support local sign-off and group audit."}},{"@type":"Question","name":"Is there one audit trail across the group?","acceptedAnswer":{"@type":"Answer","text":"Yes — one engine, one rulebook and one deterministic, rule_source-cited audit trail across every entity."}}]})} />
  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <div class="ds-v5">
        <div class="container">
          <SolSharedServiceCentres />
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
