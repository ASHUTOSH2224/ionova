---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import SolPaymentHubs from '@/views/SolPaymentHubs.astro';
---

<Layout
  title="ISO 20022 Address Enforcement for Payment & Messaging Hubs"
  description="Enforce structured-address quality at the network edge nobody else owns. ioNova ARS gates and repairs every routed pacs in transit, corridor by corridor, sub-50ms. Live in days, before 15 Nov 2026."
  ogImage="/og-image.png"
  ogImageAlt="Payment & Messaging Hubs — ioNova ARS Solution"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebPage","name":"ISO 20022 Address Enforcement for Payment & Messaging Hubs","description":"Enforce structured-address quality at the network edge nobody else owns. ioNova ARS gates and repairs every routed pacs in transit, corridor by corridor, sub-50ms. Live in days, before 15 Nov 2026.","url":"https://ionova.ai/solutions/payment-hubs","isPartOf":{"@id":"https://ionova.ai/#website"},"breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://ionova.ai"},{"@type":"ListItem","position":2,"name":"Solutions","item":"https://ionova.ai/solutions"},{"@type":"ListItem","position":3,"name":"Payment & Messaging Hubs","item":"https://ionova.ai/solutions/payment-hubs"}]}})} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Service","name":"ioNova ARS for Payment & Messaging Hubs","description":"Enforce structured-address quality at the network edge nobody else owns. ioNova ARS gates and repairs every routed pacs in transit, corridor by corridor, sub-50ms. Live in days, before 15 Nov 2026.","url":"https://ionova.ai/solutions/payment-hubs","provider":{"@type":"Organization","name":"ioNova AI","url":"https://ionova.ai"},"serviceType":"ISO 20022 address resolution","areaServed":"Worldwide"})} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Where does a payment hub enforce structured addresses?","acceptedAnswer":{"@type":"Answer","text":"In-flight, at the routing or pain→pacs conversion point — the network edge that no single bank controls."}},{"@type":"Question","name":"Can we roll out without blocking traffic?","acceptedAnswer":{"@type":"Answer","text":"Yes — corridor by corridor in shadow mode first, with a circuit-breaker that falls back to the existing flow."}},{"@type":"Question","name":"How fast is in-flight correction?","acceptedAnswer":{"@type":"Answer","text":"Sub-50ms P95 for the full pipeline, preserving straight-through processing."}},{"@type":"Question","name":"Can it sweep messages in batch?","acceptedAnswer":{"@type":"Answer","text":"Yes — up to 100 complete ISO 20022 messages per overnight call."}},{"@type":"Question","name":"Does it support legacy correspondents?","acceptedAnswer":{"@type":"Answer","text":"Yes — it down-renders structured addresses to MT lines without losing the structured record."}},{"@type":"Question","name":"Which hub connectors are pre-built?","acceptedAnswer":{"@type":"Answer","text":"Volante VolPay, MuleSoft Anypoint, SWIFT Alliance and IBM MQ."}}]})} />
  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <div class="ds-v5">
        <div class="container">
          <SolPaymentHubs />
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
