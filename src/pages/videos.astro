---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';

// ---------------------------------------------------------------------------
// DUMMY DATA — design preview only.
// In production this will be fetched from Ghost (see GHOST-SETUP-VIDEOS-PODCASTS.md).
// Each video lives as a Ghost post tagged `#video` with the YouTube ID stored in
// the post's codeinjection / custom field. Shape below mirrors that future model.
// ---------------------------------------------------------------------------
// Channel-level subscribe links (YouTube).
const youtubeChannels = [
  { name: 'Resolved! by Parth', url: 'https://www.youtube.com/@resolved-by-parth' },
  { name: 'ioNova Insights', url: 'https://www.youtube.com/@ionova-insights' },
];

interface VideoItem {
  title: string;
  slug: string;
  excerpt: string;
  youtubeId: string;
  duration: string;
  category: string;
  author: string;
  published_at: string;
  featured?: boolean;
}

const videos: VideoItem[] = [
  {
    title: 'ISO 20022 – Structured or Hybrid Addresses? | Full Breakdown',
    slug: 'iso-20022-structured-or-hybrid-full-breakdown',
    excerpt: "60% of cross-border payments still require manual intervention despite the industry's massive investment in ISO 20022 migration — here's why, and what to do about it.",
    youtubeId: 'od1xozTmDXE',
    duration: '9:38',
    category: 'Explainer',
    author: 'ioNova AI',
    published_at: '2026-05-29',
    featured: true,
  },
  {
    title: 'ISO 20022 Structured Addresses: The Next Big Migration',
    slug: 'iso-20022-structured-addresses-next-big-migration',
    excerpt: "Most compliance teams assume hybrid addressing is the easier, lower-effort path in the ISO 20022 migration. They're wrong — and it's costing them.",
    youtubeId: '9jpUkaReg4I',
    duration: '6:26',
    category: 'Explainer',
    author: 'ioNova AI',
    published_at: '2026-05-22',
  },
  {
    title: 'ISO 20022 Addressing Decision: Hybrid vs Structured',
    slug: 'iso-20022-addressing-decision-hybrid-vs-structured',
    excerpt: 'In this episode of Resolved!, Parth explains why most financial institutions treat ISO 20022 structured addressing as a compliance checkbox — and the cost of getting it wrong.',
    youtubeId: '7hk-irQqIFE',
    duration: '13:04',
    category: 'Practitioner',
    author: 'Parth Desai',
    published_at: '2026-05-08',
  },
  {
    title: 'ISO 20022: The Market Has It Backwards',
    slug: 'iso-20022-the-market-has-it-backwards',
    excerpt: 'Parth on why most banks build their ISO 20022 compliance strategy around the weakest version of the standard — and how to flip the approach.',
    youtubeId: 'LMcB5oo9tWU',
    duration: '10:40',
    category: 'Practitioner',
    author: 'Parth Desai',
    published_at: '2026-04-09',
  },
];

// Featured section commented out per request — all videos are listed in the grid below.
// const featured = videos.find((v) => v.featured) || videos[0];
// const grid = videos.filter((v) => v.slug !== featured.slug);

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
function thumb(id: string) {
  return `https://img.youtube.com/vi/${id}/maxresdefault.jpg`;
}
---

<Layout
  title="ioNova AI Videos — ISO 20022 Explainers, Demos & Webinars"
  description="Watch expert explainers, product demos, and webinars on ISO 20022 structured addresses, SWIFT CBPR+ migration, and entity intelligence for financial institutions."
  keywords="ISO 20022 videos, payment compliance webinars, SWIFT CBPR+ demo, structured address explainer, fintech video, ioNova demo"
  ogImage="/og-image.png"
  ogImageAlt="ioNova AI Videos — ISO 20022 Explainers & Demos"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "ioNova AI Videos",
    "description": "Expert explainers, product demos, and webinars on ISO 20022 structured addresses, SWIFT CBPR+ migration, and entity intelligence.",
    "url": "https://ionova.ai/videos",
    "inLanguage": "en-US",
    "isPartOf": { "@id": "https://ionova.ai/#website" },
    "publisher": { "@id": "https://ionova.ai/#organization" },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ionova.ai" },
        { "@type": "ListItem", "position": 2, "name": "Videos", "item": "https://ionova.ai/videos" }
      ]
    }
  })} />

  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <!-- Hero -->
      <div class="ds-v5">
        <section class="hero">
          <div class="hero-badge">
            <span class="pulse-dot"></span>
            <span style="position: relative; z-index: 1;">Watch & Learn</span>
          </div>
          <h1>
            Address Intelligence on <br />
            <span class="accent">Video</span>
          </h1>
          <p class="hero-subtitle" style="max-width: 800px; margin-inline: auto;">
            Explainers, product demos, and webinars on ISO 20022 structured addresses, SWIFT CBPR+ migration, and entity intelligence — all playable right here.
          </p>
        </section>
      </div>

      <!-- Subscribe bar -->
      <section class="bg-background">
        <div class="container">
          <div class="-mt-2 mb-2 flex flex-wrap items-center justify-center gap-3">
            <span class="text-sm font-semibold text-slate-500 mr-1">Subscribe on YouTube:</span>
            {youtubeChannels.map((ch) => (
              <a href={ch.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-white border border-slate-200 px-4 py-2 text-sm font-semibold text-navy-950 shadow-sm hover:border-[#FF0000] hover:text-[#FF0000] transition-colors">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                {ch.name}
              </a>
            ))}
          </div>
        </div>
      </section>

      {/* Featured Video — commented out per request; all videos now appear in the grid below.
      <section class="py-12 md:py-16 bg-background relative overflow-hidden">
        <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-blue-50/50 rounded-full blur-[100px] pointer-events-none -translate-y-1/2 translate-x-1/2"></div>
        <div class="container relative z-10">
          <div class="mb-8 flex items-center justify-center md:justify-start">
            <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-white border border-blue-100 rounded-full text-xs font-bold uppercase tracking-wider text-teal-600 shadow-sm">
              <span class="w-1.5 h-1.5 rounded-full bg-teal-400 animate-pulse"></span>
              Featured Video
            </span>
          </div>
          <div class="border border-slate-100 overflow-hidden bg-white shadow-[0_4px_20px_rgba(14,25,53,0.06)] hover:shadow-[0_20px_60px_rgba(14,25,53,0.12)] transition-all duration-500 rounded-3xl">
            <div class="grid md:grid-cols-12 gap-0">
              <!-- Thumbnail / Play -->
              <button
                type="button"
                class="video-trigger group md:col-span-7 relative h-72 md:min-h-[380px] bg-navy-950 flex items-center justify-center overflow-hidden text-left"
                data-video-id={featured.youtubeId}
                data-video-title={featured.title}
                aria-label={`Play video: ${featured.title}`}
              >
                <img
                  src={thumb(featured.youtubeId)}
                  alt={featured.title}
                  loading="eager"
                  class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700"
                />
                <span class="absolute inset-0 bg-gradient-to-t from-navy-950/70 via-navy-950/10 to-transparent"></span>
                <span class="relative z-10 flex h-20 w-20 items-center justify-center rounded-full bg-white/95 shadow-2xl group-hover:scale-110 group-hover:bg-white transition-all duration-300">
                  <svg class="h-8 w-8 text-blue-700 translate-x-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                </span>
                <span class="absolute bottom-4 right-4 z-10 rounded-md bg-navy-950/80 px-2.5 py-1 text-xs font-bold text-white backdrop-blur-sm">{featured.duration}</span>
              </button>
              <!-- Content -->
              <div class="md:col-span-5 p-8 md:p-12 flex flex-col justify-center">
                <div class="mb-4">
                  <span class="text-teal-600 font-bold text-sm tracking-wide uppercase">{featured.category}</span>
                </div>
                <h2 class="font-extrabold text-navy-950 mb-6 leading-tight">
                  {featured.title}
                </h2>
                <p class="text-slate-600 mb-8 text-lg leading-relaxed line-clamp-4 font-medium">
                  {featured.excerpt}
                </p>
                <div class="flex items-center gap-5 mt-auto border-t border-slate-100 pt-6">
                  <div class="h-10 w-10 rounded-full bg-navy-900 text-white flex items-center justify-center border-2 border-white text-sm font-bold shadow-md">
                    {featured.author.charAt(0)}
                  </div>
                  <div class="text-sm">
                    <p class="font-bold text-navy-950">{featured.author}</p>
                    <p class="text-slate-500 font-medium">{featured.duration} &bull; {formatDate(featured.published_at)}</p>
                  </div>
                  <div class="ml-auto">
                    <span class="video-trigger inline-flex cursor-pointer items-center gap-2 rounded-full bg-navy-950 text-white hover:bg-blue-700 px-6 py-2 text-sm font-semibold shadow-lg transition-all hover:scale-105" data-video-id={featured.youtubeId} data-video-title={featured.title}>
                      Watch Now
                      <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      */}

      <!-- Video Grid (all videos) -->
      <section class="py-20 bg-background relative">
        <div class="container relative z-10">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
            <div>
              <span class="text-teal-600 font-bold tracking-widest uppercase text-xs mb-2 block">Video Library</span>
              <h2 class="font-extrabold text-navy-950 tracking-tight">Latest Videos</h2>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {videos.map((video) => (
              <button
                type="button"
                class="video-trigger group h-full block text-left"
                data-video-id={video.youtubeId}
                data-video-title={video.title}
                aria-label={`Play video: ${video.title}`}
              >
                <article class="h-full bg-white rounded-2xl overflow-hidden shadow-[0_2px_8px_rgba(14,25,53,0.04)] hover:shadow-[0_20px_40px_rgba(14,25,53,0.12)] transition-all duration-300 hover:-translate-y-1 border border-slate-100 flex flex-col">
                  <!-- Thumbnail -->
                  <div class="h-56 bg-navy-950 relative overflow-hidden">
                    <img
                      src={thumb(video.youtubeId)}
                      alt={video.title}
                      loading="lazy"
                      class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
                    />
                    <span class="absolute inset-0 bg-gradient-to-t from-navy-950/60 via-transparent to-transparent"></span>
                    <!-- Play button -->
                    <span class="absolute inset-0 flex items-center justify-center">
                      <span class="flex h-14 w-14 items-center justify-center rounded-full bg-white/90 shadow-xl group-hover:scale-110 group-hover:bg-white transition-all duration-300">
                        <svg class="h-6 w-6 text-blue-700 translate-x-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                      </span>
                    </span>
                    <!-- Duration -->
                    <span class="absolute bottom-3 right-3 rounded-md bg-navy-950/80 px-2 py-0.5 text-[11px] font-bold text-white backdrop-blur-sm">{video.duration}</span>
                    <!-- Category badge -->
                    <div class="absolute top-4 left-4">
                      <span class="bg-white/95 backdrop-blur-md px-3 py-1 rounded-full text-[10px] font-extrabold text-navy-950 shadow-sm border border-slate-100 uppercase tracking-widest">
                        {video.category}
                      </span>
                    </div>
                  </div>

                  <div class="p-7 flex flex-col flex-grow relative">
                    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-blue-200 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                    <h3 class="text-xl font-bold text-navy-950 mb-3 group-hover:text-blue-700 transition-colors leading-snug line-clamp-2">
                      {video.title}
                    </h3>
                    <p class="text-slate-500 text-sm leading-relaxed mb-6 line-clamp-2">
                      {video.excerpt}
                    </p>
                    <div class="mt-auto flex items-center justify-between border-t border-slate-50 pt-5">
                      <div class="flex items-center gap-3">
                        <div class="h-8 w-8 rounded-full bg-slate-100 flex items-center justify-center text-xs font-bold text-navy-800 border border-white shadow-sm">
                          {video.author.charAt(0)}
                        </div>
                        <div class="text-xs text-slate-500 font-medium">
                          <span class="block text-navy-950 font-semibold">{video.author}</span>
                          <span>{formatDate(video.published_at)} &middot; {video.duration}</span>
                        </div>
                      </div>
                      <div class="h-8 w-8 rounded-full bg-slate-50 flex items-center justify-center text-blue-600 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
                        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                      </div>
                    </div>
                  </div>
                </article>
              </button>
            ))}
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>

  <!-- Video Modal (plays in-site) -->
  <div
    id="video-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-navy-950/80 backdrop-blur-sm p-4 opacity-0 transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Video player"
  >
    <div class="relative w-full max-w-4xl">
      <button
        id="video-modal-close"
        type="button"
        class="absolute -top-12 right-0 flex items-center gap-2 text-sm font-semibold text-white/90 hover:text-white transition-colors"
        aria-label="Close video"
      >
        Close
        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
      <div class="aspect-video w-full overflow-hidden rounded-2xl bg-black shadow-2xl ring-1 ring-white/10">
        <iframe
          id="video-modal-iframe"
          class="h-full w-full"
          src=""
          title="YouTube video player"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
      <p id="video-modal-title" class="mt-4 text-center text-base font-semibold text-white"></p>
    </div>
  </div>

  <script is:inline>
    (function () {
      const modal = document.getElementById('video-modal');
      const iframe = document.getElementById('video-modal-iframe');
      const titleEl = document.getElementById('video-modal-title');
      const closeBtn = document.getElementById('video-modal-close');
      if (!modal || !iframe) return;

      function openModal(id, title) {
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
        if (titleEl) titleEl.textContent = title || '';
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        requestAnimationFrame(() => modal.classList.remove('opacity-0'));
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        modal.classList.add('opacity-0');
        document.body.style.overflow = '';
        setTimeout(() => {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          iframe.src = '';
        }, 300);
      }

      document.querySelectorAll('.video-trigger').forEach((el) => {
        el.addEventListener('click', () => {
          openModal(el.getAttribute('data-video-id'), el.getAttribute('data-video-title'));
        });
      });

      closeBtn && closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
      });
    })();
  </script>
</Layout>
