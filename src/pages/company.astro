---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import AboutPage from '@/views/About.astro';
---

<Layout
  title="ioNova AI — About · The Entity Intelligence Platform"
  description="The Entity Intelligence Company. 100+ years combined experience across AI, banking technology, payments, compliance, and enterprise security."
>
  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <AboutPage />
    </main>
    <Footer />
  </div>
</Layout>
