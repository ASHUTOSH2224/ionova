---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import AboutPage from '@/views/About.astro';
---

<Layout
  title="About ioNova AI — The Entity Intelligence Company"
  description="100+ years combined experience in AI, banking, payments, compliance, and security. Building the intelligence layer for global financial infrastructure."
  keywords="ioNova AI, entity intelligence company, AI banking, payment compliance team, fintech leadership, ISO 20022 experts"
  ogImage="/og-image.png"
  ogImageAlt="ioNova AI — The Entity Intelligence Company"
>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "About ioNova AI — The Entity Intelligence Company",
      "description": "100+ years combined experience across AI, banking, payments, compliance, and enterprise security. Building the intelligence layer for global financial infrastructure.",
      "url": "https://ionova.ai/company",
      "dateModified": "2026-02-17",
      "isPartOf": { "@id": "https://ionova.ai/#website" },
      "about": { "@id": "https://ionova.ai/#organization" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ionova.ai" },
          { "@type": "ListItem", "position": 2, "name": "About", "item": "https://ionova.ai/company" }
        ]
      }
    }
  </script>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "@id": "https://ionova.ai/#parth-desai",
      "name": "Parth Desai",
      "url": "https://ionova.ai/company",
      "jobTitle": "Founder and Chairman",
      "description": "Founder and Chairman of ioNova AI. Leads a team with 100+ years of combined experience across AI, banking technology, payments, compliance, and enterprise security.",
      "worksFor": { "@id": "https://ionova.ai/#organization" },
      "knowsAbout": [
        "ISO 20022",
        "Payment Compliance",
        "Entity Intelligence",
        "AI in Financial Services",
        "Banking Technology",
        "SWIFT CBPR+",
        "SEPA Compliance"
      ]
    }
  </script>
  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <AboutPage />
    </main>
    <Footer />
  </div>
</Layout>
