---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import TermsOfService from '@/views/TermsOfService.astro';
---

<Layout
  title="ioNova AI — Terms of Service · Legal Agreement"
  description="Terms and conditions governing your use of the ioNova AI Entity Intelligence Platform. Enterprise agreements available."
>
  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <TermsOfService />
    </main>
    <Footer />
  </div>
</Layout>
