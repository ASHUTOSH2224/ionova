---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import TermsOfService from '@/views/TermsOfService.astro';
---

<Layout
  title="ioNova AI — Terms of Service · Legal Agreement"
  description="Terms and conditions governing your use of the ioNova AI Entity Intelligence Platform. Enterprise agreements available."
  ogImage="/Logo/ionova logo/logo.PNG"
  ogImageAlt="ioNova AI Terms of Service"
  noindex={true}
>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "ioNova AI — Terms of Service",
      "description": "Terms and conditions governing your use of the ioNova AI Entity Intelligence Platform. Enterprise agreements available.",
      "url": "https://ionova.ai/terms-of-service",
      "dateModified": "2026-02-17",
      "isPartOf": { "@type": "WebSite", "url": "https://ionova.ai" }
    }
  </script>
  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <TermsOfService />
    </main>
    <Footer />
  </div>
</Layout>
