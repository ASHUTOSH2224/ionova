---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import { HeroSection } from '@/components/sections/HeroSection';
import { LogosSection } from '@/components/sections/LogosSection';
import { ChallengeSection } from '@/components/sections/ChallengeSection';
import PillarsSection from '@/components/sections/PillarsSection.astro';
import { ExploreSection } from '@/components/sections/ExploreSection';
import { DifferentiationSection } from '@/components/sections/DifferentiationSection';
import ImplementationTimelineSection from '@/components/sections/ImplementationTimelineSection.astro';
import { InsightsSection } from '@/components/sections/InsightsSection';
import { FAQSection } from '@/components/sections/FAQSection';
import { CTABandSection } from '@/components/sections/CTABandSection';
---

<Layout
  title="ioNova | AI-Native ISO 20022 Address Resolution for Payments"
  description="AI-native ISO 20022 address resolution. Convert unstructured payment data into SWIFT CBPR+ and SEPA-compliant structured addresses before Nov 2026."
  keywords="ISO 20022, SWIFT CBPR+, SEPA, address resolution, payment compliance, structured addresses, November 2026 deadline, AI payments, fintech"
  ogImage="/og-image.png"
  ogImageAlt="ioNova | AI-Native ISO 20022 Address Resolution for Payments"
>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": "https://ionova.ai/#webpage",
      "name": "ioNova | AI-Native ISO 20022 Address Resolution for Payments",
      "description": "Make payments ISO 20022 ready with AI-native address resolution. Convert unstructured data into SWIFT CBPR+ and SEPA compliant structured addresses before the November 2026 deadline.",
      "url": "https://ionova.ai",
      "dateModified": "2026-02-17",
      "isPartOf": { "@id": "https://ionova.ai/#website" },
      "about": { "@type": "Thing", "name": "ISO 20022 Address Intelligence" },
      "provider": { "@id": "https://ionova.ai/#organization" }
    }
  </script>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is address intelligence and how is it different from address validation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Address intelligence parses, validates, enriches, and structures postal address data to meet ISO 20022 compliance. Unlike postal validation — which confirms a physical location exists — address intelligence resolves against regulatory standards, sanctions screening precision, and payment routing across 246 countries simultaneously."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between structured and hybrid addresses in ISO 20022?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Structured addresses populate dedicated XML elements (StrtNm, BldgNb, TwnNm, PstCd, Ctry) with validated components. Hybrid combines some structured with free-text. Regulators mandate structured as the target — hybrid is the minimum fallback. Delivering structured automatically satisfies hybrid with identical effort."
          }
        },
        {
          "@type": "Question",
          "name": "Why can't postal APIs or LLMs handle payment compliance?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Postal APIs lack ISO 20022 XML output, can't handle financial identifiers, and cover primarily Latin-script markets. LLMs fail due to non-deterministic output, hallucination risk, latency exceeding sub-50ms P95 requirements, and no regulatory audit trail."
          }
        },
        {
          "@type": "Question",
          "name": "How long does implementation take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Address intelligence deploys in 2–4 weeks via sidecar architecture alongside existing infrastructure. No core banking system replacement required. Pre-built connectors for MuleSoft, Volante, and Finastra."
          }
        },
        {
          "@type": "Question",
          "name": "What ROI can institutions expect?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Institutions processing 500,000+ cross-border payments annually typically achieve 30–50x ROI within 12 months. The Entity Intelligence Platform delivers 366%+ three-year ROI."
          }
        },
        {
          "@type": "Question",
          "name": "What is the SWIFT ISO 20022 deadline for structured addresses?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Enforcement begins November 2026. MT was refused for new messages in November 2025. February 2026 marks the start of the 9-month critical implementation window. The E&I Mandate in November 2027 tightens further."
          }
        }
      ]
    }
  </script>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How to Implement ISO 20022 Structured Address Resolution with ioNova",
      "description": "Deploy ISO 20022-compliant address resolution in 2-4 weeks with zero legacy system overhaul.",
      "totalTime": "P16W",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Phase 1: Analysis & Configuration (Week 1)",
          "text": "Connect to existing infrastructure. Analyse address data quality. Configure parsing rules and confidence thresholds."
        },
        {
          "@type": "HowToStep",
          "name": "Phase 2: Integration & Testing (Weeks 2–3)",
          "text": "Pre-built connectors for MuleSoft, Volante, Finastra. SWIFT integration via Alliance Lite2 and Alliance Access."
        },
        {
          "@type": "HowToStep",
          "name": "Phase 3: Production Deployment (Week 4)",
          "text": "Circuit-breaker protection. 85-90% initial structuring, rising to 95%+ in the first quarter. Zero downtime risk."
        }
      ]
    }
  </script>
	<div class="flex min-h-screen flex-col">
		<Navbar client:idle />
		<main class="flex-1">
			<!-- Canonical definition paragraph — server-rendered for LLM/AI crawler extraction; visually hidden since HeroSection renders styled content -->
			<p class="sr-only">ioNova AI is an enterprise platform that converts unstructured payment address data into ISO 20022-compliant structured formats using AI-native address resolution. It serves banks, payment processors, and financial institutions preparing for the November 2026 SWIFT CBPR+ and SEPA structured address mandate, achieving 98% straight-through processing rates across 246 countries. The platform deploys in 2–4 weeks via sidecar architecture with no legacy system replacement required.</p>
			<HeroSection client:visible />
			<LogosSection client:idle />
			<ChallengeSection client:visible />
			<PillarsSection />
			<ExploreSection client:visible />
			<DifferentiationSection client:visible />
			<ImplementationTimelineSection />
			<InsightsSection client:visible />
			<FAQSection client:visible />
			<CTABandSection client:visible />
		</main>
		<Footer />
	</div>
</Layout>
