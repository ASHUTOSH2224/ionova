---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import EntityGovernance from '@/views/EntityGovernance.astro';
---

<Layout
  title="Governance-by-Design - ioNova"
  description="SR 11-7 and EU AI Act compliant. Audit-grade evidence packs, decision replayability, and continuous drift monitoring."
>
  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <div class="ds-v5">
        <div class="container">
          <EntityGovernance />
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
