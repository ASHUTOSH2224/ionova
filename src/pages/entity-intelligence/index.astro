---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import EntityPlatform from '@/views/EntityPlatform.astro';
---

<Layout
  title="Entity Intelligence Platform - ioNova"
  description="Resolve entities across 50+ systems. 95%+ precision. <200ms latency. The only platform with evidence-first AI and progressive autonomy."
>
  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <div class="ds-v5">
        <div class="container">
          <EntityPlatform />
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
