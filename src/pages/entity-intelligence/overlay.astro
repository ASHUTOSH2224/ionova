---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import EntityOverlay from '@/views/EntityOverlay.astro';
---

<Layout
  title="Overlay-First Deployment - ioNova"
  description="Deploy entity intelligence in 90 days. Read-only pilot, no rip-and-replace, no data migration required."
>
  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <div class="ds-v5">
        <div class="container">
          <EntityOverlay />
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
