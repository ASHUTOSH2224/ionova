---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import EntityCascade from '@/views/EntityCascade.astro';
---

<Layout
  title="Cascade Entity Resolution — 90% Cost Reduction | ioNova AI"
  description="Reduce entity resolution costs by 90% with multi-stage cascade: exact match, fuzzy match, semantic matching, and LLM escalation only when needed."
  keywords="cascade entity resolution, multi-stage matching, entity resolution cost reduction, fuzzy matching, semantic entity matching, LLM escalation"
  ogImage="/og-image.png"
  ogImageAlt="ioNova Cascade Entity Resolution"
>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Cascade Entity Resolution — 90% Cost Reduction",
      "description": "Reduce entity resolution costs by 90% with ioNova's multi-stage cascade: exact match, fuzzy match, semantic matching, and LLM escalation only when needed.",
      "url": "https://ionova.ai/entity-intelligence/cascade",
      "dateModified": "2026-02-17",
      "isPartOf": { "@id": "https://ionova.ai/#website" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ionova.ai" },
          { "@type": "ListItem", "position": 2, "name": "Entity Intelligence", "item": "https://ionova.ai/entity-intelligence" },
          { "@type": "ListItem", "position": 3, "name": "Cascade Resolution", "item": "https://ionova.ai/entity-intelligence/cascade" }
        ]
      }
    }
  </script>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Cascade Entity Resolution — Multi-Stage Matching with 90% Cost Reduction",
      "description": "ioNova's multi-stage cascade entity resolution reduces resolution costs by 90% by routing through deterministic exact match, fuzzy match, and semantic matching stages before escalating to LLMs only when required. Achieves 95%+ precision at sub-200ms latency.",
      "url": "https://ionova.ai/entity-intelligence/cascade",
      "provider": {
        "@type": "Organization",
        "name": "ioNova AI",
        "url": "https://ionova.ai"
      },
      "serviceType": "Entity Resolution & Multi-Stage Matching",
      "areaServed": "Worldwide",
      "audience": {
        "@type": "Audience",
        "audienceType": "Financial Institutions, Banks, Data Engineering Teams, KYC / AML Teams"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Cascade Resolution Stages",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Stage 1 — Exact Match (Deterministic, Zero Cost)" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Stage 2 — Fuzzy Match (High Recall, Low Cost)" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Stage 3 — Semantic Matching (Embedding-Based)" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Stage 4 — LLM Escalation (Exception-Only, Minimised Cost)" } }
        ]
      }
    }
  </script>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "headline": "Cascade Entity Resolution — 90% Cost Reduction",
      "description": "Reduce entity resolution costs by 90% with multi-stage cascade: exact match, fuzzy match, semantic matching, and LLM escalation only when needed.",
      "url": "https://ionova.ai/entity-intelligence/cascade",
      "mainEntityOfPage": "https://ionova.ai/entity-intelligence/cascade",
      "dateModified": "2026-02-17",
      "author": { "@id": "https://ionova.ai/#organization" },
      "publisher": { "@id": "https://ionova.ai/#organization" },
      "isPartOf": { "@id": "https://ionova.ai/#website" },
      "about": { "@id": "https://ionova.ai/#entity-intelligence-product" }
    }
  </script>
  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <div class="ds-v5">
        <div class="container">
          <EntityCascade />
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
