---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import DemoForm from '@/components/DemoForm';
---

<Layout
  title="Request a Demo — ioNova ISO 20022 Address Intelligence"
  description="See ioNova's AI-native address resolution in action. Schedule a live demo and learn how to achieve 98% STP rates for payments in 2–4 weeks."
  keywords="ioNova demo, ISO 20022 demo, address intelligence demo, SWIFT CBPR+ compliance demo, payment STP rates"
  ogImage="/og-image.png"
  ogImageAlt="ioNova — Request a Demo"
>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Request a Demo — ioNova ISO 20022 Address Intelligence",
      "description": "See ioNova's AI-native address resolution in action. Schedule a live demo and learn how to achieve 98% STP rates for cross-border payments in 2–4 weeks.",
      "url": "https://ionova.ai/demo",
      "dateModified": "2026-02-17",
      "isPartOf": { "@id": "https://ionova.ai/#website" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ionova.ai" },
          { "@type": "ListItem", "position": 2, "name": "Request a Demo", "item": "https://ionova.ai/demo" }
        ]
      }
    }
  </script>

  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <section class="bg-surface-2" style="padding-top: 8rem; padding-bottom: var(--section-padding-y);">
        <div class="container">
          <div class="mx-auto max-w-5xl">
            <div class="grid gap-10 lg:grid-cols-2">

              <!-- Left - Static content (server-rendered, fully crawler-visible) -->
              <div>
                <h1 class="mb-4 font-bold text-navy-950">
                  See ioNova in Action.
                </h1>
                <p class="mb-8 text-lg text-text-muted">
                  We can deploy a production-ready address resolution engine in as little as 2–4 weeks.
                </p>

                <!-- Trust signals -->
                <div class="mb-8 space-y-4">
                  <div class="flex items-center gap-3">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-500/10">
                      <svg class="h-5 w-5 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                    </div>
                    <div>
                      <p class="font-semibold text-navy-950">ISO 27001 Certified</p>
                      <p class="text-sm text-text-muted">Bank-grade security standards</p>
                    </div>
                  </div>

                  <div class="flex items-center gap-3">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-teal-500/10">
                      <svg class="h-5 w-5 text-teal-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </div>
                    <div>
                      <p class="font-semibold text-navy-950">SOC 2 Type II Compliant</p>
                      <p class="text-sm text-text-muted">Enterprise-ready compliance</p>
                    </div>
                  </div>

                  <div class="flex items-center gap-3">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-cyan-400/10">
                      <svg class="h-5 w-5 text-cyan-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                    </div>
                    <div>
                      <p class="font-semibold text-navy-950">2&#8211;4 Week Implementation</p>
                      <p class="text-sm text-text-muted">Faster than in-house solutions</p>
                    </div>
                  </div>
                </div>

                <!-- What to expect -->
                <div class="rounded-[6px] border border-border bg-card p-6">
                  <h3 class="mb-4 font-semibold text-navy-950">What to expect:</h3>
                  <ul class="space-y-2 text-sm text-text-muted">
                    <li class="flex items-start gap-2">
                      <svg class="mt-0.5 h-4 w-4 shrink-0 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                      <span>30-minute personalized demo of the platform</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <svg class="mt-0.5 h-4 w-4 shrink-0 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                      <span>Custom ROI analysis for your organization</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <svg class="mt-0.5 h-4 w-4 shrink-0 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                      <span>Technical deep-dive with our engineering team</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <svg class="mt-0.5 h-4 w-4 shrink-0 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                      <span>Implementation timeline and pricing discussion</span>
                    </li>
                  </ul>
                </div>
              </div>

              <!-- Right - Interactive form (React island, hydrated on load) -->
              <DemoForm client:load />

            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Layout>
