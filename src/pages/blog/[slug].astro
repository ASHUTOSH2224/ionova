---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import { ghostAPI } from '@/lib/ghost';

export async function getStaticPaths() {
  const ghostPosts = await ghostAPI.getPosts({ limit: 'all' });

  // Fail the build if Ghost is configured but returned 0 posts — prevents silently
  // deploying a site with no blog routes when the CMS was unreachable at build time.
  const ghostUrl = import.meta.env.VITE_GHOST_API_URL || import.meta.env.PUBLIC_GHOST_API_URL;
  if (ghostUrl && ghostPosts.length === 0) {
    throw new Error(
      '[Build] Ghost returned 0 posts. Ensure Ghost is reachable at build time, ' +
      'or unset VITE_GHOST_API_URL / PUBLIC_GHOST_API_URL to skip blog generation.'
    );
  }

  return ghostPosts.map(gp => ({
    params: { slug: gp.slug },
    props: {
      post: {
        title: gp.title,
        slug: gp.slug,
        excerpt: gp.excerpt || '',
        html: gp.html || '',
        author: gp.authors?.[0]?.name || 'ioNova Team',
        date: gp.published_at
          ? new Date(gp.published_at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
          : '',
        isoDate: gp.published_at || '',
        // Map updated_at separately for dateModified — differs from published_at on edits
        isoDateModified: gp.updated_at || gp.published_at || '',
        readTime: `${gp.reading_time || 5} min read`,
        category: gp.tags?.[0]?.name || 'Insights',
        // All tag names joined for keywords meta
        tags: gp.tags?.map((t: any) => t.name).join(', ') || '',
        image: gp.feature_image || undefined,
        codeinjection_head: gp.codeinjection_head || '',
      },
      source: 'ghost',
    },
  }));
}

const { slug } = Astro.params;
const { post } = Astro.props;
const isoDate = post?.isoDate || '';
const isoDateModified = post?.isoDateModified || isoDate;

// Strip JSON-LD scripts from Ghost codeinjection_head to prevent duplicate/conflicting schemas.
// Ghost dashboard-authored BlogPosting schemas often reference stale slugs/dates; our authoritative
// BlogPosting below is the canonical schema Google should consume.
const safeInjection = post?.codeinjection_head
  ? post.codeinjection_head.replace(/<script\b[^>]*type=["']application\/ld\+json["'][^>]*>[\s\S]*?<\/script>/gi, '')
  : '';

// Ensure description is 50–160 chars for Bing/Google SEO compliance
const rawExcerpt = post?.excerpt || '';
const fallbackDesc = `Read "${post?.title || 'this article'}" on the ioNova AI blog — expert insights on ISO 20022 and payment compliance.`;
const longDesc = rawExcerpt.length >= 50 ? rawExcerpt : fallbackDesc;
const description = longDesc.length > 160 ? longDesc.slice(0, 157) + '...' : longDesc;

// Truncate title to stay under 60 chars (Bing's limit) including " | ioNova AI" suffix
const suffix = ' | ioNova AI';
const rawTitle = post?.title || 'Blog';
const pageTitle = (rawTitle + suffix).length > 60
  ? rawTitle.slice(0, 60 - suffix.length - 3) + '...' + suffix
  : rawTitle + suffix;

// Build per-post keywords from Ghost tags, falling back to category
const postKeywords = post?.tags
  ? `${post.tags}, ISO 20022, payment compliance, fintech`
  : `${post?.category || 'Insights'}, ISO 20022, payment compliance, fintech`;
---

<Layout
  title={pageTitle}
  description={description}
  keywords={postKeywords}
  ogImage={post?.image || '/og-image.png'}
  ogImageAlt={post?.title || 'ioNova Blog Post'}
  ogType="article"
>
  <!-- Article Open Graph meta -->
  {isoDate && <meta property="article:published_time" content={isoDate} slot="head" />}
  {isoDateModified && <meta property="article:modified_time" content={isoDateModified} slot="head" />}
  <meta property="article:author" content={post?.author || 'ioNova Team'} slot="head" />
  <meta property="article:section" content={post?.category || 'Insights'} slot="head" />
  <!-- Ghost Code Injection: non-schema scripts/meta from Ghost dashboard (JSON-LD stripped to prevent conflicts) -->
  {safeInjection && <Fragment set:html={safeInjection} slot="head" />}

  <!-- BlogPosting JSON-LD — primary schema for Google Rich Results and AI/LLM crawlers -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post?.title || '',
    "description": description,
    "url": `https://ionova.ai/blog/${slug}`,
    ...(isoDate ? { "datePublished": isoDate } : {}),
    ...(isoDateModified ? { "dateModified": isoDateModified } : {}),
    "author": post?.author === 'Parth Desai'
      ? { "@type": "Person", "@id": "https://ionova.ai/#parth-desai", "name": "Parth Desai" }
      : { "@type": "Person", "name": post?.author || 'ioNova Team', "worksFor": { "@id": "https://ionova.ai/#organization" } },
    "publisher": { "@id": "https://ionova.ai/#organization" },
    "image": post?.image
      ? { "@type": "ImageObject", "url": post.image }
      : { "@type": "ImageObject", "url": "https://ionova.ai/og-image.png" },
    "mainEntityOfPage": { "@type": "WebPage", "@id": `https://ionova.ai/blog/${slug}` },
    "isPartOf": { "@id": "https://ionova.ai/#website" },
    "about": { "@type": "Thing", "name": "ISO 20022 Address Intelligence & Payment Compliance" },
    "keywords": postKeywords,
    "inLanguage": "en-US",
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ionova.ai" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://ionova.ai/blogs" },
        { "@type": "ListItem", "position": 3, "name": post?.title || 'Article', "item": `https://ionova.ai/blog/${slug}` }
      ]
    }
  })} slot="head"></script>

  <!-- SSR-rendered blog post — full content in HTML, no React hydration needed -->
  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="flex-1">
      <!-- Back to Blogs + Title -->
      <section class="bg-background pt-28 pb-4 lg:pt-36">
        <div class="container">
          <div class="mx-auto max-w-4xl">
            <a href="/blogs" class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-navy-950 transition-colors border border-slate-200 rounded-md px-3 py-1.5 group">
              <svg class="h-4 w-4 transition-transform group-hover:-translate-x-1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6" /></svg>
              Back to Blogs
            </a>
            <h1 class="mt-6 font-bold tracking-tight text-navy-950">{post?.title}</h1>
          </div>
        </div>
      </section>

      <!-- Post Meta -->
      <section class="bg-background pb-4">
        <div class="container">
          <div class="mx-auto max-w-4xl flex flex-wrap items-center gap-4 text-sm text-slate-500">
            {post?.category && (
              <span class="bg-blue-50 text-blue-700 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide">{post.category}</span>
            )}
            {post?.author && <span>{post.author}</span>}
            {post?.date && <span>{post.date}</span>}
            {post?.readTime && <span>{post.readTime}</span>}
          </div>
        </div>
      </section>

      <!-- Featured Image -->
      {post?.image && (
        <section class="bg-background pt-4 pb-8">
          <div class="container">
            <div class="mx-auto max-w-4xl">
              <img
                src={post.image}
                alt={post.title}
                width="896"
                height="504"
                loading="lazy"
                class="w-full rounded-2xl shadow-xl"
              />
            </div>
          </div>
        </section>
      )}

      <!-- Content rendered server-side — visible to crawlers immediately -->
      <section class="bg-background py-16 lg:py-24">
        <div class="container">
          <article class="prose prose-lg prose-blue mx-auto max-w-4xl">
            <div class="ghost-content" set:html={post?.html || `<p>${post?.excerpt || ''}</p>`} />
          </article>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Layout>
