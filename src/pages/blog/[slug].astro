---
import Layout from '@/layouts/Layout.astro';
import BlogPostView from '@/views/BlogPost';
import { ghostAPI } from '@/lib/ghost';

export async function getStaticPaths() {
  // Ghost posts
  let ghostPaths: any[] = [];
  try {
    const ghostPosts = await ghostAPI.getPosts({ limit: 'all' });

    ghostPaths = ghostPosts
      .map(gp => ({
        params: { slug: gp.slug },
        props: {
          post: {
            title: gp.title,
            slug: gp.slug,
            excerpt: gp.excerpt || '',
            html: gp.html || '',
            author: gp.authors?.[0]?.name || 'ioNova Team',
            date: gp.published_at
              ? new Date(gp.published_at).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
              : '',
            readTime: `${gp.reading_time || 5} min read`,
            category: gp.tags?.[0]?.name || 'Insights',
            image: gp.feature_image || undefined,
          },
          source: 'ghost',
        },
      }));
  } catch (error) {
    console.error('Error fetching Ghost posts for static paths:', error);
  }

  return ghostPaths;
}

const { slug } = Astro.params;
const { post } = Astro.props;
---

<Layout
  title={`${post?.title || 'Blog'} - ioNova`}
  description={post?.excerpt || `Read ${post?.title || 'this article'} on the ioNova AI blog.`}
  ogImage={post?.image || '/Logo/hero Image/hero.png'}
  ogImageAlt={post?.title || 'ioNova Blog Post'}
>
	<BlogPostView client:idle post={post} />
</Layout>
