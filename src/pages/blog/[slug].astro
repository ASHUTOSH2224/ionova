---
import Layout from '@/layouts/Layout.astro';
import BlogPostView from '@/views/BlogPost';
import { featuredPosts, allPosts } from "@/data/blogPosts";
import { ghostAPI } from '@/lib/ghost';

export async function getStaticPaths() {
  // Static posts
  const staticPosts = [...featuredPosts, ...allPosts];
  const staticPaths = staticPosts.map(post => ({
    params: { slug: post.slug },
    props: { post, source: 'static' },
  }));

  // Ghost posts
  let ghostPaths: any[] = [];
  try {
    const ghostPosts = await ghostAPI.getPosts({ limit: 'all' });
    const staticSlugs = new Set(staticPosts.map(p => p.slug));

    ghostPaths = ghostPosts
      .filter(gp => !staticSlugs.has(gp.slug))
      .map(gp => ({
        params: { slug: gp.slug },
        props: {
          post: {
            title: gp.title,
            slug: gp.slug,
            excerpt: gp.excerpt || '',
            html: gp.html || '',
            author: gp.authors?.[0]?.name || 'ioNova Team',
            date: gp.published_at
              ? new Date(gp.published_at).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
              : '',
            readTime: `${gp.reading_time || 5} min read`,
            category: gp.tags?.[0]?.name || 'Insights',
            image: gp.feature_image || undefined,
          },
          source: 'ghost',
        },
      }));
  } catch (error) {
    console.error('Error fetching Ghost posts for static paths:', error);
  }

  return [...staticPaths, ...ghostPaths];
}

const { slug } = Astro.params;
const { post } = Astro.props;
---

<Layout title={`${post?.title || 'Blog'} - ioNova`}>
	<BlogPostView client:only="react" post={post} />
</Layout>
