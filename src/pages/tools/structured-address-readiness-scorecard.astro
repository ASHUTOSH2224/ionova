  border-radius:var(--radius-lg); padding:22px 24px;
}
.smallprint{font-size:12.5px; color:var(--text-muted); line-height:1.6}
hr.rule{border:none; border-top:1px solid var(--border); margin:var(--space-xl) 0}
.mt{margin-top:var(--space-xl)} .mt-sm{margin-top:var(--space-md)} .mb{margin-bottom:var(--space-lg)}
