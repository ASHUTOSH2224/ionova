/* ================= PDF ================= */
const PDF = {
  M: 16, W: 210, H: 297,
  NAVY:[14,25,53], BLUE:[60,117,181], TEAL:[67,173,193], MUTED:[87,106,134],
  BORDER:[208,218,235], LIGHT:[240,244,249], WHITE:[255,255,255]
};

function buildPDF(){
  if (!(window.jspdf && window.jspdf.jsPDF)){
    toast('PDF library unavailable — using the browser print dialog');
    window.print(); return;
  }
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ unit:'mm', format:'a4' });
  const { M, W, H } = PDF;
  const RIGHT = W - M;
  let y = 0, page = 0;

  const setC = (c, fill) => fill ? doc.setFillColor(c[0],c[1],c[2]) : doc.setTextColor(c[0],c[1],c[2]);
  const font = (w, s) => { doc.setFont('helvetica', w); doc.setFontSize(s); };

  function header(){
    page++;
    // logo — right-hand top corner
    const lw = 34, lh = lw * (134/520);
    try { doc.addImage(LOGO_WORDMARK, 'PNG', RIGHT - lw, 12, lw, lh); } catch(e){}
    font('bold', 7.4); setC(PDF.TEAL);
    doc.text('ISO 20022 STRUCTURED-ADDRESS READINESS', M, 16);
    font('bold', 15); setC(PDF.NAVY);
    doc.text('Readiness Scorecard — Result', M, 23.5);
    doc.setDrawColor(...PDF.BORDER); doc.setLineWidth(0.3);
    doc.line(M, 27.5, RIGHT, 27.5);
    y = 36;
  }
  function footer(){
    doc.setDrawColor(...PDF.BORDER); doc.setLineWidth(0.3);
    doc.line(M, H-14, RIGHT, H-14);
    font('normal', 7.6); setC(PDF.MUTED);
    doc.text('ioNova · ISO 20022 Structured-Address Readiness Scorecard · ' + todayStr(), M, H-9.5);
    doc.text('Page ' + page, RIGHT, H-9.5, { align:'right' });
  }
  function newPage(){ footer(); doc.addPage(); header(); }
  function need(h){ if (y + h > H - 20) newPage(); }
  function h2(txt){
    need(14); font('bold', 12); setC(PDF.NAVY);
    doc.text(txt, M, y); y += 2.5;
    doc.setDrawColor(...PDF.BORDER); doc.line(M, y, RIGHT, y); y += 6;
  }
  function para(txt, size = 9, color = PDF.MUTED, lead = 4.3){
    font('normal', size); setC(color);
    const lines = doc.splitTextToSize(txt, RIGHT - M);
    lines.forEach(l => { need(lead + 1); doc.text(l, M, y); y += lead; });
  }

  header();

  /* ---- respondent block ---- */
  const d = state.details;
  const rows = [
    ['Institution', d.org || '—'],
    ['Completed by', d.name || '—'],
    ['Email', d.email || '—'],
    ['Date completed', todayStr()]
  ];
  setC(PDF.LIGHT, true); doc.roundedRect(M, y, RIGHT-M, rows.length*6.4 + 5, 2, 2, 'F');
  let ry = y + 6.6;
  rows.forEach(([k,v])=>{
    font('bold', 8.2); setC(PDF.NAVY); doc.text(k, M + 4, ry);
    font('normal', 8.2); setC(PDF.MUTED);
    doc.text(doc.splitTextToSize(String(v), RIGHT - M - 48)[0] || '—', M + 42, ry);
    ry += 6.4;
  });
  y += rows.length*6.4 + 11;

  /* ---- score hero ---- */
  const t = total(), b = bandFor(t), adj = adjustedBand(), flags = flagged();
  const HH = 40;
  setC(PDF.NAVY, true); doc.roundedRect(M, y, RIGHT-M, HH, 3, 3, 'F');
  // score
  font('bold', 30); setC(PDF.WHITE);
  doc.text(String(t), M + 14, y + 24, { align:'center' });
  font('normal', 8); doc.setTextColor(180,196,222);
  doc.text('of ' + MAX, M + 14, y + 31, { align:'center' });
  // divider
  doc.setDrawColor(60,80,120); doc.setLineWidth(0.4);
  doc.line(M + 28, y + 7, M + 28, y + HH - 7);
  // band
  const brgb = BAND_RGB[b.level];
  setC(brgb, true); doc.roundedRect(M + 35, y + 8, 17, 8, 1.6, 1.6, 'F');
  font('bold', 10); setC(PDF.WHITE); doc.text(b.level, M + 43.5, y + 13.9, { align:'center' });
  font('normal', 7.6); doc.setTextColor(180,196,222);
  doc.text(b.range, M + 55, y + 13.9);
  font('bold', 12); setC(PDF.WHITE);
  doc.text(b.title, M + 35, y + 23);
  font('normal', 7.8); doc.setTextColor(198,210,230);
  doc.splitTextToSize(b.means, RIGHT - M - 40).slice(0,3).forEach((l,i)=> doc.text(l, M + 35, y + 28.6 + i*3.9));
  y += HH + 9;

  /* ---- override adjustment ---- */
  if (adj.adjusted){
    const txt = `Read this as ${adj.adjusted.level}, not ${b.level}. You answered yes to ${overrideCount()} of the three override questions — each describes a condition that produces rejected payments regardless of the total, so this score understates your risk.`;
    font('normal', 8.4);
    const lines = doc.splitTextToSize(txt, RIGHT - M - 10);
    const bh = lines.length*4.3 + 7;
    need(bh + 4);
    doc.setFillColor(255,251,235); doc.setDrawColor(253,230,138); doc.setLineWidth(0.4);
    doc.roundedRect(M, y, RIGHT-M, bh, 2, 2, 'FD');
    setC([146,64,14]);
    lines.forEach((l,i)=> doc.text(l, M + 5, y + 6 + i*4.3));
    y += bh + 8;
  }

  /* ---- dimension bars ---- */
  h2('Where you scored');
  DIMS.forEach(dim=>{
    const s = dimScore(dim.n), f = s <= 3;
    need(9);
    font('normal', 9); setC(PDF.NAVY);
    doc.text(`${dim.n}. ${dim.name}`, M, y + 3);
    const bx = M + 62, bw = RIGHT - bx - 16;
    doc.setFillColor(226,232,240); doc.roundedRect(bx, y, bw, 4.2, 2.1, 2.1, 'F');
    const col = f ? [245,158,11] : (s >= 7 ? [16,185,129] : PDF.BLUE);
    if (s > 0){ setC(col, true); doc.roundedRect(bx, y, Math.max(2.2, bw*(s/9)), 4.2, 2.1, 2.1, 'F'); }
    font('bold', 8.6); setC(f ? [146,64,14] : PDF.NAVY);
    doc.text(`${s}/9${f ? '  flag' : ''}`, RIGHT, y + 3.4, { align:'right' });
    y += 9;
  });
  y += 3;

  /* ---- red flags ---- */
  const flagTxt = flags.length
    ? `${flags.length} red ${flags.length===1?'flag':'flags'}: ${flags.map(f=>f.name).join(', ')}. Any dimension scoring 3 or less is a finding in its own right, however healthy the total looks — a single weak dimension is how an estate that averages well still fails on 14 November 2026.`
    : 'No dimension scored 3 or below. Exposure is spread rather than concentrated in one capability gap, which usually means sequencing matters more than triage.';
  font('normal', 8.4);
  const fl = doc.splitTextToSize(flagTxt, RIGHT - M - 10);
  need(fl.length*4.3 + 11);
  if (flags.length){ doc.setFillColor(255,251,235); doc.setDrawColor(253,230,138); }
  else { doc.setFillColor(236,253,245); doc.setDrawColor(167,243,208); }
  doc.setLineWidth(0.4);
  doc.roundedRect(M, y, RIGHT-M, fl.length*4.3 + 7, 2, 2, 'FD');
  setC(flags.length ? [146,64,14] : [6,95,70]);
  fl.forEach((l,i)=> doc.text(l, M + 5, y + 6 + i*4.3));
  y += fl.length*4.3 + 12;

  /* ---- first move ---- */
  h2('Your first move');
  para(b.move, 9.4, PDF.NAVY, 4.6);
  y += 5;

  /* ---- overrides ---- */
  h2('Override questions');
  OVERRIDES.forEach((o,i)=>{
    const v = state.overrides[i];
    const lines = doc.splitTextToSize(o, RIGHT - M - 20);
    need(lines.length*4.3 + 4);
    font('bold', 8.4);
    setC(v === true ? [153,27,27] : [6,95,70]);
    doc.text(v === true ? 'YES' : 'NO', M, y);
    font('normal', 8.4); setC(PDF.MUTED);
    lines.forEach((l,k)=> doc.text(l, M + 14, y + k*4.3));
    y += lines.length*4.3 + 3.4;
  });
  y += 4;

  /* ---- answer detail ---- */
  h2('Your answers');
  DIMS.forEach(dim=>{
    need(12);
    font('bold', 9); setC(PDF.BLUE);
    doc.text(`${dim.n}. ${dim.name}`, M, y);
    font('bold', 8.6); setC(PDF.NAVY);
    doc.text(`${dimScore(dim.n)}/9`, RIGHT, y, { align:'right' });
    y += 5;
    dim.questions.forEach((item,i)=>{
      const key = `${dim.n}.${i+1}`;
      const v = state.answers[key];
      const chosen = v === undefined ? 'Not answered' : item.opts[v];
      const qlines = doc.splitTextToSize(item.q, RIGHT - M - 24);
      const alines = doc.splitTextToSize(chosen, RIGHT - M - 24);
      need((qlines.length + alines.length)*3.9 + 6);
      font('bold', 7.6); setC(PDF.MUTED); doc.text(key, M, y);
      font('normal', 7.8); setC(PDF.NAVY);
      qlines.forEach((l,k)=> doc.text(l, M + 10, y + k*3.9));
      let yy = y + qlines.length*3.9;
      font('bold', 7.8); setC(v === undefined ? [153,27,27] : PDF.BLUE);
      doc.text(String(v === undefined ? '–' : v), M + 10, yy + 0.6);
      font('normal', 7.8); setC(PDF.MUTED);
      alines.forEach((l,k)=> doc.text(l, M + 16, yy + 0.6 + k*3.9));
      y = yy + alines.length*3.9 + 4.4;
    });
    y += 2;
  });

  /* ---- worksheet ---- */
  const filled = state.sheet.filter(r => Object.values(r).some(v => String(v).trim()));
  if (filled.length){
    h2('Concentration worksheet');
    const cols = [
      { k:'flow',   t:'Flow / corridor', w:52 },
      { k:'scheme', t:'Scheme',          w:28 },
      { k:'fmt',    t:'Format',          w:30 },
      { k:'vol',    t:'Monthly volume',  w:34 },
      { k:'pct',    t:'% unstructured',  w:34 }
    ];
    need(10);
    setC(PDF.NAVY, true); doc.rect(M, y - 4, RIGHT-M, 7, 'F');
    font('bold', 7.6); setC(PDF.WHITE);
    let cx = M + 2; cols.forEach(c=>{ doc.text(c.t, cx, y + 0.6); cx += c.w; });
    y += 6;
    filled.forEach((r,ri)=>{
      need(8);
      if (ri % 2){ doc.setFillColor(244,247,251); doc.rect(M, y - 3.6, RIGHT-M, 6.6, 'F'); }
      font('normal', 8); setC(PDF.NAVY);
      let x2 = M + 2;
      cols.forEach(c=>{
        const txt = doc.splitTextToSize(String(r[c.k] || '—'), c.w - 3)[0] || '—';
        doc.text(txt, x2, y + 0.6); x2 += c.w;
      });
      y += 6.6;
    });
    y += 4;
    para('The row with the highest volume x highest unstructured share is your first sprint — the steepest compliance uplift per hour of integration work.', 8.4, PDF.NAVY, 4.3);
    y += 4;
  }

  /* ---- next steps ---- */
  h2('Turning this into a plan');
  para('The work is not one monolithic programme. It separates into independent use cases, each deployable on a 2-4 week arc: start in two days, run your integration and engine tuning as two parallel tracks, validate in production in week three, go live in weeks three to four. Three or four sprints still fit before the standards take effect — if the first one starts now.', 9, PDF.NAVY, 4.4);
  y += 4;
  need(30);
  doc.setFillColor(246,250,253); doc.setDrawColor(...PDF.BORDER); doc.setLineWidth(0.4);
  const ctaLines = doc.splitTextToSize('A 10,000-message sample of your own outbound traffic through the production ARS engine on EU-resident infrastructure, a 90-minute working session, and your scored report across these same six dimensions within five working days — decomposed into the concentration table that picks your first sprint. Normally $5,000; complimentary for qualifying institutions booked before 31 August.', RIGHT - M - 10);
  const ch = ctaLines.length*4.2 + 15;
  doc.roundedRect(M, y, RIGHT-M, ch, 2, 2, 'FD');
  setC(PDF.TEAL, true); doc.rect(M, y, 1.2, ch, 'F');
  font('bold', 9.4); setC(PDF.NAVY);
  doc.text('This scorecard measures what you believe. The STP Readiness Report measures your traffic.', M + 5, y + 7);
  font('normal', 8.4); setC(PDF.MUTED);
  ctaLines.forEach((l,i)=> doc.text(l, M + 5, y + 13 + i*4.2));
  y += ch + 8;

  para('This is a self-assessment instrument, not an attestation, a certification, or legal or regulatory advice. It reflects the structured-address requirements under SWIFT CBPR+ and the EPC SEPA rulebook as they stand at the date of publication; confirm the requirements applicable to your own schemes, flows and jurisdictions with your compliance function.', 7.4, PDF.MUTED, 3.6);

  footer();
  const org = (d.org || 'ioNova').replace(/[^A-Za-z0-9]+/g,'-').replace(/^-|-$/g,'');
  doc.save(`ISO20022-Readiness-Scorecard-${org}.pdf`);
  return doc;
}

/* ================= LEAD CAPTURE ================= */
function requestPDF(){
  if (state.leadDone){ buildPDF(); return; }
  openLead();
}
function openLead(){
  const m = $('leadModal');
  m.classList.add('show'); m.setAttribute('aria-hidden','false');
  setTimeout(()=>$('l-name').focus(), 140);
}
function closeLead(){
  const m = $('leadModal');
  m.classList.remove('show'); m.setAttribute('aria-hidden','true');
}
function leadOpen(){ return $('leadModal').classList.contains('show'); }
async function submitLead(){
  const nameEl = $('l-name'), mailEl = $('l-email');
  const mark = (el, bad) => el.closest('.field').classList.toggle('bad', bad);
  let ok = true;
  const nv = nameEl.value.trim();
  if (!nv){ mark(nameEl, true); ok = false; } else mark(nameEl, false);
  const ev = mailEl.value.trim();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(ev)){ mark(mailEl, true); ok = false; } else mark(mailEl, false);
  if (!ok){ (nv ? mailEl : nameEl).focus(); return; }

  const submitBtn = $('leadSubmit');
  const submitText = submitBtn.textContent;
  submitBtn.disabled = true;
  submitBtn.textContent = 'Generating report...';

  state.details.name  = nv;
  state.details.email = ev;
  state.details.org   = $('l-org').value.trim();
  state.leadDone = true;

  const captured = await submitScorecardCapture();
  submitBtn.disabled = false;
  submitBtn.textContent = submitText;

  closeLead();
  toast(captured ? 'Saved. Building your PDF…' : 'Building your PDF. We could not save your responses.');
  setTimeout(buildPDF, 220);
}

/* ================= WIRING ================= */
$('startBtn').addEventListener('click', ()=> show(1, 1));
$('nextBtn').addEventListener('click', ()=>{
  if (state.step === LAST){ requestPDF(); return; }
  if (!stepComplete(state.step)){ toast('Choose an option to continue'); return; }
  show(state.step + 1, 1);
});
$('backBtn').addEventListener('click', ()=>{ if (state.step > 0) show(state.step - 1, -1); });

$('leadClose').addEventListener('click', closeLead);
$('leadSubmit').addEventListener('click', submitLead);
$('leadModal').addEventListener('click', e => { if (e.target === $('leadModal')) closeLead(); });

document.addEventListener('keydown', e=>{
  if (leadOpen()){
    if (e.key === 'Enter'){ e.preventDefault(); submitLead(); }
    if (e.key === 'Escape') closeLead();
    return;
  }
  if (e.target.tagName === 'INPUT') return;
  if (e.key === 'Enter' && !$('nextBtn').disabled) $('nextBtn').click();
  if (e.key === 'Escape' && state.step > 0) $('backBtn').click();
  // 1-4 pick an option on a question card, Y/N on an override card
  if (state.step >= 1 && state.step < LAST){
    const card = $(screens()[state.step]);
    if (!card) return;
    const inputs = card.querySelectorAll('.opt input');
    let idx = -1;
    if (/^[1-9]$/.test(e.key)) idx = parseInt(e.key,10) - 1;
    else if (state.step >= OVR0 && (e.key === 'y' || e.key === 'Y')) idx = 0;
    else if (state.step >= OVR0 && (e.key === 'n' || e.key === 'N')) idx = 1;
    if (idx >= 0 && inputs[idx]){ inputs[idx].checked = true; inputs[idx].dispatchEvent(new Event('change')); }
  }
});

/* ================= INIT ================= */
buildQuestions(); buildOverrides(); show(0, 1);

</script>
  </div>
  <Footer />
</div>
</Layout>
