  text-transform:uppercase; color:var(--text-label); text-align:left;
  padding:8px 10px; border-bottom:1px solid var(--border);
}
.wsheet td{padding:5px 4px}
.wsheet input{
  width:100%; padding:8px 10px; font-family:var(--font-body); font-size:14px;
  color:var(--text-primary); background:var(--bg);
  border:1px solid var(--border); border-radius:var(--radius-sm);
}
.wsheet input:focus{outline:none; border-color:var(--blue-500)}
details.more{border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface-1); padding:0; overflow:hidden}
