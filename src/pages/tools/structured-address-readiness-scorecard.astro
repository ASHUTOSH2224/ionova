<header class="scorecard-progress" aria-label="Scorecard progress">
  <div class="scorecard-progress-in">
    <div class="scorecard-progress-title">Readiness Scorecard</div>
    <div class="prog-outer"><div class="prog-inner" id="prog"></div></div>
    <div class="stepline" id="stepline"></div>
  </div>
</header>

<main class="scorecard-main" id="scorecardMain">
  <div class="wrap">

    <!-- ============ WELCOME ============ -->
    <section class="screen active" id="s-welcome">
      <div class="scorecard-hero-badge">
        <span class="scorecard-pulse-dot"></span>
        <span>ioNova · Self-assessment</span>
      </div>
      <h1>ISO&nbsp;20022 Structured-Address <span class="accent">Readiness Scorecard</span></h1>
      <p class="lede mt-sm">Score your own estate across six dimensions in about five minutes — and find out which use case should be your first sprint.</p>

      <div class="start-wrap mt">
        <button class="btn-start" id="startBtn">Start the scorecard &rarr;</button>
        <span class="start-note">One question per screen &middot; nothing to scroll through</span>
      </div>

      <div class="note info mt">
        <strong>The deadline this measures you against.</strong> The new ISO 20022 structured-address standards take effect on <strong>14 November 2026</strong>, and everything must be complete before that date. From then, payments carrying fully unstructured addresses are not warned or delayed for repair under SWIFT CBPR+ — they are rejected at the network boundary, with SEPA and other market infrastructures aligned.
      </div>

      <div class="note mt">
        <strong>One caution, offered in good faith.</strong> This is a self-assessment, so it measures what you believe about your data. In readiness work we consistently see institutions place themselves a full maturity level above where their data actually sits — which is why the questions reward <em>measurement</em> over <em>impression</em>. If a question offers you the choice between “we estimate” and “we measured,” the gap between those two answers is usually where the risk is hiding.
      </div>

      <p class="smallprint mt">18 questions · six dimensions · scored out of 54. Your contact details and scorecard responses are submitted to ioNova so we can follow up; your PDF is assembled locally.</p>
    </section>

    <!-- ============ DIMENSIONS (generated) ============ -->
    <div id="dimScreens"></div>

    <!-- ============ OVERRIDES (generated, one per screen) ============ -->
    <div id="ovrScreens"></div>

    <!-- ============ RESULTS ============ -->
    <section class="screen" id="s-results">
      <div id="resultBody"></div>
    </section>

  </div>
</main>

<nav class="scorecard-nav">
  <div class="scorecard-nav-in">
    <button class="btn btn-ghost" id="backBtn">← Back</button>
    <span class="navnote" id="navNote"></span>
    <button class="btn btn-primary" id="nextBtn">Begin →</button>
  </div>
</nav>

<!-- ============ LEAD CAPTURE MODAL ============ -->
<div class="modal-back" id="leadModal" aria-hidden="true">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="leadTitle">
    <button class="modal-x" id="leadClose" aria-label="Close">&times;</button>
    <div class="eyebrow">Last step</div>
    <h3 id="leadTitle">Where should we address this report?</h3>
    <p class="lede">Your scorecard PDF is generated locally and downloads straight to this device. Your contact details and response summary are submitted to ioNova so we can follow up.</p>

    <div class="grid2">
      <div class="field">
        <label for="l-name">First name<span class="req">*</span></label>
        <input id="l-name" autocomplete="given-name" placeholder="First name">
        <div class="err">Please enter your first name.</div>
      </div>
      <div class="field">
        <label for="l-email">Work email address<span class="req">*</span></label>
        <input id="l-email" type="email" autocomplete="email" placeholder="you@institution.com">
        <div class="err">Please enter a valid work email.</div>
      </div>
    </div>
    <div class="field">
      <label for="l-org">Institution</label>
      <input id="l-org" autocomplete="organization" placeholder="e.g. Meridian Bank">
    </div>
    <button class="btn btn-primary" id="leadSubmit">Generate my scorecard PDF &darr;</button>
    <p class="smallprint mt-sm" style="margin-bottom:0">By generating the report, you agree that ioNova may process your contact details and scorecard responses to follow up on your readiness result. The PDF is assembled locally on this device.</p>
  </div>
</div>

<div class="toast" id="toast"></div>

<script is:inline src="/vendor/jspdf.umd.min.js"></script>
<script is:inline>
const LOGO_WORDMARK = "data:image/png;base64,";
const LOGO_WORDMARK_WHITE = "data:image/png;base64,";
const LOGO_ICON = "data:image/png;base64,";
/* ================= DATA ================= */
const DIMS = [{"n": 1, "name": "Data at rest", "sub": "The addresses you already hold — beneficiary and vendor masters, KYC stores, standing instructions, archived templates.", "questions": [{"q": "What shape are party addresses in your master data today?", "opts": ["Free-text lines only — no dedicated address fields.", "Free text with some parsed fields, populated inconsistently.", "Town and country in their own fields for most records (hybrid-capable).", "Street, building number, postcode, town and country in their own fields for most records."]}, {"q": "Do you know what share of your stored party addresses would pass structured-address validation today?", "opts": ["No.", "We have an internal estimate, but it has not been measured.", "Measured on a sample of real records.", "Measured across the full store, and refreshed on a schedule."]}, {"q": "Legacy stock — MT103-format templates, archived instructions, masters inherited from acquisitions:", "opts": ["Present, unquantified, and no remediation plan.", "Present and quantified, but no remediation plan.", "Quantified with a remediation plan agreed but not yet started.", "Remediation underway or complete."]}]}, {"n": 2, "name": "Data in motion", "sub": "Payments in flight — what can be corrected, and where, before a message leaves you.", "questions": [{"q": "Where can a party address be corrected in your outbound flow today?", "opts": ["Nowhere — whatever the source system supplies is what we send.", "Manually, by operations, after a rejection or an RFI comes back.", "A validation step flags problems but does not correct them.", "An automated correction point sits in the flow before screening and release."]}, {"q": "Can you hand a whole pain.001 or pacs.008 to a service and get the same message back with only the address blocks changed?", "opts": ["No — and we assume this would require a field-mapping project.", "No, but we have scoped what it would take.", "Yes, working in a test or sandbox environment.", "Yes, in production today."]}, {"q": "Inbound traffic from senders and correspondents you do not control:", "opts": ["Not assessed.", "Assessed; non-compliant addresses are hand-worked when they fail.", "Classified automatically, then repaired manually.", "Classified and auto-repaired on the inbound leg."]}]}, {"n": 3, "name": "Exceptions capacity", "sub": "The desk that carries whatever automation cannot resolve. Typically around 2% of volume — which is not a small number at scale.", "questions": [{"q": "Do you know your current address-related exception volume per month?", "opts": ["No.", "Roughly, from anecdote rather than reporting.", "Measured.", "Measured and trended by root cause."]}, {"q": "If around 2% of your monthly message volume needed human address review, could your current team absorb it?", "opts": ["We know neither our volume nor our review capacity.", "We know the number, and it would overwhelm the team.", "We could absorb it with overtime or temporary cover.", "We have sized and staffed for it deliberately."]}, {"q": "How does a repair actually get made and recorded?", "opts": ["Ad hoc — email and spreadsheets.", "A ticket queue, with no confidence thresholds.", "A queue with confidence thresholds governing what routes to a human.", "Queue, thresholds and maker-checker approval, every decision logged."]}]}, {"n": 4, "name": "Screening quality", "sub": "What your financial-crime controls actually see. Free text and field-level data do not screen alike.", "questions": [{"q": "What do your sanctions screening controls receive for party addresses?", "opts": ["Free text exactly as captured upstream.", "Free text with light normalisation.", "Partially structured fields.", "Fully structured, field-level data."]}, {"q": "Do you know how much of your screening false-positive volume is driven by address data quality?", "opts": ["No.", "Estimated.", "Measured.", "Measured, with a reduction target and a trend line."]}, {"q": "Is the address data in your KYC / CDD store aligned with the addresses used in payments?", "opts": ["Different stores, never reconciled.", "Same store, but quality is unreconciled.", "Reconciled periodically.", "One corrected source feeds both."]}]}, {"n": 5, "name": "Auditability", "sub": "Whether you can defend a correction months later — to an examiner, a regulator, or a correspondent's compliance desk.", "questions": [{"q": "If an examiner asked why a specific address was changed six months ago, could you show them?", "opts": ["No.", "We could reconstruct it manually, with effort.", "Yes, for changes made within one system.", "Yes — a cited rule and per-field confidence recorded for every change."]}, {"q": "Would re-running last quarter's correction today produce an identical result?", "opts": ["No, or unknown.", "Probably not — the logic has moved on since.", "Likely, but we have never tested it.", "Yes, and we have tested it."]}, {"q": "Human decisions on exceptions are:", "opts": ["Not recorded.", "Recorded as free-text notes.", "Recorded with the reviewer's identity.", "Recorded with maker-checker, on the same audit trail as automated decisions."]}]}, {"n": 6, "name": "Per-corridor posture", "sub": "Where your exposure actually sits. Portfolio averages routinely conceal a single intersection that carries most of the risk.", "questions": [{"q": "Can you break unstructured-address exposure down across your business?", "opts": ["No.", "By region only.", "By corridor.", "By corridor, scheme and message format together."]}, {"q": "Do you know which single intersection — one scheme, one format, one corridor — carries your largest exposure?", "opts": ["No.", "We have a hypothesis, untested.", "Yes, identified from data.", "Yes, identified from data — and it is already the target of work in progress."]}, {"q": "Your format policy per scheme and flow — hybrid floor, or fully structured target:", "opts": ["Not yet discussed.", "Discussed, not decided.", "Decided for some flows.", "Decided and documented for every scheme and flow."]}]}];
const OVERRIDES = ["Is there any live flow in which a party address cannot be corrected before the message is submitted?", "Is any one of your three highest-volume corridors currently carrying a majority of unstructured party addresses?", "Is the go-live date for any address-correction capability you are relying on scheduled later than 14 November 2026?"];
const BANDS = [{"level": "L1", "range": "0 – 17", "title": "Free-text baseline", "means": "Party addresses are effectively unstructured and the estate has not been measured. On the current trajectory, a material share of payments will be rejected from the effective date.", "move": "Do not start with tooling. Measure first: put a real sample of live traffic against the structure rules so the argument inside your organisation stops being a matter of opinion."}, {"level": "L2", "range": "18 – 31", "title": "Partially structured, unevenly", "means": "Some structure exists and some awareness exists, but neither is consistent. Scores in this band almost always conceal at least one flow that is entirely unremediated.", "move": "Find the concentration before you plan the work. Rank exposure by intersection, then run one use case end to end rather than opening a programme on every flow at once."}, {"level": "L3", "range": "32 – 44", "title": "At or near the hybrid floor", "means": "You are close to the shape the standards demand — town and country structured, the remainder in at most two address lines, no duplication of structured content. Enough to avoid rejection, if it holds across every flow.", "move": "Prove it flow by flow rather than in aggregate, and close the weakest dimension on your score summary. Then decide, deliberately, whether fully structured is worth the additional step for your highest-value corridors."}, {"level": "L4", "range": "45 – 54", "title": "Fully structured", "means": "Every component in its own field, with the evidence to defend it. This is where the operational dividends live — higher straight-through rates, and materially fewer address-driven screening false positives.", "move": "Protect the position. Confirm replay and audit evidence would satisfy an examiner, and turn the capability outward: pre-validating clients' or subsidiaries' files is a service, not just a control."}];

const BAND_RGB = { L1:[239,68,68], L2:[245,158,11], L3:[16,185,129], L4:[60,117,181] };
const BAND_CSS = { L1:'var(--alert-red)', L2:'var(--alert-amber)', L3:'var(--alert-green)', L4:'var(--blue-500)' };
const SCORECARD_CAPTURE_ENDPOINT = window.IONOVA_SCORECARD_ENDPOINT || 'https://ionova-scorecard-capture.rough-night-bf2a.workers.dev/scorecard';
const SCORECARD_CAPTURE_TIMEOUT_MS = 4500;
const MAX = DIMS.length * 9;

/* ================= STATE ================= */
const state = {
  step: 0,                       // 0 welcome, 1..18 questions, 19..21 overrides, 22 results
  answers: {},                   // "d.q" -> 0..3
  overrides: [null, null, null],
  details: { org:'', name:'', email:'' },
  sheet: [ blankRow(), blankRow(), blankRow() ],
  leadDone: false,
  _t: null                       // auto-advance timer
};
function blankRow(){ return { flow:'', scheme:'', fmt:'', vol:'', pct:'' }; }

/* one question per screen: flatten every dimension question into a single list */
const QLIST = [];
DIMS.forEach(dim => dim.questions.forEach((item, i) => {
  QLIST.push({ dim: dim, item: item, key: dim.n + '.' + (i+1), pos: i+1, of: dim.questions.length });
}));
const NQ   = QLIST.length;               // 18
const OVR0 = NQ + 1;                     // first override step
const LAST = NQ + OVERRIDES.length + 1;  // results screen

/* ================= HELPERS ================= */
const $ = id => document.getElementById(id);
let ttPolicy = null;
if (window.trustedTypes && window.trustedTypes.createPolicy) {
  try { ttPolicy = window.trustedTypes.createPolicy('ionova-scorecard', { createHTML: value => value }); } catch (e) { ttPolicy = null; }
}
function setHTML(el, html){ el.innerHTML = ttPolicy ? ttPolicy.createHTML(html) : html; }
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function toast(msg){
  const t = $('toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(t._t); t._t = setTimeout(()=>t.classList.remove('show'), 2600);
}
function todayStr(){
  return new Date().toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'});
}

/* ================= BUILD QUESTION SCREENS (one per card) ================= */
function buildQuestions(){
  setHTML($('dimScreens'), QLIST.map((q, idx) => `
    <section class="screen" id="s-q${idx}">
      <div class="qcard">
        <div class="qmeta">
          <span class="badge">${q.dim.n}</span>
          <span>${esc(q.dim.name)}</span>
          <span style="opacity:.55">&middot; ${q.pos} of ${q.of}</span>
        </div>
        ${q.pos === 1 ? `<p class="q-note">${esc(q.dim.sub)}</p>` : ''}
        <div class="q-lead">${esc(q.item.q)}</div>
        <div class="opts">
          ${q.item.opts.map((o,k)=>`
            <div class="opt">
              <input type="radio" name="q${q.key}" id="o-${q.key}-${k}" value="${k}"
                     onchange="answer('${q.key}',${k})">
              <label for="o-${q.key}-${k}"><span class="pip">${k}</span><span>${esc(o)}</span></label>
            </div>`).join('')}
        </div>
      </div>
    </section>`).join(''));
}

function buildOverrides(){
  setHTML($('ovrScreens'), OVERRIDES.map((o,i)=>`
    <section class="screen" id="s-ovr${i}">
      <div class="qcard">
        <div class="qmeta">
          <span class="badge">!</span>
          <span>Override question</span>
          <span style="opacity:.55">&middot; ${i+1} of ${OVERRIDES.length}</span>
        </div>
        ${i === 0 ? `<p class="q-note">Each of these describes a condition that produces rejected payments regardless of how well the rest of the estate scores.</p>` : ''}
        <div class="q-lead">${esc(o)}</div>
        <div class="opts">
          <div class="opt">
            <input type="radio" name="ovr${i}" id="ovr${i}y" onchange="setOvr(${i},true)">
            <label for="ovr${i}y"><span class="pip">Y</span><span>Yes</span></label>
          </div>
          <div class="opt">
            <input type="radio" name="ovr${i}" id="ovr${i}n" onchange="setOvr(${i},false)">
            <label for="ovr${i}n"><span class="pip">N</span><span>No</span></label>
          </div>
        </div>
      </div>
    </section>`).join(''));
}

/* ================= ANSWERING ================= */
function answer(key, val){ state.answers[key] = val; refreshNav(); autoNext(); }
function setOvr(i, val){ state.overrides[i] = val; refreshNav(); autoNext(); }
function autoNext(){
  clearTimeout(state._t);
  if (state.step >= LAST) return;
  state._t = setTimeout(()=>{ if (stepComplete(state.step)) show(state.step + 1, 1); }, 380);
}

/* ================= SCORING ================= */
function dimScore(n){
  return [1,2,3].reduce((s,i)=> s + (state.answers[`${n}.${i}`] ?? 0), 0);
}
function total(){ return DIMS.reduce((s,d)=> s + dimScore(d.n), 0); }
function bandFor(score){
  // bands are contiguous over 0..MAX
  if (score <= 17) return BANDS[0];
  if (score <= 31) return BANDS[1];
  if (score <= 44) return BANDS[2];
  return BANDS[3];
}
function flagged(){ return DIMS.filter(d => dimScore(d.n) <= 3); }
function overrideCount(){ return state.overrides.filter(v => v === true).length; }
function adjustedBand(){
  const b = bandFor(total());
  if (!overrideCount()) return { band:b, adjusted:null };
  const i = BANDS.indexOf(b);
  return { band:b, adjusted: i > 0 ? BANDS[i-1] : null };
}
function dimensionScorePayload(){
  return DIMS.map(d => ({ number:d.n, name:d.name, score:dimScore(d.n), flagged:dimScore(d.n) <= 3 }));
}
function answerPayload(){
  return DIMS.map(dim => ({
    number: dim.n,
    name: dim.name,
    questions: dim.questions.map((item, i) => {
      const key = dim.n + '.' + (i + 1);
      const answerIndex = state.answers[key];
      return {
        key,
        question: item.q,
        answerIndex: answerIndex === undefined ? null : answerIndex,
        answer: answerIndex === undefined ? null : item.opts[answerIndex],
        score: answerIndex === undefined ? 0 : answerIndex,
      };
    }),
  }));
}
function responsePayload(){
  const score = total();
  const band = bandFor(score);
  const adjusted = adjustedBand().adjusted;
  return {
    submittedAt: new Date().toISOString(),
    pageUrl: window.location.href,
    lead: { name: state.details.name, email: state.details.email, organization: state.details.org },
    score,
    maxScore: MAX,
    band: band.level,
    bandTitle: band.title,
    adjustedBand: adjusted ? adjusted.level : null,
    overrideCount: overrideCount(),
    overrides: OVERRIDES.map((question, i) => ({ question, answer: state.overrides[i] })),
    flaggedDimensions: flagged().map(d => ({ number:d.n, name:d.name, score:dimScore(d.n) })),
    dimensionScores: dimensionScorePayload(),
    answers: answerPayload(),
    worksheet: state.sheet,
  };
}
async function submitScorecardCapture(){
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), SCORECARD_CAPTURE_TIMEOUT_MS);
  try {
    const response = await fetch(SCORECARD_CAPTURE_ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'omit',
      signal: controller.signal,
      body: JSON.stringify(responsePayload()),
    });
    clearTimeout(timer);
    if (!response.ok) throw new Error('Scorecard capture failed with HTTP ' + response.status);
    return true;
  } catch (error) {
    clearTimeout(timer);
    console.warn('Scorecard capture failed', error);
    return false;
  }
}

/* ================= NAVIGATION ================= */
function screens(){
  return ['s-welcome',
          ...QLIST.map((q,i)=>'s-q'+i),
          ...OVERRIDES.map((o,i)=>'s-ovr'+i),
          's-results'];
}
function show(step, dir){
  if (dir === undefined) dir = step >= state.step ? 1 : -1;
  clearTimeout(state._t);
  state.step = step;
  const ids = screens();
  ids.forEach((id,i)=>{
    const el = $(id); if (!el) return;
    el.classList.toggle('active', i === step);
    if (i === step) el.classList.toggle('rev', dir < 0);
  });
  $('scorecardPage').classList.toggle('is-welcome', step === 0);
  $('scorecardPage').classList.toggle('is-results', step === LAST);
  if (step === LAST) renderResults();
  const m = $('scorecardMain'); if (m) m.scrollTop = 0;
  window.scrollTo({ top:0 });
  refreshNav(); refreshProgress();
}
function stepComplete(step){
  if (step === 0 || step === LAST) return true;
  if (step <= NQ) return state.answers[QLIST[step-1].key] !== undefined;
  return state.overrides[step - OVR0] !== null;
}
function answeredCount(){ return Object.keys(state.answers).length; }

function refreshNav(){
  const b = $('backBtn'), nx = $('nextBtn'), note = $('navNote');
  b.style.visibility = state.step === 0 ? 'hidden' : 'visible';
  const done = stepComplete(state.step);

  if (state.step === LAST){
    nx.textContent = 'Download PDF \u2193';
    nx.disabled = false; nx.classList.remove('ready');
    note.textContent = 'Your result is ready.';
    b.textContent = '\u2190 Review answers';
    return;
  }
  b.textContent = '\u2190 Back';
  nx.disabled = !done;
  nx.classList.toggle('ready', done && state.step > 0);

  if (state.step === 0){
    nx.textContent = 'Start \u2192';
    note.textContent = '18 questions \u00b7 about five minutes';
  } else if (state.step <= NQ){
    const q = QLIST[state.step-1];
    nx.textContent = 'Next \u2192';
    note.textContent = `Question ${state.step} of ${NQ} \u00b7 ${q.dim.name}`;
  } else {
    const i = state.step - OVR0;
    nx.textContent = (i === OVERRIDES.length - 1) ? 'See my result \u2192' : 'Next \u2192';
    note.textContent = `Override ${i+1} of ${OVERRIDES.length} \u00b7 ${answeredCount()}/${NQ} questions answered`;
  }
}
function phaseOf(step){
  if (step === 0) return 0;
  if (step <= NQ) return QLIST[step-1].dim.n;   // 1..6
  if (step < LAST) return DIMS.length + 1;      // overrides
  return DIMS.length + 2;                       // result
}
function refreshProgress(){
  $('prog').style.width = Math.round((state.step / LAST) * 100) + '%';
  const labels = ['Start', ...DIMS.map(d=>d.name), 'Overrides', 'Result'];
  const ph = phaseOf(state.step);
  setHTML($('stepline'), labels.map((l,i)=>{
    const cls = i < ph ? 'done' : (i === ph ? 'now' : '');
    return `<span class="dot ${cls}"></span>${i === ph ? `<span style="margin-right:6px">${esc(l)}</span>` : ''}`;
  }).join(''));
}

