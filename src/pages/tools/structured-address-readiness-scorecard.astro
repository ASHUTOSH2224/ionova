---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
---

<Layout
  title="ISO 20022 Structured-Address Readiness Scorecard — ioNova AI"
  description="Self-assess ISO 20022 structured-address readiness across six dimensions and generate a customized PDF scorecard for your institution."
  keywords="ISO 20022 readiness scorecard, structured address scorecard, SWIFT CBPR+ address readiness, SEPA structured address compliance"
  ogImage="/og-image.png"
  ogImageAlt="ioNova ISO 20022 Structured Address Readiness Scorecard"
  canonicalOverride="https://ionova.ai/tools/structured-address-readiness-scorecard"
>
<script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "ISO 20022 Structured-Address Readiness Scorecard",
    "url": "https://ionova.ai/tools/structured-address-readiness-scorecard",
    "applicationCategory": "BusinessApplication",
    "description": "Self-assess ISO 20022 structured-address readiness across six dimensions and generate a customized PDF scorecard.",
    "provider": { "@type": "Organization", "name": "ioNova AI", "url": "https://ionova.ai" }
  }
</script>

<div class="flex min-h-screen flex-col bg-[#F1F4F9]">
  <Navbar client:idle />
  <div class="scorecard-page is-welcome" id="scorecardPage" data-theme="light">
<style is:global>
/* ============ ioNova design tokens (v5) ============ */
.scorecard-page{
  --font-display:'Figtree',system-ui,-apple-system,sans-serif;
  --font-body:'Figtree',system-ui,-apple-system,sans-serif;
  --font-mono:'JetBrains Mono','Fira Code',monospace;

  --navy-950:#0E1935; --navy-900:#111426; --navy-800:#1A1E35;
  --blue-700:#243574; --blue-600:#2B4E86; --blue-500:#3C75B5; --blue-400:#5EA1DC;
  --sky-200:#8ECDF2; --teal-500:#43ADC1; --cyan-400:#5FCFD0;

  --alert-red:#EF4444; --alert-amber:#F59E0B; --alert-green:#10B981;

  --radius-sm:6px; --radius-md:6px; --radius-lg:6px; --radius-xl:6px; --radius-full:9999px;
  --space-xs:4px; --space-sm:8px; --space-md:16px; --space-lg:24px; --space-xl:32px;
  --space-2xl:48px; --space-3xl:64px;

  --ease:cubic-bezier(.4,0,.2,1);
  --ease-out-expo:cubic-bezier(.16,1,.3,1);
  --ease-bounce:cubic-bezier(.34,1.56,.64,1);

  --gradient-brand:linear-gradient(135deg,#5FCFD0,#43ADC1,#3C75B5,#243574);
  --gradient-text:linear-gradient(135deg,#43ADC1,#3C75B5,#243574);

  flex:1 0 auto;
  min-height:100dvh;
  padding-top:132px;
  background:var(--bg);
  color:var(--text-primary);
  font-family:var(--font-body);
  font-size:16px;
  line-height:1.65;
  -webkit-font-smoothing:antialiased;
  transition:background .4s var(--ease),color .4s var(--ease);
}
.scorecard-page[data-theme="light"]{
  --bg:#F1F4F9; --surface-1:#FFFFFF; --surface-2:#E8EDF5; --surface-3:#D6E0ED;
  --border:#D0DAEB; --border-strong:#B8CCE2;
  --text-primary:#0E1935; --text-muted:#576A86; --text-label:#466587;
  --nav-bg:rgba(241,244,249,.82);
  --shadow-sm:0 1px 3px rgba(14,25,53,.05),0 1px 2px rgba(14,25,53,.03);
  --shadow-md:0 4px 12px rgba(14,25,53,.07),0 2px 4px rgba(14,25,53,.04);
  --shadow-lg:0 8px 30px rgba(14,25,53,.09),0 4px 8px rgba(14,25,53,.04);
  --shadow-xl:0 20px 60px rgba(14,25,53,.12),0 8px 16px rgba(14,25,53,.05);
  --btn-primary-bg:var(--navy-950); --btn-primary-hover:var(--blue-700);
  --btn-primary-shadow:rgba(14,25,53,.25);
  --alert-amber-soft:#FFFBEB; --alert-amber-border:#FDE68A; --alert-amber-text:#92400E;
  --alert-green-soft:#ECFDF5; --alert-green-border:#A7F3D0; --alert-green-text:#065F46;
  --alert-red-soft:#FEF2F2;   --alert-red-border:#FECACA;   --alert-red-text:#991B1B;
}
.scorecard-page[data-theme="dark"]{
  --bg:#060A15; --surface-1:#0F1729; --surface-2:#182238; --surface-3:#222F4C;
  --border:#1E2A48; --border-strong:#2D4062;
  --text-primary:#E2E8F4; --text-muted:#8796A7; --text-label:#8A9DBD;
  --nav-bg:rgba(6,10,21,.82);
  --shadow-sm:0 1px 3px rgba(0,0,0,.30);
  --shadow-md:0 4px 14px rgba(0,0,0,.35);
  --shadow-lg:0 8px 30px rgba(0,0,0,.40),0 0 1px rgba(95,207,208,.1);
  --shadow-xl:0 20px 60px rgba(0,0,0,.50),0 0 2px rgba(95,207,208,.12);
  --btn-primary-bg:var(--blue-500); --btn-primary-hover:var(--blue-400);
  --btn-primary-shadow:rgba(60,117,181,.35);
  --alert-amber-soft:rgba(245,158,11,.1); --alert-amber-border:rgba(245,158,11,.25); --alert-amber-text:#FCD34D;
  --alert-green-soft:rgba(16,185,129,.1); --alert-green-border:rgba(16,185,129,.25); --alert-green-text:#6EE7B7;
  --alert-red-soft:rgba(239,68,68,.1);    --alert-red-border:rgba(239,68,68,.25);    --alert-red-text:#FCA5A5;
}

.scorecard-page *{box-sizing:border-box}
.scorecard-page h1,
.scorecard-page h2,
.scorecard-page h3,
.scorecard-page h4{font-family:var(--font-display); font-style:italic; letter-spacing:0; margin:0}
.scorecard-page h1{font-size:48px; font-weight:800; line-height:1.08}
.scorecard-page h2{font-size:clamp(26px,3.2vw,38px); font-weight:700; line-height:1.16}
.scorecard-page h3{font-size:19px; font-weight:600}
.scorecard-page p{margin:0 0 var(--space-md)}
.scorecard-page a{color:var(--blue-500)}

.scorecard-page .wrap{max-width:960px; margin:0 auto; padding:0 var(--space-lg)}
.scorecard-page.is-welcome .wrap{max-width:1200px}

/* ---------- tool progress ---------- */
.scorecard-progress{
  position:sticky;
  top:112px;
  z-index:30;
  padding:0 var(--space-lg);
  background:transparent;
  border-bottom:0;
  box-shadow:none;
  pointer-events:none;
}
.scorecard-progress-in{
  max-width:820px;
  margin:0 auto;
  padding:10px 16px 9px;
  border:1px solid rgba(184,204,226,.8);
  border-radius:var(--radius-lg);
  background:rgba(255,255,255,.78);
  box-shadow:0 10px 30px rgba(14,25,53,.07);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  pointer-events:auto;
}
.scorecard-progress-title{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  margin:0 auto 8px;
  padding:3px 10px;
  border:1px solid rgba(67,173,193,.16);
  border-radius:var(--radius-full);
  background:rgba(95,207,208,.08);
  color:var(--text-label);
  font-family:var(--font-display);
  font-size:10.5px;
  font-weight:700;
  letter-spacing:.8px;
  line-height:1.25;
  text-align:center;
  text-transform:uppercase;
}

/* ---------- progress ---------- */
.scorecard-page .prog-outer{
  height:4px;
  background:rgba(214,224,237,.9);
  border-radius:var(--radius-full);
  position:relative;
  overflow:hidden;
}
.scorecard-page .prog-inner{height:100%; width:0; background:var(--gradient-brand);
  transition:width .55s var(--ease-out-expo)}
.scorecard-page .stepline{
  padding:8px 0 0;
  display:flex; align-items:center; justify-content:center; gap:8px; flex-wrap:wrap;
  font-family:var(--font-display); font-size:11px; font-weight:600;
  letter-spacing:.5px; text-transform:uppercase; color:var(--text-label);
}
.scorecard-page .dot{width:7px; height:7px; border-radius:50%; background:var(--surface-3); transition:all .35s var(--ease)}
.scorecard-page .dot.done{background:var(--teal-500)}
.scorecard-page .dot.now{background:var(--blue-500); box-shadow:0 0 0 4px rgba(60,117,181,.15)}

/* ---------- screens ---------- */
.scorecard-main{min-height:calc(100dvh - 220px); display:flex; align-items:flex-start; padding:56px 0 128px; overflow-y:auto}
.scorecard-main > .wrap{width:100%}
.scorecard-page.is-results .scorecard-main{align-items:flex-start; padding-top:var(--space-xl)}
.scorecard-page.is-welcome .scorecard-progress{display:none}
.scorecard-page.is-results .scorecard-progress{display:none}
.scorecard-page.is-welcome .scorecard-nav{display:none}
.scorecard-page.is-welcome .scorecard-main{padding-top:0; padding-bottom:var(--space-3xl)}
.scorecard-page .screen{display:none}
.scorecard-page .screen.active{display:block; animation:slideNext .42s var(--ease-out-expo) both}
.scorecard-page .screen.active.rev{animation-name:slidePrev}
@keyframes slideNext{from{opacity:0; transform:translateX(28px)}to{opacity:1; transform:none}}
@keyframes slidePrev{from{opacity:0; transform:translateX(-28px)}to{opacity:1; transform:none}}

.eyebrow{
  font-family:var(--font-display); font-size:11.5px; font-weight:700; letter-spacing:1.4px;
  text-transform:uppercase; color:var(--teal-500); margin-bottom:12px;
}
.lede{font-size:18px; color:var(--text-muted); max-width:64ch}
.scorecard-page #s-welcome{
  max-width:100%;
  margin:0 auto;
  text-align:center;
  position:relative;
  overflow:hidden;
  padding:0 0 var(--space-xl);
}
.scorecard-page #s-welcome::before{
  content:'';
  position:absolute;
  top:-220px;
  right:-180px;
  width:820px;
  height:820px;
  pointer-events:none;
  background:radial-gradient(circle,rgba(95,207,208,.12) 0%,rgba(67,173,193,.06) 30%,transparent 60%);
}
.scorecard-page #s-welcome::after{
  content:'';
  position:absolute;
  bottom:-180px;
  left:-140px;
  width:560px;
  height:560px;
  pointer-events:none;
  background:radial-gradient(circle,rgba(94,161,220,.08) 0%,transparent 55%);
}
.scorecard-page #s-welcome > *{
  position:relative;
  z-index:1;
}
.scorecard-page #s-welcome .scorecard-hero-badge{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:6px 18px;
  margin-bottom:var(--space-lg);
  overflow:hidden;
  position:relative;
  border:1px solid var(--border);
  border-radius:var(--radius-full);
  background:var(--surface-1);
  color:var(--teal-500);
  font-family:var(--font-display);
  font-size:12px;
  font-weight:600;
  letter-spacing:.5px;
  text-transform:uppercase;
}
.scorecard-page #s-welcome .scorecard-hero-badge::after{
  content:'';
  position:absolute;
  inset:0;
  background:linear-gradient(110deg,transparent 25%,rgba(95,207,208,.06) 37%,rgba(142,205,242,.08) 50%,rgba(95,207,208,.06) 63%,transparent 75%);
  background-size:200% 100%;
  animation:scorecard-shimmer 3s ease-in-out infinite;
}
.scorecard-page #s-welcome .scorecard-pulse-dot{
  width:6px;
  height:6px;
  border-radius:50%;
  background:var(--cyan-400);
  animation:scorecard-dot-pulse 2s ease-in-out infinite;
}
.scorecard-page #s-welcome .scorecard-hero-badge span{
  position:relative;
  z-index:1;
}
.scorecard-page #s-welcome h1{
  max-width:850px;
  margin-left:auto;
  margin-right:auto;
  color:var(--text-primary);
  font-size:48px;
  line-height:1.1;
  letter-spacing:0;
}
.scorecard-page #s-welcome h1 .accent{
  background:var(--gradient-text);
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
  background-clip:text;
}
.scorecard-page #s-welcome .lede{
  max-width:750px;
  margin-top:var(--space-lg);
  font-size:17px;
  line-height:1.7;
  color:var(--text-label);
}
.scorecard-page #s-welcome .lede,
.scorecard-page #s-welcome .smallprint{
  margin-left:auto;
  margin-right:auto;
}
.scorecard-page #s-welcome .note{
  max-width:900px;
  margin-left:auto;
  margin-right:auto;
  text-align:left;
}
.scorecard-page #s-welcome .start-wrap{
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:10px;
  text-align:center;
}
.scorecard-page #s-welcome .start-note{
  display:block;
  width:100%;
  text-align:center;
}
@keyframes scorecard-shimmer{0%{background-position:-200% center}100%{background-position:200% center}}
@keyframes scorecard-dot-pulse{0%,100%{opacity:1; transform:scale(1)}50%{opacity:.45; transform:scale(1.8)}}
@media(max-width:768px){
  .scorecard-page h1,
  .scorecard-page #s-welcome h1{font-size:38px}
  .scorecard-page{padding-top:112px}
}
@media(max-width:480px){
  .scorecard-page h1,
  .scorecard-page #s-welcome h1{font-size:32px}
  .scorecard-page #s-welcome .lede{font-size:16px}
}
.scorecard-page #s-results{
  max-width:960px;
  margin:0 auto;
}
.scorecard-page.is-results #resultBody > .eyebrow,
.scorecard-page.is-results #resultBody > h2{
  text-align:center;
}

.card{
  background:var(--surface-1); border:1px solid var(--border);
  border-radius:var(--radius-lg); padding:var(--space-xl);
  box-shadow:var(--shadow-sm);
}
.note{
  border-radius:var(--radius-md); padding:16px 20px; font-size:14.5px; line-height:1.6;
  border:1px solid var(--alert-amber-border); background:var(--alert-amber-soft); color:var(--text-primary);
}
.note.info{border-color:var(--border); background:var(--surface-2)}
.note strong{color:var(--text-primary)}

/* ---------- form ---------- */
.field{margin-bottom:14px}
.field label{display:block; font-family:var(--font-display); font-size:12px; font-weight:600;
  letter-spacing:.4px; text-transform:uppercase; color:var(--text-label); margin-bottom:6px}
.field input{
  width:100%; padding:11px 14px; font-family:var(--font-body); font-size:15px;
  color:var(--text-primary); background:var(--surface-1);
  border:1px solid var(--border); border-radius:var(--radius-md);
  transition:all .25s var(--ease);
}
.field input:focus{outline:none; border-color:var(--blue-500); box-shadow:0 0 0 3px rgba(60,117,181,.14)}
.grid2{display:grid; grid-template-columns:1fr 1fr; gap:14px}
@media(max-width:640px){.grid2{grid-template-columns:1fr}}

/* ---------- questions ---------- */
.dim-head{margin-bottom:var(--space-lg)}
.dim-num{
  display:inline-grid; place-items:center; width:38px; height:38px; border-radius:11px;
  background:var(--gradient-brand); color:#fff; font-family:var(--font-display);
  font-weight:700; font-size:17px; margin-bottom:14px;
}
.dim-sub{color:var(--text-muted); font-size:15.5px; max-width:62ch; margin-top:6px}

.q{
  background:var(--surface-1); border:1px solid var(--border); border-radius:var(--radius-lg);
  padding:22px 24px; margin-bottom:16px; transition:all .35s var(--ease-out-expo);
}
.q.answered{border-color:var(--border-strong); box-shadow:var(--shadow-sm)}
.q-top{display:flex; gap:12px; align-items:flex-start; margin-bottom:16px}
.q-tag{
  font-family:var(--font-mono); font-size:12px; font-weight:600; color:var(--blue-500);
  background:var(--surface-2); border-radius:var(--radius-sm); padding:3px 8px; flex:none; margin-top:2px;
}
.q-text{font-family:var(--font-display); font-weight:600; font-size:17px; line-height:1.42}

.opts{display:flex; flex-direction:column; gap:8px}
.opt{position:relative}
.opt input{position:absolute; opacity:0; width:0; height:0}
.opt label{
  display:flex; gap:12px; align-items:flex-start; cursor:pointer;
  padding:12px 15px; border:1px solid var(--border); border-radius:var(--radius-md);
  background:var(--bg); font-size:15px; line-height:1.5;
  transition:all .22s var(--ease);
}
.opt label:hover{border-color:var(--blue-400); background:var(--surface-2); transform:translateX(2px)}
.opt input:focus-visible + label{outline:2px solid var(--blue-500); outline-offset:2px}
.opt input:checked + label{
  border-color:var(--blue-500); background:var(--surface-2);
  box-shadow:0 0 0 1px var(--blue-500), var(--shadow-sm);
}
.pip{
  flex:none; width:24px; height:24px; border-radius:var(--radius-sm);
  display:grid; place-items:center; font-family:var(--font-mono); font-size:12.5px;
  font-weight:600; background:var(--surface-3); color:var(--text-label);
  transition:all .22s var(--ease);
}
.opt input:checked + label .pip{background:var(--blue-500); color:#fff}

/* ---------- override ---------- */
.ovr{
  display:flex; gap:16px; align-items:center; justify-content:space-between;
  background:var(--surface-1); border:1px solid var(--border);
  border-radius:var(--radius-lg); padding:18px 22px; margin-bottom:12px; flex-wrap:wrap;
}
.ovr p{margin:0; font-size:15.5px; flex:1 1 320px; line-height:1.5}
.yn{display:flex; gap:8px; flex:none}
.yn input{position:absolute; opacity:0; width:0; height:0}
.yn label{
  font-family:var(--font-display); font-size:13px; font-weight:600; letter-spacing:.4px;
  padding:7px 20px; border-radius:var(--radius-full); border:1px solid var(--border);
  background:var(--bg); cursor:pointer; transition:all .22s var(--ease);
}
.yn label:hover{border-color:var(--blue-400)}
.yn input:focus-visible + label{outline:2px solid var(--blue-500); outline-offset:2px}
.yn input:checked + label[data-v="yes"]{background:var(--alert-red); border-color:var(--alert-red); color:#fff}
.yn input:checked + label[data-v="no"]{background:var(--alert-green); border-color:var(--alert-green); color:#fff}

/* ---------- step navigation ---------- */
.scorecard-nav{
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  z-index:40;
  padding:0 var(--space-lg) 18px;
  background:transparent;
  border-top:0;
  pointer-events:none;
}
.scorecard-nav-in{
  max-width:820px;
  min-height:66px;
  margin:0 auto;
  padding:10px 12px;
  display:flex;
  align-items:center;
  gap:14px;
  border:1px solid rgba(184,204,226,.9);
  border-radius:var(--radius-full);
  background:rgba(255,255,255,.84);
  box-shadow:0 16px 48px rgba(14,25,53,.12);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  pointer-events:auto;
}
.btn{
  font-family:var(--font-display); font-weight:600; font-size:14px;
  padding:11px 24px; border-radius:var(--radius-full); border:none; cursor:pointer;
  transition:all .3s var(--ease-out-expo); letter-spacing:-.2px;
  display:inline-flex; align-items:center; gap:8px; text-decoration:none;
}
.btn-primary{background:var(--btn-primary-bg); color:#fff; box-shadow:0 2px 8px var(--btn-primary-shadow)}
.scorecard-page a.btn-primary{color:#fff}
.btn-primary:hover:not(:disabled){background:var(--btn-primary-hover); transform:translateY(-2px); box-shadow:0 6px 18px var(--btn-primary-shadow)}
.btn-ghost{background:rgba(255,255,255,.55); color:var(--text-muted); border:1px solid var(--border)}
.btn-ghost:hover{border-color:var(--border-strong); color:var(--text-primary)}
.scorecard-nav .btn{
  min-width:112px;
  justify-content:center;
}
.scorecard-nav .btn-primary:disabled{
  background:var(--surface-3);
  color:var(--text-label);
  box-shadow:none;
}
.btn:disabled{opacity:.56; cursor:not-allowed}
.scorecard-nav .btn:disabled{opacity:1}
.btn-primary.ready{animation:pulse 2.2s var(--ease) infinite}
@keyframes pulse{0%,100%{box-shadow:0 2px 8px var(--btn-primary-shadow)}50%{box-shadow:0 2px 8px var(--btn-primary-shadow),0 0 0 8px rgba(60,117,181,.10)}}
.navnote{
  flex:1;
  min-width:0;
  color:var(--text-muted);
  font-size:13px;
  text-align:left;
}
@media(max-width:640px){
  .scorecard-progress{top:94px; padding:0 var(--space-md)}
  .scorecard-progress-in{padding:9px 12px}
  .scorecard-progress-title{font-size:10px}
  .scorecard-page .stepline{gap:6px; font-size:10px}
  .scorecard-nav{padding:0 12px 12px}
  .scorecard-nav-in{
    min-height:auto;
    padding:8px;
    gap:8px;
    border-radius:var(--radius-lg);
  }
  .scorecard-nav .btn{
    min-width:auto;
    padding:10px 14px;
  }
  .navnote{
    font-size:12px;
    text-align:center;
  }
}

/* ---------- results ---------- */
.hero{
  border-radius:var(--radius-xl); padding:var(--space-xl); color:#fff;
  background:linear-gradient(135deg,#1A1E35,#243574,#2B4E86);
  box-shadow:var(--shadow-xl); position:relative; overflow:hidden;
}
.hero::after{
  content:''; position:absolute; inset:0;
  background:radial-gradient(600px 200px at 88% -10%,rgba(95,207,208,.22),transparent 70%);
  pointer-events:none;
}
.hero-grid{display:grid; grid-template-columns:auto 1fr; gap:var(--space-xl); align-items:center; position:relative}
@media(max-width:640px){.hero-grid{grid-template-columns:1fr; gap:var(--space-lg)}}
.dial{position:relative; width:150px; height:150px; flex:none}
.dial svg{transform:rotate(-90deg)}
.dial-txt{position:absolute; inset:0; display:grid; place-content:center; text-align:center}
.dial-num{font-family:var(--font-display); font-size:44px; font-weight:800; line-height:1; letter-spacing:-2px}
.dial-den{font-size:12px; opacity:.72; letter-spacing:1px; font-family:var(--font-display)}
.lvl{
