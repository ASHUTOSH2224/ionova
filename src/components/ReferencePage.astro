---
import Layout from '@/layouts/Layout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import type { ReferencePageMeta } from '@/data/referencePages';
import '@/styles/reference-pages.css';

interface Props {
  page: ReferencePageMeta;
  Content: any;
}

const { page, Content } = Astro.props;
---

<Layout
  title={page.title}
  description={page.description}
  ogImage="/og-image.png"
  ogImageAlt={`${page.title} — ioNova`}
  ogType={page.ogType}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(page.structuredData)} />

  <div class="flex min-h-screen flex-col">
    <Navbar client:idle />
    <main class="ds-v5 reference-page flex-1">
      <div class="container">
        <Content />
      </div>
    </main>
    <Footer />
  </div>
</Layout>
