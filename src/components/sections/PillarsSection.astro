---
const pillars = [
  {
    title: "Financial ID Preservation",
    description: "Validates 50+ identifiers (LEI, IBAN, BIC) before parsing begins.",
    detail: "Ensures entity integrity before splitting data.",
    // FileCheck icon (lucide-react v0.462.0)
    icon: `<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m9 15 2 2 4-4"/>`,
  },
  {
    title: "Geographic Disambiguation",
    description: "Resolves 28 Paris locations using postal formats and street patterns.",
    detail: "Distinguishes between Paris, TX and Paris, France with context.",
    // Target icon
    icon: `<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>`,
  },
  {
    title: "Historical Name Resolution",
    description: "Automates bidirectional mapping for cities like Bombay to Mumbai.",
    detail: "Handles legacy city names and street changes automatically.",
    // ShieldCheck icon
    icon: `<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>`,
  },
  {
    title: "Data De-Duplication",
    description: "Intelligently removes redundant elements.",
    detail: "Cleanses repetitive information to ensure clean structured output.",
    // UserCog icon
    icon: `<circle cx="18" cy="15" r="3"/><circle cx="9" cy="7" r="4"/><path d="M10 15H6a4 4 0 0 0-4 4v2"/><path d="m21.7 16.4-.9-.3"/><path d="m15.2 13.9-.9-.3"/><path d="m16.6 18.7.3-.9"/><path d="m19.1 12.2.3-.9"/><path d="m19.6 18.7-.4-1"/><path d="m16.8 12.3-.4-1"/><path d="m14.3 16.6 1-.4"/><path d="m20.7 13.8 1-.4"/>`,
  },
  {
    title: "Full Explainability",
    description: "Provides field-by-field audit trails with specific rule citations.",
    detail: "Every decision is cited with a specific rule for compliance audit.",
    // Lock icon
    icon: `<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>`,
  },
  {
    title: "Confidence Scoring",
    description: "Threshold-based routing (0.95+ auto-process) to minimize manual review.",
    detail: "Minimizes manual review by auto-processing high confidence data.",
    // Settings2 icon
    icon: `<path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/>`,
  },
];
---

<section id="platform" class="bg-surface-2 flex flex-col justify-center" style="padding-top:var(--section-padding-y);padding-bottom:var(--section-padding-y);">
  <div class="container">
    <div class="landing-section-header mb-12 text-center lg:mb-16">
      <h2 class="landing-section-title mb-4">
        6 Signature Capabilities that Drive <span class="text-gradient">98% Straight-Through Processing</span>
      </h2>
      <span class="landing-section-subtitle">
        ioNova is differentiated by deep banking logic
      </span>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {pillars.map((pillar, index) => (
        <div
          class="group relative overflow-hidden rounded-[6px] border border-border bg-card p-6 shadow-sm transition-all duration-300 hover:shadow-xl hover:border-blue-200"
          style={`animation-delay:${index * 100}ms;`}
        >
          <div class="relative z-10 flex flex-col h-full">
            <div class="flex items-start gap-4 mb-4">
              <div class="flex-shrink-0 flex h-12 w-12 items-center justify-center rounded-lg bg-blue-100/50 text-blue-600">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={pillar.icon} />
              </div>
              <p class="landing-card-title pt-1">{pillar.title}</p>
            </div>
            <div class="mt-auto">
              <p class="landing-card-body mb-3 font-medium">{pillar.description}</p>
              <div class="h-px w-full bg-slate-100 my-4 group-hover:bg-blue-100 transition-colors"></div>
              <p class="landing-card-body" style="font-size:15px;">{pillar.detail}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
