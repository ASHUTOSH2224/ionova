---
// Implementation timeline — homepage section.
// Header + footer are live, responsive text; the timeline itself is a single
// responsive image (public/Images/ImplementationTimeline.png).
---

<section class="impl-tl" id="implementation">
  <div class="impl-tl__inner">
    <div class="impl-tl__head">
      <div class="impl-tl__eyebrow">ARS · Implementation Plan</div>
      <h2 class="impl-tl__title">From kickoff to <span class="accent">go-live</span> in 3–4 weeks.</h2>
      <p class="impl-tl__sub">Get started in 2 days. Two tracks run in parallel — your integrations and channels, and ioNova’s engine tuning — converging on a validated production go-live.</p>
    </div>

    <!-- Timeline visual (week scale, two-lane Gantt, legend and stat callouts).
         Mobile gets a vertically-stacked variant; desktop the horizontal Gantt. -->
    <div class="impl-tl__figure">
      <picture>
        <source media="(max-width:640px)" srcset="/Images/ImplementationTimelinemobile.png" width="1086" height="1448" />
        <img
          class="impl-tl__img"
          src="/Images/ImplementationTimeline.png"
          alt="ioNova ARS implementation timeline: kickoff to validated production go-live in 3–4 weeks. Your team integrates and rolls out across four weeks — onboard and get credentials, set up integrations and channels, sandbox testing, and production validation — while ioNova tunes the engine on 10,000 representative addresses in parallel. Milestones: sandbox live on day 2, go-live in weeks 3–4. Outcomes: 2 days to get started, 10,000 representative addresses tuned, 3–4 weeks to validated production."
          width="2010"
          height="924"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>

    <!-- Footer note -->
    <div class="impl-tl__foot">ioNova ARS · Address Resolution Service for ISO 20022 payments · one engine, two API groups (Party Address · Message Address)</div>
  </div>
</section>

<style>
  .impl-tl {
    --tl-navy:#0E1935; --tl-teal:#43ADC1;
    --tl-bg:#EEF2F8; --tl-label:#5A6B82; --tl-muted:#8796A7;
    --tl-fd:'Outfit',system-ui,sans-serif; --tl-fb:'Figtree',system-ui,sans-serif; --tl-fm:'JetBrains Mono',monospace;
    background:var(--tl-bg); padding:clamp(48px,6vw,80px) 24px; font-family:var(--tl-fb); color:var(--tl-navy);
  }
  .impl-tl__inner { max-width:1180px; margin:0 auto; }

  /* Header — centered, matching the other homepage sections */
  .impl-tl__head { text-align:center; }
  .impl-tl__eyebrow { font-family:var(--tl-fm); font-size:12px; font-weight:600; letter-spacing:.18em; text-transform:uppercase; color:var(--tl-teal); margin-bottom:12px; }
  .impl-tl__title { font-family:var(--tl-fd); font-size:clamp(28px,3.8vw,44px); font-weight:800; letter-spacing:-.02em; line-height:1.1; color:var(--tl-navy); }
  .impl-tl__title .accent { color:var(--tl-teal); }
  .impl-tl__sub { font-size:16px; line-height:1.6; color:var(--tl-label); margin:14px auto 0; max-width:640px; }

  /* Timeline image — responsive, scales with the container, never overflows */
  .impl-tl__figure { margin-top:44px; }
  .impl-tl__img { display:block; width:100%; height:auto; max-width:1005px; margin:0 auto; }

  /* Footer note */
  .impl-tl__foot { font-family:var(--tl-fb); font-size:13px; color:var(--tl-muted); margin-top:48px; text-align:center; }
</style>
