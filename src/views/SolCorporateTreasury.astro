        <span class="badge badge-green">no PII persisted</span>
        <span class="badge badge-green">live in weeks</span>
    </div>
    <div class="alert alert-green" style="margin-top:var(--space-xl);">
      <div class="alert-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 10-12h-7z"/></svg></div>
