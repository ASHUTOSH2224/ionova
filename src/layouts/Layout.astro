---
import '@/index.css';
import '@/styles/ionova-design-system-v5.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
	title?: string;
    description?: string;
    keywords?: string;
    ogImage?: string;
    ogImageAlt?: string;
    ogType?: 'website' | 'article';
    canonicalOverride?: string;
    preloadHero?: boolean;
    noindex?: boolean;
}

const {
    title = "ioNova - AI-Native ISO 20022 Address Resolution for Payments",
    description = "Make your payment data ISO 20022 ready with AI-native address resolution. Convert unstructured payment data into SWIFT CBPR+ and SEPA compliant structured addresses with 100% deterministic accuracy.",
    keywords = "ISO 20022, SWIFT CBPR+, SEPA, payment compliance, address resolution, fintech, banking AI, payment data",
    ogImage = "/Logo/hero Image/hero.png",
    ogImageAlt = "ioNova AI — ISO 20022 Address Resolution Platform",
    ogType = "website",
    canonicalOverride,
    preloadHero = false,
    noindex = false,
} = Astro.props;

// Strip trailing slash from pathname (except root "/") so canonical matches the served URL
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalURL = canonicalOverride ?? new URL(pathname, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
        <link rel="canonical" href={canonicalURL} />
        <ViewTransitions />
        <meta name="keywords" content={keywords} />
        <meta name="author" content="ioNova" />
        <meta name="robots" content={robotsContent} />

        <!-- Note: Security headers (CSP, X-Frame-Options, HSTS, COOP) are configured via HTTP headers in public/_headers -->

        <!-- Open Graph / Social Media -->
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta property="og:site_name" content="ioNova" />
        <meta property="og:locale" content="en_US" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@ionova_ai" />
        <meta name="twitter:creator" content="@ionova_ai" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />
        <meta name="twitter:image:alt" content={ogImageAlt} />

        <!-- Fonts - Non-render-blocking load with print trick, noscript fallback -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Figtree:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
        <noscript>
          <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Figtree:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
        </noscript>

        <!-- Preload LCP image for faster paint — only on homepage where hero.webp is the actual LCP -->
        {preloadHero && <link rel="preload" as="image" href="/Logo/hero Image/hero.webp" fetchpriority="high" />}

        <!-- JSON-LD Structured Data -->
        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": "ioNova AI",
            "url": "https://ionova.ai"
          }
        </script>

        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": "ioNova AI",
            "url": "https://ionova.ai",
            "logo": {
              "@type": "ImageObject",
              "url": "https://ionova.ai/Logo/ionova%20logo/logo.png",
              "width": 200,
              "height": 60
            },
            "sameAs": [
              "https://www.linkedin.com/company/ionova-ai"
            ],
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "3606 Springbrook Drive",
              "addressLocality": "Edison",
              "addressRegion": "NJ",
              "postalCode": "08820",
              "addressCountry": "US"
            },
            "contactPoint": {
              "@type": "ContactPoint",
              "contactType": "sales",
              "availableLanguage": "English"
            }
          }
        </script>

        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "LocalBusiness",
            "name": "ioNova AI",
            "image": "https://ionova.ai/Logo/hero%20Image/hero.png",
            "priceRange": "$$$$",
            "url": "https://ionova.ai",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "3606 Springbrook Drive",
              "addressLocality": "Edison",
              "addressRegion": "NJ",
              "postalCode": "08820",
              "addressCountry": "US"
            },
            "geo": {
              "@type": "GeoCoordinates",
              "latitude": 40.5187,
              "longitude": -74.4121
            },
             "sameAs": [
              "https://www.linkedin.com/company/ionova-ai"
             ]
          }
        </script>

        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "name": "ioNova Platform",
            "description": "AI-Native Address Resolution for ISO 20022 Compliance",
            "applicationCategory": "FinanceApplication",
            "operatingSystem": "Web",
            "offers": {
              "@type": "Offer",
              "category": "Enterprise Software"
            },
            "provider": {
              "@type": "Organization",
              "name": "ioNova AI",
              "url": "https://ionova.ai"
            }
          }
        </script>

        <!-- Page-specific head content (JSON-LD, extra meta, etc.) -->
        <slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>
