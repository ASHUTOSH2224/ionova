---
import '@/index.css';
import '@/styles/ionova-design-system-v5.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
	title?: string;
    description?: string;
    keywords?: string;
    ogImage?: string;
    ogImageAlt?: string;
    ogType?: 'website' | 'article';
    canonicalOverride?: string;
    preloadHero?: boolean;
    noindex?: boolean;
}

const {
    title = "ioNova - AI-Native ISO 20022 Address Resolution for Payments",
    description = "Make your payment data ISO 20022 ready with AI-native address resolution. Convert unstructured payment data into SWIFT CBPR+ and SEPA compliant structured addresses with >99% STP accuracy.",
    keywords = "ISO 20022, SWIFT CBPR+, SEPA, payment compliance, address resolution, fintech, banking AI, payment data",
    ogImage = "/og-image.png",
    ogImageAlt = "ioNova AI — ISO 20022 Address Resolution Platform",
    ogType = "website",
    canonicalOverride,
    preloadHero = false,
    noindex = false,
} = Astro.props;

// Strip trailing slash from pathname (except root "/") so canonical matches the served URL
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalURL = canonicalOverride ?? new URL(pathname, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="msapplication-TileImage" content="/mstile-150x150.png" />
		<meta name="msapplication-TileColor" content="#0a0a0a" />
		<meta name="msapplication-config" content="/browserconfig.xml" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
        <link rel="canonical" href={canonicalURL} />
        <ViewTransitions />
        <meta name="keywords" content={keywords} />
        <meta name="author" content="ioNova" />
        <meta name="robots" content={robotsContent} />

        <!-- Note: Security headers (CSP, X-Frame-Options, HSTS, COOP) are configured via HTTP headers in public/_headers -->

        <!-- Open Graph / Social Media -->
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta property="og:site_name" content="ioNova" />
        <meta property="og:locale" content="en_US" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@ionova_ai" />
        <meta name="twitter:creator" content="@ionova_ai" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />
        <meta name="twitter:image:alt" content={ogImageAlt} />

        <!-- Fonts - Non-render-blocking load with print trick, noscript fallback -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Figtree:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
        <noscript>
          <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Figtree:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
        </noscript>

        <!-- Preload LCP image for faster paint — only on homepage where hero.webp is the actual LCP -->
        {preloadHero && <link rel="preload" as="image" href="/Logo/hero%20Image/hero-480w.webp" fetchpriority="high" imagesrcset="/Logo/hero%20Image/hero-480w.webp 480w, /Logo/hero%20Image/hero-768w.webp 768w, /Logo/hero%20Image/hero.webp 1024w" imagesizes="(max-width: 768px) 300px, (max-width: 1024px) 400px, 600px" />}

        <!-- JSON-LD Structured Data -->
        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "@id": "https://ionova.ai/#website",
            "name": "ioNova AI",
            "url": "https://ionova.ai",
            "publisher": { "@id": "https://ionova.ai/#organization" },
            "description": "AI-native ISO 20022 Address Resolution and Entity Intelligence Platform for global payment compliance.",
            "inLanguage": "en-US",
            "potentialAction": {
              "@type": "SearchAction",
              "target": {
                "@type": "EntryPoint",
                "urlTemplate": "https://ionova.ai/blogs?q={search_term_string}"
              },
              "query-input": "required name=search_term_string"
            }
          }
        </script>

        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "Organization",
            "@id": "https://ionova.ai/#organization",
            "name": "ioNova AI",
            "alternateName": "ioNova",
            "url": "https://ionova.ai",
            "founder": { "@id": "https://ionova.ai/#parth-desai" },
            "description": "AI-native Entity Intelligence platform for ISO 20022 payment compliance, structured address resolution, and entity data quality across 195 countries for regulated financial institutions.",
            "logo": {
              "@type": "ImageObject",
              "url": "https://ionova.ai/Logo/ionova%20logo/logo.PNG",
              "width": 200,
              "height": 60
            },
            "sameAs": [
              "https://www.linkedin.com/company/ionova-ai"
            ],
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "3606 Springbrook Drive",
              "addressLocality": "Edison",
              "addressRegion": "NJ",
              "postalCode": "08820",
              "addressCountry": "US"
            },
            "contactPoint": {
              "@type": "ContactPoint",
              "contactType": "sales",
              "email": "hello@ionova.ai",
              "availableLanguage": "English"
            },
            "knowsAbout": [
              "ISO 20022",
              "SWIFT CBPR+ Compliance",
              "SEPA Payment Standards",
              "Structured Address Resolution",
              "Entity Intelligence",
              "Payment Compliance",
              "AML / KYC",
              "Financial Data Quality"
            ],
            "hasOfferCatalog": {
              "@type": "OfferCatalog",
              "name": "ioNova Products",
              "itemListElement": [
                { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Address Intelligence — ISO 20022 Address Resolution", "url": "https://ionova.ai/address-intelligence" } },
                { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Entity Intelligence Platform", "url": "https://ionova.ai/entity-intelligence" } }
              ]
            }
          }
        </script>

        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "@id": "https://ionova.ai/#address-intelligence-product",
            "name": "ioNova Address Intelligence Platform",
            "description": "AI-native Address Resolution Engine for ISO 20022 compliance. Converts unstructured payment addresses into SWIFT CBPR+, HVPS+, and SEPA-compliant structured formats with >99% STP rates and sub-50ms latency across 195 countries.",
            "applicationCategory": "BusinessApplication",
            "operatingSystem": "Web, API, Cloud",
            "featureList": [
              "ISO 20022 Structured Address Resolution",
              "SWIFT CBPR+ Compliance Validation",
              "HVPS+ Format Validation",
              "SEPA Address Enrichment",
              "UK CHAPS Format Validation",
              "Hybrid Address Format Output: TwnNm + Ctry + AdrLine",
              "pain.001 & pacs.008 Payment Message Support",
              "Transaction Processing: Real-Time API (<50ms P95) + Batch Files",
              "Master Records Restructuring: API, Files, Direct Database Integration",
              "195-Country Coverage",
              "Sub-50ms API Latency (P95)",
              ">99% STP Resolution Rate (Combined Deterministic + Agentic)",
              "Deterministic Engine: 98% of Requests",
              "Agentic Workbench: 2% Exception Handling (<2 seconds)",
              "Autonomous Learning System — Self-Testing & Self-Training",
              "Confidence Scoring & Explainability",
              "File Processing SLA: <5 min per 10K Records",
              "Database Remediation SLA: <1 hour per 1M Records",
              "Sidecar Architecture — No Legacy Changes Required",
              "Full Decision Audit Trail"
            ],
            "offers": {
              "@type": "Offer",
              "category": "Enterprise Software",
              "seller": { "@id": "https://ionova.ai/#organization" }
            },
            "provider": { "@id": "https://ionova.ai/#organization" }
          }
        </script>

        <!-- Page-specific head content (JSON-LD, extra meta, etc.) -->
        <slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>
